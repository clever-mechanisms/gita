    "You can’t approve your own pull request.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní žádost o začlenění nemůžete schválit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deinen eigenen Pull Request nicht genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t approve your own pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes aprobar tu propia pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas approuver votre propre pull request."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saját beolvasztási kérelmét nem hagyhatja jóvá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi approvare la tua pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のプルリクエストは承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 풀 리퀘스트는 승인할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt je eigen pullrequest niet goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie możesz zatwierdzić własnego pull requesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode aprovar seu próprio pull request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя одобрить собственный запрос на слияние."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte godkänna din egen pull request."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอนุมัติ pull request ของตัวเองไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi birleştirme isteğinizi onaylayamazsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна схвалити власний запит на злиття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能批准自己的拉取请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能核准自己的提取要求。"
          }
        }
      }
    },
    "You can’t request changes on your own pull request.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U vlastní žádosti o začlenění nemůžete vyžádat změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst für deinen eigenen Pull Request keine Änderungen anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t request changes on your own pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes solicitar cambios en tu propia pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas demander des modifications sur votre propre pull request."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saját beolvasztási kérelménél nem kérhet módosításokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi richiedere modifiche alla tua pull request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のプルリクエストには変更を要求できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 풀 리퀘스트에는 변경을 요청할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt geen wijzigingen aanvragen voor je eigen pullrequest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie możesz zażądać zmian we własnym pull requeście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode solicitar alterações no seu próprio pull request."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя запросить изменения в собственном запросе на слияние."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte begära ändringar i din egen pull request."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณขอแก้ไขบน pull request ของตัวเองไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi birleştirme isteğinizde değişiklik isteyemezsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна запитати зміни у власному запиті на злиття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能对自己的拉取请求请求更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能對自己的提取要求要求變更。"
          }
        }
      }
    },
    "You have an unsent review on GitHub for this pull request. Submit or delete it there first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na GitHubu máte k této žádosti o začlenění neodeslané posouzení. Nejprve ho tam odešlete nebo smažte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast auf GitHub ein nicht abgesendetes Review für diesen Pull Request. Sende es dort zuerst ab oder lösche es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have an unsent review on GitHub for this pull request. Submit or delete it there first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una revisión sin enviar en GitHub para esta pull request. Envíala o elimínala allí primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez une révision non envoyée sur GitHub pour cette pull request. Envoyez-la ou supprimez-la d’abord là-bas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Van egy el nem küldött véleményezése a GitHubon ehhez a beolvasztási kérelemhez. Előbb ott küldje be vagy törölje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai una revisione non inviata su GitHub per questa pull request. Inviala o eliminala prima lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプルリクエストには GitHub 上に未送信のレビューがあります。先に GitHub で送信または削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 풀 리퀘스트에 대해 GitHub에 보내지 않은 검토가 있습니다. 먼저 GitHub에서 제출하거나 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt op GitHub een niet-verzonden review voor deze pullrequest. Verzend of verwijder die daar eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz w GitHub niewysłaną recenzję tego pull requesta. Najpierw ją tam wyślij lub usuń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem uma revisão não enviada no GitHub para este pull request. Envie-a ou exclua-a lá primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть неотправленная рецензия на GitHub для этого запроса на слияние. Сначала отправьте или удалите её там."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har en oskickad granskning på GitHub för den här pull requesten. Skicka eller ta bort den där först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมีรีวิวที่ยังไม่ส่งบน GitHub สำหรับ pull request นี้ ให้ส่งหรือลบที่นั่นก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birleştirme isteği için GitHub'da gönderilmemiş bir incelemeniz var. Önce orada gönderin veya silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас є ненадіслана рецензія на GitHub для цього запиту на злиття. Спочатку надішліть або видаліть її там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 GitHub 上有此拉取请求的未提交审查。请先在那里提交或删除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 GitHub 上有此提取要求的未提交審查。請先在那裡提交或刪除它。"
          }
        }
      }
    },
    "Your commit is replayed on top of the remote's: one straight line, new commit IDs.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše revize se znovu použije nad revizí ze vzdáleného repozitáře: jedna přímá linie, nová ID revizí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Commit wird erneut auf den des Remotes angewendet: eine gerade Linie, neue Commit-IDs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your commit is replayed on top of the remote's: one straight line, new commit IDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu commit se reaplica sobre el del remoto: una sola línea recta, nuevos ID de commit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre commit est réappliqué par-dessus celui du dépôt distant : une seule ligne droite, de nouveaux identifiants de commit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön commitja a távoli tároló commitjára alkalmazódik újra: egyetlen egyenes vonal, új commitazonosítók."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo commit viene riapplicato sopra quello del remoto: una sola linea retta, nuovi ID di commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のコミットがリモートのコミットの上に再適用されます。履歴は一直線になり、コミット ID は新しくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 커밋이 원격 커밋 위에 다시 적용됩니다. 기록이 한 줄로 이어지고 커밋 ID가 새로 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je commit wordt opnieuw toegepast bovenop die van de remote: één rechte lijn, nieuwe commit-ID’s."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój commit jest stosowany ponownie na commicie zdalnym: jedna prosta linia, nowe identyfikatory commitów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu commit é reaplicado sobre o do remoto: uma linha reta, novos IDs de commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш коммит повторно применяется поверх удалённого: одна прямая линия, новые ID коммитов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din commit tillämpas igen ovanpå fjärrarkivets: en rak linje, nya commit-ID:n."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ของคุณถูกเล่นซ้ำบน commit ของ remote: เป็นเส้นตรงเส้นเดียวและมี ID commit ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitiniz uzak deponunkinin üzerine yeniden uygulanır: tek bir düz çizgi, yeni commit kimlikleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш коміт повторно застосовується поверх віддалених: одна пряма лінія, нові ідентифікатори комітів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的提交将重放到远程提交之上：形成一条直线，提交 ID 会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的提交將重播到遠端提交之上：形成一條直線，提交 ID 會改變。"
          }
        }
      }
    },
    "Your message is still in this window. Keep it open and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zpráva je stále v tomto okně. Nechte okno otevřené a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht ist noch in diesem Fenster. Lass es geöffnet und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message is still in this window. Keep it open and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje sigue en esta ventana. Déjala abierta e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message est toujours dans cette fenêtre. Laissez-la ouverte et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenet továbbra is ebben az ablakban van. Hagyja nyitva az ablakot, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo messaggio è ancora in questa finestra. Lasciala aperta e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージはこのウインドウに残っています。ウインドウを開いたまま、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 이 윈도우에 그대로 있습니다. 윈도우를 열어 둔 채 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bericht staat nog in dit venster. Houd het open en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój komunikat nadal jest w tym oknie. Pozostaw okno otwarte i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mensagem ainda está nesta janela. Mantenha-a aberta e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение всё ещё в этом окне. Оставьте окно открытым и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt meddelande finns kvar i detta fönster. Låt det vara öppet och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความของคุณยังอยู่ในหน้าต่างนี้ ให้เปิดไว้แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletiniz hâlâ bu pencerede. Pencereyi açık tutun ve yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше повідомлення все ще в цьому вікні. Залиште вікно відкритим і спробуйте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的消息仍在此窗口中。请保持窗口打开，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的訊息仍在此視窗中。請保持視窗開啟，然後再試一次。"
          }
        }
      }
    },
