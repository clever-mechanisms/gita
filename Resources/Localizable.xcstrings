            "state": "translated",
            "value": "Symbolický odkaz je příliš velký pro kontrolu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der symbolische Link ist für die Prüfung zu groß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The symbolic link is too large to review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace simbólico es demasiado grande para revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien symbolique est trop volumineux pour être examiné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szimbolikus link túl nagy az ellenőrzéshez."
          }
        },
        "it": {
