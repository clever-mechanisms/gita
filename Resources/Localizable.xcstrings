    "Worktree metadata changed. Refresh the repository.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata pracovního stromu se změnila. Obnovte repozitář."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree-Metadaten haben sich geändert. Aktualisiere das Repository."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree metadata changed. Refresh the repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos del árbol de trabajo cambiaron. Actualiza el repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de l’arbre de travail ont changé. Actualisez le dépôt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa metaadatai megváltoztak. Frissítse a tárolót."
          }
