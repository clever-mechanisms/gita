    "Could not check Git's local object inspection support.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se ověřit podporu místní kontroly objektů v Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterstützung für lokale Objektprüfung in Git konnte nicht geprüft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check Git's local object inspection support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar la compatibilidad de Git con la inspección de objetos locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la prise en charge de l’inspection des objets locaux par Git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült ellenőrizni a Git helyi objektumvizsgálati támogatását."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il supporto di Git per l’ispezione degli oggetti locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git のローカルオブジェクト検査の対応状況を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git의 로컬 객체 검사 지원 여부를 확인하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon Gits ondersteuning voor inspectie van lokale objecten niet controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić obsługi lokalnej inspekcji obiektów Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o suporte do Git à inspeção de objetos locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить поддержку просмотра локальных объектов в Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte kontrollera Gits stöd för inspektion av lokala objekt."
          }
        },
