    "Gitā adds its entries to %@ and keeps a backup.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā přidá své položky do %@ a ponechá si zálohu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā fügt seine Einträge zu %@ hinzu und legt ein Backup an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā adds its entries to %@ and keeps a backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā añade sus entradas a %@ y guarda una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā ajoute ses entrées à %@ et conserve une sauvegarde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā hozzáadja a bejegyzéseit ide: %@, és biztonsági másolatot tart."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā aggiunge le sue voci a %@ e conserva un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā は %@ にエントリを追加し、バックアップを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gita가 %@에 항목을 추가하고 백업을 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā voegt zijn items toe aan %@ en bewaart een back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā dodaje swoje wpisy do %@ i zachowuje kopię zapasową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā adiciona suas entradas a %@ e mantém um backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā добавляет свои записи в %@ и сохраняет резервную копию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā lägger till sina poster i %@ och behåller en säkerhetskopia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā เพิ่มรายการของตัวเองลงใน %@ และสำรองไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā girdilerini %@ dosyasına ekler ve yedek tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā додає свої записи до %@ і зберігає резервну копію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 会将其条目添加到 %@ 并保留备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 會將其項目加入 %@ 並保留備份。"
          }
        }
      }
    },
    "Gitā could not validate this rebase editor session. Reload the operation or abort it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā nemohl ověřit tuto relaci editoru přesazení. Načtěte operaci znovu nebo ji přerušte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā konnte diese Rebase-Editor-Sitzung nicht validieren. Lade den Vorgang neu oder brich ihn ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā could not validate this rebase editor session. Reload the operation or abort it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā no pudo validar esta sesión del editor de rebase. Vuelve a cargar la operación o abórtala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā n’a pas pu valider cette session de l’éditeur de rebase. Rechargez l’opération ou abandonnez-la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā nem tudta ellenőrizni az újraalapozási szerkesztő munkamenetét. Töltse újra vagy szakítsa meg a műveletet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā non ha potuto convalidare questa sessione dell’editor di rebase. Ricarica l’operazione o interrompila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā はこのリベース編集セッションを検証できませんでした。操作を再読み込みするか中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gita에서 이 리베이스 편집기 세션을 검증하지 못했습니다. 작업을 다시 로드하거나 중단하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā kon deze rebase-editorsessie niet valideren. Laad de bewerking opnieuw of breek deze af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā nie może zweryfikować tej sesji edytora zmiany bazy. Wczytaj operację ponownie lub ją przerwij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā não pôde validar esta sessão do editor de rebase. Recarregue a operação ou aborte-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā не удалось подтвердить этот сеанс редактора перебазирования. Перезагрузите операцию или прервите её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā kunde inte validera denna rebase-editorsession. Läs in åtgärden igen eller avbryt den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā ตรวจสอบ session ของ rebase editor นี้ไม่ได้ ให้โหลดการดำเนินการใหม่หรือยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā bu yeniden temellendirme düzenleyicisi oturumunu doğrulayamadı. İşlemi yeniden yükleyin veya durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā не вдалося підтвердити цей сеанс редактора перебазовування. Перезавантажте операцію або перервіть її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 无法验证此变基编辑器会话。请重新载入操作或中止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 無法驗證此重定基底編輯器工作階段。請重新載入操作或中止。"
          }
        }
      }
    },
    "Gitā lives in the menu bar too: your repositories, agents and checks are one click away.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā je také v řádku nabídek: vaše repozitáře, agenti a kontroly jsou vzdáleny jen jedno kliknutí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā ist auch in der Menüleiste: Deine Repositorys, Agenten und Prüfungen sind nur einen Klick entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā lives in the menu bar too: your repositories, agents and checks are one click away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā también está en la barra de menús: tus repositorios, agentes y comprobaciones, a un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā se trouve aussi dans la barre des menus : vos dépôts, agents et vérifications sont à portée de clic."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā a menüsorban is ott van: tárolói, ügynökei és ellenőrzései egy kattintásnyira vannak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā è anche nella barra dei menu: i tuoi repository, agenti e controlli sono a un clic di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā はメニューバーにもあります。リポジトリ、エージェント、チェックにワンクリックでアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gita는 메뉴 막대에도 있습니다. 저장소, 에이전트, 검사를 클릭 한 번으로 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā staat ook in de menubalk: je repositories, agenten en controles zijn één klik verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā jest też na pasku menu: Twoje repozytoria, agenci i kontrole są o jedno kliknięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā também fica na barra de menus: seus repositórios, agentes e verificações a um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā есть и в строке меню: ваши репозитории, агенты и проверки — в один клик."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā finns också i menyraden: dina kodförråd, agenter och kontroller är ett klick bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā อยู่ในแถบเมนูด้วย: repository, agent และการเช็กของคุณอยู่ห่างเพียงคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā menü çubuğunda da yer alır: depolarınız, ajanlarınız ve kontrolleriniz bir tık uzağınızda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā також є на смузі меню: ваші репозиторії, агенти й перевірки — за один клік."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 也位于菜单栏中：只需点按一下即可查看你的仓库、代理和检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 也在選單列中：只要按一下即可查看你的版本庫、代理和檢查。"
          }
        }
      }
    },
    "Gitā reads GitHub and Vercel through the CLIs you already use. It stores no account and no token.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā čte GitHub a Vercel přes nástroje příkazového řádku, které už používáte. Neukládá žádný účet ani token."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā liest GitHub und Vercel über die CLIs, die du bereits verwendest. Gitā speichert weder einen Account noch ein Token."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā reads GitHub and Vercel through the CLIs you already use. It stores no account and no token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā lee GitHub y Vercel mediante las CLI que ya usas. No guarda ninguna cuenta ni ningún token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā lit GitHub et Vercel via les outils en ligne de commande que vous utilisez déjà. Il n’enregistre aucun compte ni aucun jeton."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā a már használt parancssori eszközökön keresztül olvassa a GitHubot és a Vercelt. Nem tárol se fiókot, se tokent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā legge GitHub e Vercel tramite le CLI che usi già. Non memorizza alcun account né token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā は、すでに使っている CLI を通じて GitHub と Vercel の情報を読み取ります。アカウントやトークンは一切保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gita는 이미 사용 중인 CLI를 통해 GitHub와 Vercel을 읽습니다. 계정이나 토큰은 저장하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā leest GitHub en Vercel via de CLI’s die je al gebruikt. Het bewaart geen account en geen token."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā odczytuje GitHub i Vercel za pomocą narzędzi CLI, których już używasz. Nie przechowuje żadnego konta ani tokenu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā lê o GitHub e a Vercel pelas CLIs que você já usa. Ele não armazena nenhuma conta nem token."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā получает данные GitHub и Vercel через CLI, которыми вы уже пользуетесь. Он не хранит ни учётных записей, ни токенов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā läser GitHub och Vercel via de CLI-verktyg du redan använder. Den sparar inget konto och ingen token."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā อ่าน GitHub และ Vercel ผ่าน CLI ที่คุณใช้อยู่ โดยไม่เก็บบัญชีหรือโทเคน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā, GitHub ve Vercel’i zaten kullandığınız CLI’lar üzerinden okur. Hiçbir hesap veya token saklamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā читає GitHub і Vercel через CLI, якими ви вже користуєтеся. Він не зберігає жодних облікових записів чи токенів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 通过你已在使用的 CLI 读取 GitHub 和 Vercel。它不存储任何账户或令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 透過你已在使用的 CLI 讀取 GitHub 和 Vercel。它不會儲存任何帳號或權杖。"
          }
        }
      }
    },
    "Gitā will check out %@ and merge %@ into it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā přepne na %@ a sloučí do ní %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt %@ aus und führt %@ darin zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā will check out %@ and merge %@ into it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā cambiará a %@ y fusionará %@ en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā extraira %1$@ et y fusionnera %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā kiveszi a(z) %1$@ ágat, és egyesíti bele ezt: %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā eseguirà il checkout di %1$@ e vi unirà %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā は %@ をチェックアウトして、%@ をマージします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā가 %@을(를) 체크아웃하고 %@을(를) 병합합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt %@ uit en voegt %@ ermee samen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā przełączy na %@ i scali z nią %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā fará checkout de %@ e mesclará %@ nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā переключится на %@ и сольёт %@ в неё."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkar ut %@ och slår samman %@ med den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā จะ checkout %@ แล้ว merge %@ เข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā %@ dalına geçecek ve %@ dalını onunla birleştirecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā перейде на %@ і зіллє %@ у неї."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 将检出 %@ 并将 %@ 合并到其中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 將簽出 %@ 並將 %@ 合併至其中。"
          }
        }
      }
    },
    "Gitā will check out %@ and rebase it onto %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā přepne na %@ a přesadí ji na %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt %@ aus und führt ein Rebase auf %@ durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā will check out %@ and rebase it onto %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā cambiará a %@ y hará rebase sobre %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā extraira %1$@ et effectuera son rebase sur %2$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā kiveszi a(z) %1$@ ágat, és újraalapozza erre: %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā eseguirà il checkout di %1$@ e ne eseguirà il rebase su %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā は %@ をチェックアウトして、%@ へリベースします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā가 %@을(를) 체크아웃하고 %@ 위로 리베이스합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt %@ uit en rebaset deze op %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā przełączy na %@ i zmieni jej bazę na %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā fará checkout de %@ e fará rebase dela sobre %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā переключится на %@ и перебазирует её на %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkar ut %@ och rebasar den på %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā จะ checkout %@ แล้ว rebase ลงบน %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā %@ dalına geçecek ve onu %@ üzerine yeniden temellendirecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā перейде на %@ і перебазує її на %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 将检出 %@ 并将其变基到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 將簽出 %@ 並將其重定基底至 %@。"
          }
        }
      }
    },
    "Gitā will check out %@ first, then replay the commits.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā nejprve přepne na %@ a poté znovu použije revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt zuerst %@ aus und wendet dann die Commits erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā will check out %@ first, then replay the commits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā cambiará primero a %@ y luego volverá a aplicar los commits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā extraira d’abord %@, puis rejouera les commits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā előbb kiveszi a(z) %@ ágat, majd újra alkalmazza a commitokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā eseguirà prima il checkout di %@, poi riapplicherà i commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā はまず %@ をチェックアウトし、そのあとコミットを順に適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā가 먼저 %@을(를) 체크아웃한 다음 커밋을 다시 적용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkt eerst %@ uit en past daarna de commits opnieuw toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā najpierw przełączy na %@, a następnie zastosuje commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gitā fará checkout de %@ primeiro e depois reaplicará os commits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā сначала переключится на %@, а затем применит коммиты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā checkar ut %@ först och spelar sedan upp commitsen igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā จะ checkout %@ ก่อน แล้วเล่น commit ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā önce %@ dalına geçecek, ardından commitleri yeniden uygulayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā спочатку перейде на %@, а потім застосує коміти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 将先检出 %@，然后重放提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 將先簽出 %@，然後重放提交。"
          }
        }
      }
    },
    "Gitā ▸ Setup Guide… opens this guide again.": {
      "localizations": {
