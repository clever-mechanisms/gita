    },
    "The untracked file is deleted permanently.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesledovaný soubor bude trvale smazán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nicht verfolgte Datei wird endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The untracked file is deleted permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo sin seguimiento se eliminará de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier non suivi sera supprimé définitivement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nem követett fájl véglegesen törlődik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non tracciato verrà eliminato definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未追跡ファイルは完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적되지 않은 파일은 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het niet-gevolgde bestand wordt definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieśledzony plik zostanie trwale usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não rastreado será excluído permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неотслеживаемый файл будет удалён безвозвратно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ospårade filen tas bort permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
