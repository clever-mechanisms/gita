          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีลำดับคำสั่ง Git ที่ไม่รองรับอยู่ ให้ทำให้เสร็จด้วย Git ก่อนเริ่มการดำเนินการอื่น"
          }
