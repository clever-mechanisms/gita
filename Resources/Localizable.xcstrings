    "This file is currently locked by %@. Force-unlocking may cause merge conflicts with their uncommitted work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is currently locked by %@. Force-unlocking may cause merge conflicts with their uncommitted work."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor má aktuálně zamčený %@. Vynucené odemknutí může způsobit konflikty sloučení s jeho neuloženou prací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist derzeit von %@ gesperrt. Ein erzwungenes Entsperren kann Merge-Konflikte mit noch nicht committeter Arbeit verursachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está bloqueado actualmente por %@. Forzar el desbloqueo puede causar conflictos de fusión con su trabajo sin commit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est actuellement verrouillé par %@. Forcer le déverrouillage peut provoquer des conflits de fusion avec son travail non commité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file è attualmente bloccato da %@. Forzare lo sblocco può causare conflitti di merge con le modifiche di cui non è stato ancora eseguito il commit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlt jelenleg %@ zárolta. A zárolás kényszerített feloldása egyesítési ütközéseket okozhat a még nem véglegesített munkájával."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is momenteel vergrendeld door %@. Geforceerd ontgrendelen kan samenvoegconflicten veroorzaken met diens niet-gecommitte werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik jest obecnie zablokowany przez %@. Wymuszenie odblokowania może spowodować konflikty scalania z jego niezatwierdzoną pracą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo está bloqueado atualmente por %@. Forçar o desbloqueio pode causar conflitos de mesclagem com o trabalho não confirmado dessa pessoa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna fil är för närvarande låst av %@. Att tvinga upplåsning kan orsaka sammanslagningskonflikter med deras icke-committade arbete."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ถูกล็อกโดย %@ อยู่ การบังคับปลดล็อกอาจทำให้เกิด merge conflict กับงานที่ยังไม่ได้ commit ของอีกฝ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya şu anda %@ tarafından kilitlenmiş. Kilidi zorla açmak, o kişinin commitlenmemiş çalışmasıyla birleştirme çakışmalarına yol açabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл сейчас заблокирован пользователем %@. Принудительная разблокировка может привести к конфликтам слияния с его незафиксированными изменениями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл зараз заблоковано користувачем %@. Примусове розблокування може спричинити конфлікти зливання з його незакоміченою роботою."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは現在 %@ によってロックされています。強制的にロック解除すると、相手の未コミットの作業とマージ競合が発生する可能性があります。"
