    "Reopen brings the conflict back exactly as Git left it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen brings the conflict back exactly as Git left it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu otevřít vrátí konflikt přesně do stavu, v jakém jej Git zanechal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabrir devuelve el conflicto exactamente como lo dejó Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Erneut öffnen“ stellt den Konflikt genau so wieder her, wie Git ihn hinterlassen hat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Újranyitás pontosan úgy állítja vissza az ütközést, ahogy a Git hagyta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrir rétablit le conflit exactement tel que Git l’a laissé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「開き直す」で、Git が残したとおりの状態に競合を戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'다시 열기'를 누르면 Git이 남긴 그대로 충돌을 되돌립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“重新打开”会将冲突完全恢复为 Git 留下时的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「重新打開」會將衝突完全回復為 Git 留下時的狀態。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri ripristina il conflitto esattamente come l’ha lasciato Git."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ponownie przywraca konflikt dokładnie w takim stanie, w jakim zostawił go Git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Open opnieuw’ zet het conflict precies terug zoals Git het achterliet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabrir traz o conflito de volta exatamente como o Git o deixou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Aç, çakışmayı tam olarak Git'in bıraktığı hâliyle geri getirir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Öppna igen” återställer konflikten exakt som Git lämnade den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Открыть заново» возвращает конфликт точно в том виде, в каком его оставил Git."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Відкрити знову» повертає конфлікт точно в тому стані, у якому його залишив Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดใหม่จะคืน conflict ตามที่ Git ทิ้งไว้ทุกประการ"
          }
        }
      }
    },
