    "This file cannot be merged line by line. Choose the version to keep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be merged line by line. Choose the version to keep."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor nelze sloučit po řádcích. Vyberte verzi, kterou chcete zachovat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede fusionar línea a línea. Elige la versión que quieres conservar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht zeilenweise zusammengeführt werden. Wähle die Version, die bleiben soll."
