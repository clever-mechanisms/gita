    "Editing a rebase plan requires Git 2.45 or later.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava plánu přesazení vyžaduje Git 2.45 nebo novější."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bearbeiten eines Rebase-Plans ist Git 2.45 oder neuer erforderlich."
          }
        },
