        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนอื่นเปิด pull request ใน repository ที่คุณเปิดอยู่ใน Gitā"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
