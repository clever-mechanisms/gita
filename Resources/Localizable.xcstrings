    "Squash and Fixup need a preceding retained commit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash and Fixup need a preceding retained commit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučení do předchozí revize i připojení beze zprávy vyžadují předchozí zachovanou revizi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash y Fixup necesitan un commit conservado anterior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash und Fixup benötigen einen vorangehenden beibehaltenen Commit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Összevonás és az Összevonás üzenet nélkül művelethez előző megtartott commit szükséges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash et Fixup nécessitent un commit conservé précédent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「まとめる」と「修正を統合」には、前に保持するコミットが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'묶기'와 '수정 합치기' 앞에는 유지할 커밋이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“压缩合并”和“修补合并”之前需要有保留的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「壓縮合併」和「修補合併」之前需要有保留的提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash e Fixup richiedono un commit mantenuto precedente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz commity i Dołącz bez komunikatu wymagają wcześniejszego zachowanego commita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash en Fixup vereisen een eerdere behouden commit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash e Fixup precisam de um commit mantido anterior."
          }
        },
        "tr": {
