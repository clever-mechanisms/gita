    "Sign in using the %@ CLI in Terminal, then refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in using the %@ CLI in Terminal, then refresh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se pomocí CLI %@ v Terminálu a poté obnovte zobrazení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con la CLI de %@ en Terminal y actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit der CLI von %@ im Terminal an und aktualisiere dann."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be a(z) %@ CLI-vel a Terminálban, majd frissítsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec la CLI de %@ dans Terminal, puis actualisez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで %@ CLI を使ってサインインしてから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 %@ CLI로 로그인한 다음 새로 고치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在终端中使用 %@ CLI 登录，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「終端機」中使用 %@ CLI 登入，然後重新整理。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con la CLI di %@ in Terminale, poi aggiorna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się przez CLI %@ w Terminalu, a następnie odśwież."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in via de CLI van %@ in Terminal en vernieuw daarna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com a CLI de %@ no Terminal e atualize."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal'de %@ CLI aracını kullanarak oturum açın, ardından yenileyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med CLI för %@ i Terminal och uppdatera sedan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через CLI %@ в Терминале, затем обновите данные."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть через CLI %@ в Терміналі, потім оновіть дані."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ด้วย %@ CLI ใน Terminal แล้วรีเฟรช"
          }
        }
      }
    },
