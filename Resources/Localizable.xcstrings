    "Hunk staging is off while whitespace is ignored.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava po blocích je vypnuta, dokud jsou bílé znaky ignorovány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stagen von Blöcken ist deaktiviert, solange Leerzeichen ignoriert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunk staging is off while whitespace is ignored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparación por bloques está desactivada mientras se ignoran los espacios en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indexation par bloc est désactivée lorsque les espaces sont ignorés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A blokkonkénti előkészítés ki van kapcsolva, amíg a szóközök figyelmen kívül vannak hagyva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparazione per blocchi è disattivata mentre gli spazi bianchi vengono ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白を無視している間はハンク単位のステージは無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공백을 무시하는 동안에는 헝크 스테이징이 꺼집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaarzetten van blokken is uitgeschakeld zolang witruimte wordt genegeerd."
          }
        },
