    "This Git version cannot inspect partial clones without fetching. Use a newer Git version.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze Gitu nemůže zkontrolovat částečné klony bez vyzvednutí dat. Použijte novější Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Git-Version kann partielle Klone nicht ohne Abruf prüfen. Verwende eine neuere Git-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Git version cannot inspect partial clones without fetching. Use a newer Git version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de Git no puede inspeccionar clones parciales sin obtener datos. Usa una versión más reciente de Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Git ne peut pas inspecter les clones partiels sans récupération. Utilisez une version plus récente de Git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a Git-verzió nem tud részleges klónokat vizsgálni lekérés nélkül. Használjon újabb Gitet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di Git non può esaminare cloni parziali senza recuperare dati. Usa una versione più recente di Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Git バージョンはフェッチせずに部分クローンを検査できません。新しい Git バージョンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Git 버전은 가져오기 없이 부분 복제를 검사할 수 없습니다. 더 최신 Git 버전을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Git-versie kan gedeeltelijke klonen niet inspecteren zonder ophalen. Gebruik een nieuwere Git-versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja Git nie może sprawdzać częściowych klonów bez pobierania. Użyj nowszej wersji Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do Git não pode inspecionar clones parciais sem buscar dados. Use uma versão mais recente do Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия Git не может проверять частичные клоны без получения данных. Используйте более новую версию Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Git-version kan inte granska partiella kloner utan hämtning. Använd en nyare Git-version."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git เวอร์ชันนี้ตรวจสอบ partial clone โดยไม่ fetch ไม่ได้ ให้ใช้ Git เวอร์ชันใหม่กว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Git sürümü kısmi klonları getirme yapmadan inceleyemez. Daha yeni bir Git sürümü kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця версія Git не може перевіряти часткові клони без отримання даних. Використовуйте новішу версію Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Git 版本无法在不获取的情况下检查部分克隆。请使用更新的 Git 版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Git 版本無法在不擷取的情況下檢查部分複製。請使用更新的 Git 版本。"
          }
        }
      }
    },
