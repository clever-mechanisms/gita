          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie przyjął zmiany. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não aceitou a alteração. Atualize e tente novamente."
          }
        },
