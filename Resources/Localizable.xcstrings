    "Only skipped commits remain to test. Reset bisect or inspect skipped commits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only skipped commits remain to test. Reset bisect or inspect skipped commits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K otestování zbývají jen přeskočené revize. Resetujte bisect nebo zkontrolujte přeskočené revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind nur noch übersprungene Commits zum Testen übrig. Setze Bisect zurück oder prüfe übersprungene Commits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedan commits omitidos por probar. Restablece bisect o inspecciona los commits omitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des commits ignorés restent à tester. Réinitialisez bisect ou inspectez les commits ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano da testare solo commit saltati. Esegui il reset del bisect o ispeziona i commit saltati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már csak kihagyott commitok maradtak tesztelésre. Állítsa vissza a bisectet, vagy vizsgálja meg a kihagyott commitokat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er blijven alleen overgeslagen commits over om te testen. Reset bisect of inspecteer overgeslagen commits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do przetestowania pozostały wyłącznie pominięte commity. Zresetuj bisect lub sprawdź pominięte commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam apenas commits pulados para testar. Redefina o bisect ou inspecione os commits pulados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast överhoppade commits återstår att testa. Återställ bisect eller granska överhoppade commits."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือเฉพาะ commit ที่ข้ามไว้ให้ทดสอบ ให้ reset bisect หรือตรวจสอบ commit ที่ข้ามไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test edilecek yalnızca atlanan commitler kaldı. Bisect’i sıfırlayın veya atlanan commitleri inceleyin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остались только пропущенные коммиты. Сбросьте bisect или просмотрите пропущенные коммиты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевірки залишилися лише пропущені коміти. Скиньте бісекцію або перегляньте пропущені коміти."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト可能なコミットはスキップ済みのものしか残っていません。bisect をリセットするか、スキップしたコミットを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트할 커밋이 건너뛴 커밋만 남았습니다. Bisect를 리셋하거나 건너뛴 커밋을 검사하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅剩已跳过的提交可供测试。请重置二分查找或检查已跳过的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅剩已略過的提交可供測試。請重設二分搜尋或檢查已略過的提交。"
          }
        }
      }
    },
