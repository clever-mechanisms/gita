          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดเมื่อลงชื่อเข้าใช้ใช้ไม่ได้กับ Gitā ชุดนี้ ให้ใช้แอปที่ติดตั้งใน Applications"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
