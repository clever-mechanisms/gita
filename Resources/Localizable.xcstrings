    "Active-agent checkouts are skipped by bulk cleanup. Select folders explicitly to Trash them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active-agent checkouts are skipped by bulk cleanup. Select folders explicitly to Trash them."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hromadné čištění přeskakuje pracovní kopie s aktivními agenty. Chcete-li je přesunout do Koše, vyberte složky ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouts mit aktiven Agenten werden bei der Sammelbereinigung übersprungen. Wähle Ordner ausdrücklich aus, um sie in den Papierkorb zu legen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza masiva omite las copias de trabajo con agentes activos. Selecciona las carpetas explícitamente para moverlas a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies de travail avec un agent actif sont ignorées lors du nettoyage groupé. Sélectionnez explicitement les dossiers pour les placer dans la Corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I checkout con agenti attivi vengono saltati dalla pulizia in blocco. Seleziona esplicitamente le cartelle per spostarle nel Cestino."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tömeges tisztítás kihagyja az aktív ügynökkel rendelkező munkapéldányokat. A Kukába helyezéshez jelölje ki a mappákat egyenként."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouts met actieve agenten worden overgeslagen bij bulkopruiming. Selecteer mappen expliciet om ze naar de Prullenmand te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbiorcze oczyszczanie pomija kopie robocze z aktywnymi agentami. Zaznacz foldery ręcznie, aby przenieść je do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouts com agentes ativos são ignorados pela limpeza em lote. Selecione pastas explicitamente para movê-las para o Lixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utcheckningar med aktiva agenter hoppas över vid massrensning. Markera mappar manuellt för att flytta dem till papperskorgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างข้อมูลแบบกลุ่มจะข้าม checkout ที่มี agent กำลังทำงานอยู่ หากต้องการย้ายไปถังขยะให้เลือกโฟลเดอร์ด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin ajan bulunan çalışma kopyaları toplu temizlikte atlanır. Çöp Sepeti’ne taşımak için klasörleri açıkça seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочие копии с активными агентами пропускаются при массовой очистке. Выберите папки вручную, чтобы переместить их в Корзину."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Масове очищення пропускає робочі копії з активними агентами. Виберіть папки вручну, щоб перемістити їх до Смітника."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント稼働中のチェックアウトは一括クリーンアップでスキップされます。ゴミ箱に入れるにはフォルダを明示的に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 에이전트가 있는 체크아웃은 일괄 정리에서 제외됩니다. 휴지통으로 이동하려면 폴더를 직접 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量清理会跳过存在活跃代理的检出。如需移至废纸篓，请手动选择文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次清理會略過有作用中代理的簽出。如需丟進垃圾桶，請手動選取檔案夾。"
          }
        }
      }
    },
