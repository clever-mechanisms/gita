          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scal każdy konflikt, którego strony zmieniają różne wiersze lub słowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
