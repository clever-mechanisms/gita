          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 반환한 프로젝트 상세 정보를 검증하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel gaf projectdetails die niet konden worden geverifieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zwrócił szczegóły projektu, których nie można zweryfikować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel retornou detalhes do projeto que não puderam ser verificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel вернул сведения о проекте, которые не удалось подтвердить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel returnerade projektdetaljer som inte kunde verifieras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel ส่งรายละเอียดโปรเจกต์ที่ตรวจสอบไม่ได้กลับมา"
          }
        },
        "tr": {
