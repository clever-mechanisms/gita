    "This conflict changed on disk. Reload it before saving.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento konflikt se na disku změnil. Před uložením jej načtěte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Konflikt wurde auf dem Datenträger geändert. Lade ihn vor dem Speichern neu."
