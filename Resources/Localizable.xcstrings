    "Try popping without restoring staged index state instead? %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try popping without restoring staged index state instead? %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkusit vyzvednout bez obnovení připraveného stavu indexu? %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen versuchen, ohne Wiederherstellung des gestagten Indexzustands anzuwenden und zu entfernen? %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Intentar extraer el stash sin restaurar el estado del índice preparado? %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayer d’appliquer et supprimer le stash sans restaurer l’état de l’index ? %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provare ad applicare e rimuovere senza ripristinare lo stato preparato dell’indice? %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megpróbálja inkább az előkészített indexállapot visszaállítása nélkül elővenni? %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In plaats daarvan proberen te poppen zonder de klaargezette indexstatus te herstellen? %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbować zdjąć schowek zmian bez przywracania stanu indeksu? %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar aplicar e remover o stash sem restaurar o estado preparado do índice? %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök tillämpa och ta bort utan att återställa det förberedda indextillståndet istället? %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลอง pop โดยไม่กู้คืนสถานะ staged index แทนหรือไม่? %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine hazırlanan indeks durumunu geri yüklemeden uygulayıp kaldırmayı denemek ister misiniz? %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробовать извлечь без восстановления состояния индекса? %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробувати витягти без відновлення стану індексу? %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに、ステージ済みインデックスの状態を復元せずにポップしてみますか？ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 스테이징된 인덱스 상태를 복원하지 않고 팝해 보시겠습니까? %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改为不恢复已暂存索引状态并尝试弹出？%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改為不還原已暫存索引狀態並嘗試彈出？%@"
          }
        }
      }
    },
