            "value": "Tento pracovní strom se změnil. Před odstraněním jej zkontrolujte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Worktree hat sich geändert. Prüfe ihn erneut vor dem Entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This worktree changed. Review it again before removing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este árbol de trabajo cambió. Revísalo de nuevo antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet arbre de travail a changé. Examinez-le à nouveau avant de le supprimer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa megváltozott. Eltávolítás előtt ellenőrizze újra."
