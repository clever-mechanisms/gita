    "The file has unstaged changes. Stage or discard them before reopening its conflict.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor obsahuje nepřipravené změny. Před opětovným otevřením konfliktu je připravte nebo zahoďte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat ungestagte Änderungen. Stage oder verwirf sie, bevor du ihren Konflikt erneut öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has unstaged changes. Stage or discard them before reopening its conflict."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo tiene cambios sin preparar. Prepáralos o descártalos antes de reabrir su conflicto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient des modifications non indexées. Indexez-les ou abandonnez-les avant de rouvrir son conflit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlban előkészítetlen változások vannak. Az ütközés újranyitása előtt készítse elő vagy vesse el őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file ha modifiche non preparate. Preparale o scartale prima di riaprire il suo conflitto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに未ステージの変更があります。競合を開き直す前に、ステージするか破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 스테이징되지 않은 변경 사항이 있습니다. 충돌을 다시 열기 전에 스테이징하거나 버리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand heeft niet-klaargezette wijzigingen. Zet ze klaar of verwerp ze voordat je het conflict opnieuw opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik ma zmiany poza indeksem. Dodaj je do indeksu lub odrzuć przed ponownym otwarciem konfliktu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo tem alterações não preparadas. Prepare-as ou descarte-as antes de reabrir o conflito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле есть изменения вне индекса. Добавьте их в индекс или отбросьте, прежде чем снова открывать конфликт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen har oförberedda ändringar. Förbered eller kasta dem innan du öppnar dess konflikt igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์มีการเปลี่ยนแปลงที่ยังไม่ staged ให้ stage หรือทิ้งก่อนเปิด conflict ของไฟล์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada hazırlanmamış değişiklikler var. Çakışmasını yeniden açmadan önce bunları hazırlayın veya atın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл має зміни поза індексом. Додайте їх до індексу або відкиньте, перш ніж знову відкривати конфлікт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件有未暂存的更改。请先暂存或丢弃，再重新打开其冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案有未暫存的變更。請先暫存或捨棄，再重新打開其衝突。"
          }
        }
      }
    },
