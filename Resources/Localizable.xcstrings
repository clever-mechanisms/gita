    "An incomplete Git sequence is active. Finish it with Git before starting another operation.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá neúplná posloupnost Gitu. Před zahájením jiné operace ji dokončete pomocí Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unvollständige Git-Sequenz ist aktiv. Beende sie mit Git, bevor du einen weiteren Vorgang startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An incomplete Git sequence is active. Finish it with Git before starting another operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una secuencia de Git incompleta activa. Termínala con Git antes de iniciar otra operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séquence Git incomplète est active. Terminez-la avec Git avant de lancer une autre opération."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiányos Git-műveletsor van folyamatban. Másik művelet indítása előtt fejezze be a Gittel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una sequenza Git incompleta. Terminala con Git prima di avviare un’altra operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了の Git シーケンスがあります。別の操作を始める前に Git で完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되지 않은 Git 시퀀스가 실행 중입니다. 다른 작업을 시작하기 전에 Git으로 완료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een onvolledige Git-reeks actief. Voltooi deze met Git voordat je een andere bewerking start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa niepełna sekwencja Gitā. Zakończ ją w Gicie przed rozpoczęciem innej operacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma sequência Git incompleta ativa. Conclua-a com o Git antes de iniciar outra operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть незавершённая последовательность Git. Завершите её средствами Git перед новой операцией."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ofullständig Git-sekvens är aktiv. Slutför den med Git innan du startar en annan åtgärd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีลำดับคำสั่ง Git ที่ยังทำไม่เสร็จอยู่ ให้ทำให้เสร็จด้วย Git ก่อนเริ่มการดำเนินการอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanmamış bir Git dizisi etkin. Başka bir işlem başlatmadan önce Git ile tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є незавершена послідовність Git. Завершіть її засобами Git перед новою операцією."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的 Git 操作序列。请先使用 Git 完成，再开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的 Git 操作序列。請先使用 Git 完成，再開始其他操作。"
          }
        }
      }
    },
    "An unsupported Git sequence is active. Finish it with Git before starting another operation.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá nepodporovaná posloupnost Gitu. Před zahájením jiné operace ji dokončete pomocí Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
