    "Showing the first 50 jobs and up to 200 steps per job. Open GitHub for the full view.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno prvních 50 úloh a nejvýše 200 kroků na úlohu. Úplný přehled najdete na GitHubu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
