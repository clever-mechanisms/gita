    "Submit feedback and approve merging these changes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslat zpětnou vazbu a schválit sloučení těchto změn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback senden und das Mergen dieser Änderungen genehmigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit feedback and approve merging these changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar comentarios y aprobar la fusión de estos cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer un avis et approuver la fusion de ces modifications."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszajelzés küldése és a változtatások egyesítésének jóváhagyása."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un feedback e approva il merge di queste modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信し、これらの変更のマージを承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 제출하고 이 변경 사항의 병합을 승인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback versturen en het mergen van deze wijzigingen goedkeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij opinię i zatwierdź scalenie tych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar feedback e aprovar o merge destas alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить отзыв и одобрить слияние этих изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka feedback och godkänn sammanslagning av ändringarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นและอนุมัติการ merge การเปลี่ยนแปลงเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim gönder ve bu değişikliklerin birleştirilmesini onayla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати відгук і схвалити злиття цих змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交反馈并批准合并这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交意見回饋並核准合併這些變更。"
          }
        }
      }
    },
    "Submit feedback that must be addressed before merging.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslat zpětnou vazbu, kterou je nutné vyřešit před sloučením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback senden, das vor dem Mergen umgesetzt werden muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit feedback that must be addressed before merging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar comentarios que deben resolverse antes de fusionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer un avis à traiter avant la fusion."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan visszajelzés küldése, amelyet egyesítés előtt kezelni kell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un feedback da risolvere prima del merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージ前に対応が必要なフィードバックを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 전에 해결해야 하는 피드백을 제출합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback versturen die vóór het mergen verwerkt moet worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij opinię, którą trzeba uwzględnić przed scaleniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar feedback que deve ser resolvido antes do merge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить отзыв, который нужно учесть до слияния."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
