            "value": "%@의 메시지는 64 KiB 이내여야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht voor %@ moet binnen 64 KiB passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunikat dla %@ musi mieścić się w 64 KiB."
