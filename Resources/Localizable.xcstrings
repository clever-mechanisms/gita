    "Choose an ancestor before at least one current-branch commit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an ancestor before at least one current-branch commit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte předka, za kterým následuje alespoň jedna revize aktuální větve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un antecesor anterior a al menos un commit de la rama actual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Vorfahren vor mindestens einem Commit des aktuellen Branches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olyan őst válasszon, amelyet legalább egy commit követ az aktuális ágon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un ancêtre précédant au moins un commit de la branche actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のブランチのコミットが1件以上後に続く祖先を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 브랜치의 커밋이 하나 이상 뒤따르는 조상을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择至少先于当前分支一次提交的祖先提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選取至少先於目前分支一次提交的祖先提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un antenato precedente ad almeno un commit del ramo attuale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz przodka, po którym następuje co najmniej jeden commit bieżącej gałęzi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een voorouder vóór minstens één commit van de huidige branch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um ancestral anterior a pelo menos um commit da branch atual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli dalda en az bir commitin öncesindeki bir atayı seçin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en förfader före minst en commit i den aktuella grenen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите предка, после которого в текущей ветке есть хотя бы один коммит для переноса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть предка, після якого в поточній гілці є хоча б один коміт для перенесення."
          }
        },
        "th": {
          "stringUnit": {
