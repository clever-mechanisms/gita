          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 Vercel 傳回的專案詳細資訊。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel ha restituito dettagli del progetto che non è stato possibile verificare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zwrócił szczegóły projektu, których nie można zweryfikować."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel gaf projectdetails die niet konden worden geverifieerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel retornou detalhes do projeto que não puderam ser verificados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel doğrulanamayan proje ayrıntıları döndürdü."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel returnerade projektdetaljer som inte kunde verifieras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel вернул сведения о проекте, которые не удалось подтвердить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel повернув відомості про проєкт, які не вдалося підтвердити."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel ส่งรายละเอียดโปรเจกต์ที่ตรวจสอบไม่ได้กลับมา"
          }
        }
      }
    },
    "Vercel stops this build. It cannot be resumed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stops this build. It cannot be resumed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stoppt diesen Build. Er kann nicht fortgesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel detiene esta compilación. No se puede reanudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel arrête ce build. Il ne pourra pas être repris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel interrompe questa build. Non potrà essere ripresa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stopt deze build. Deze kan niet worden hervat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel interrompe este build. Ele não poderá ser retomado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stoppar detta bygge. Det kan inte återupptas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel toto sestavení zastaví. Pokračovat v něm už nebude možné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel leállítja ezt az összeállítást. Később nem folytatható."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zatrzyma tę kompilację. Nie będzie można jej wznowić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bu derlemeyi durdurur. Derleme daha sonra sürdürülemez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel остановит эту сборку. Возобновить её будет нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel зупинить цю збірку. Відновити її буде неможливо."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel はこのビルドを停止します。停止したビルドは再開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 이 빌드를 중지합니다. 중지된 빌드는 재개할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 将停止此构建。停止后无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 將停止此建置。停止後無法恢復。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel จะหยุด build นี้และทำต่อไม่ได้"
          }
        }
      }
    },
