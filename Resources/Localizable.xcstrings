    "Next stage approved. Traffic shifts when Vercel finishes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next stage approved. Traffic shifts when Vercel finishes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další fáze schválena. Provoz se přesune, až Vercel dokončí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächste Stufe freigegeben. Der Traffic wechselt, sobald Vercel fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente etapa aprobada. El tráfico cambia cuando Vercel termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape suivante approuvée. Le trafic bascule quand Vercel a terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase successiva approvata. Il traffico si sposta quando Vercel termina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő szakasz jóváhagyva. A forgalom átvált, amikor a Vercel végez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende fase goedgekeurd. Het verkeer verschuift zodra Vercel klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następny etap zatwierdzony. Ruch przełączy się, gdy Vercel skończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Próxima etapa aprovada. O tráfego muda quando a Vercel terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa steg godkänt. Trafiken flyttas när Vercel är klar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki aşama onaylandı. Vercel bitirdiğinde trafik geçer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий этап одобрен. Трафик переключится, когда Vercel закончит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступний етап схвалено. Трафік перемкнеться, коли Vercel завершить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の段階を承認しました。Vercel の処理が終わるとトラフィックが移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 단계를 승인했습니다. Vercel이 완료하면 트래픽이 전환됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准下一阶段。Vercel 完成后流量将切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已核准下一階段。Vercel 完成後流量將切換。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุมัติขั้นถัดไปแล้ว ทราฟฟิกจะเปลี่ยนเมื่อ Vercel ทำงานเสร็จ"
          }
        }
      }
    },
    "Next to the commits they belong to, with Vercel previews.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next to the commits they belong to, with Vercel previews."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedle revizí, ke kterým patří, s náhledy Vercel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben den Commits, zu denen sie gehören, mit Vercel-Vorschauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto a los commits a los que pertenecen, con vistas previas de Vercel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À côté des commits auxquels ils se rapportent, avec les aperçus Vercel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azok mellett a commitok mellett, amelyekhez tartoznak, Vercel-előnézetekkel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accanto ai commit a cui appartengono, con le anteprime Vercel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連するコミットの横に、Vercel のプレビューとあわせて表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 커밋 옆에 Vercel 미리보기와 함께 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naast de commits waar ze bij horen, met Vercel-voorvertoningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obok commitów, do których należą, z podglądami Vercel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao lado dos commits a que pertencem, com prévias da Vercel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом с коммитами, к которым они относятся, вместе с предпросмотрами Vercel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bredvid de commits de hör till, med förhandsvisningar från Vercel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ait oldukları commitlerin yanında, Vercel önizlemeleriyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поруч із комітами, до яких вони належать, разом із попередніми переглядами Vercel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在所属提交旁，并附带 Vercel 预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在所屬提交旁，並附帶 Vercel 預覽。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถัดจาก commit ที่เกี่ยวข้อง พร้อมตัวอย่างจาก Vercel"
          }
        }
      }
    },
