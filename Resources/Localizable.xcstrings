    "Continue or abort the current Git operation first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue or abort the current Git operation first."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve pokračujte v aktuální operaci Gitu nebo ji přerušte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero continúa o aborta la operación de Git actual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze zuerst den aktuellen Git-Vorgang fort oder brich ihn ab."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb folytassa vagy szakítsa meg az aktuális Git-műveletet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez ou abandonnez d’abord l’opération Git en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に現在の Git 操作を続行または中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 현재 Git 작업을 계속하거나 중단하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先继续或中止当前 Git 操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先繼續或中止目前的 Git 操作。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima continua o interrompi l’operazione Git attuale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw kontynuuj lub przerwij bieżącą operację Git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga eerst door met de huidige Git-bewerking of breek deze af."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue ou aborte a operação Git atual primeiro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce geçerli Git işlemine devam edin veya işlemi durdurun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt eller avbryt den aktuella Git-åtgärden först."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала продолжите или прервите текущую операцию Git."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку продовжте або перервіть поточну операцію Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการ Git ที่ค้างอยู่ต่อหรือยกเลิกก่อน"
          }
        }
      }
    },
