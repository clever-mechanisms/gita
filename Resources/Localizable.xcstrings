    "main cannot just move up, so a merge commit joins the two.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "main se nemůže jen posunout, takže obě spojí slučovací revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "main kann nicht einfach vorrücken, daher verbindet ein Merge-Commit die beiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "main cannot just move up, so a merge commit joins the two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "main no puede simplemente avanzar, así que un commit de fusión une ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "main ne peut pas simplement avancer, donc un commit de fusion réunit les deux."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A main nem léphet egyszerűen előre, ezért egy egyesítési commit köti össze a kettőt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "main non può semplicemente avanzare, quindi un commit di merge unisce i due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "main を単純に進めることはできないため、マージコミットで 2 つを結合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "main을 단순히 앞으로 이동할 수 없으므로 병합 커밋이 둘을 합칩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "main kan niet zomaar opschuiven, dus een mergecommit verbindt de twee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "main nie może się po prostu przesunąć, więc commit scalający łączy obie gałęzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "main não pode apenas avançar, então um commit de mesclagem une os dois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "main нельзя просто передвинуть вперёд, поэтому их объединяет коммит слияния."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "main kan inte bara flyttas fram, så en sammanslagningscommit förenar de två."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "main เลื่อนขึ้นเฉย ๆ ไม่ได้ merge commit จึงรวมทั้งสองเข้าด้วยกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "main yalnızca ileri alınamaz, bu yüzden bir birleştirme commiti ikisini birleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "main не можна просто пересунути вперед, тож коміт зливання об’єднує обидві гілки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "main 无法直接前移，因此由合并提交连接两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "main 無法直接前移，因此由合併提交連接兩者。"
          }
        }
      }
    },
    "main moves up to origin/main. No commit is made.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "main se posune na origin/main. Nevznikne žádná revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "main rückt auf origin/main vor. Es wird kein Commit erstellt."
          }
        },
