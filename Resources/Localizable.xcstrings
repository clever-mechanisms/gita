    "This branch's configured upstream is missing. Update or unset its upstream first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavená nadřazená větev této větve chybí. Nejprve ji aktualizujte nebo zrušte její nastavení."
          }
        },
        "de": {
          "stringUnit": {
