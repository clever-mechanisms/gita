    "Open at Login could not be enabled. Try again in Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevírání po přihlášení se nepodařilo povolit. Zkuste to znovu v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Beim Anmelden öffnen“ konnte nicht aktiviert werden. Versuche es erneut in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login could not be enabled. Try again in Settings."
          }
        },
        "es": {
