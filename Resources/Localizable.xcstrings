            "value": "선택한 업스트림을 사용할 수 없거나 유형이 다릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde upstream is niet beschikbaar of heeft een ander type."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana gałąź śledzona jest niedostępna lub ma inny typ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O upstream selecionado está indisponível ou tem outro tipo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная отслеживаемая ветка недоступна или имеет другой тип."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda uppströmmen är inte tillgänglig eller har en annan typ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "upstream ที่เลือกใช้ไม่ได้หรือเป็นประเภทอื่น"
