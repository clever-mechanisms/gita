      }
    },
    "The native rebase did not finish preparing its plan. Abort it before starting again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native rebase did not finish preparing its plan. Abort it before starting again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativní přesazení nedokončilo přípravu plánu. Před novým spuštěním je přerušte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rebase nativo no terminó de preparar su plan. Abórtalo antes de empezar de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der native Rebase hat die Planvorbereitung nicht abgeschlossen. Brich ihn vor einem Neustart ab."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A natív újraalapozás nem fejezte be a terv előkészítését. Újraindítás előtt szakítsa meg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rebase natif n’a pas fini de préparer son plan. Abandonnez-le avant de recommencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブのリベース計画の準備が完了していません。再開する前に中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 리베이스가 계획 준비를 완료하지 못했습니다. 다시 시작하기 전에 중단하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生变基尚未完成计划准备。请先中止，再重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生重定基底尚未完成計畫準備。請先中止，再重新開始。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rebase nativo non ha finito di preparare il piano. Interrompilo prima di ricominciare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natywna zmiana bazy nie ukończyła przygotowania planu. Przerwij ją przed ponownym rozpoczęciem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De native rebase heeft het plan niet volledig voorbereid. Breek deze af voordat je opnieuw begint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rebase nativo não terminou de preparar o plano. Aborte-o antes de começar novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel yeniden temellendirme, planını hazırlamayı bitirmedi. Yeniden başlamadan önce işlemi durdurun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inbyggda rebasen slutförde inte förberedelsen av planen. Avbryt den innan du börjar igen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенное перебазирование не завершило подготовку плана. Прервите его перед повторным запуском."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудоване перебазовування не завершило підготовку плану. Перервіть його перед повторним запуском."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "native rebase เตรียมแผนไม่เสร็จ ให้ยกเลิกก่อนเริ่มใหม่"
          }
        }
      }
    },
    "The native rebase editor executable is unavailable.": {
