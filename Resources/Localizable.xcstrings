    "Removing a worktree also deletes ignored files inside it (such as .env or build folders).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a worktree also deletes ignored files inside it (such as .env or build folders)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranění pracovního stromu smaže i ignorované soubory uvnitř (například .env nebo složky sestavení)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen eines Worktrees löscht auch darin enthaltene ignorierte Dateien (wie .env oder Build-Ordner)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un árbol de trabajo también borra los archivos ignorados que contiene (como .env o carpetas de compilación)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression d’un arbre de travail supprime également les fichiers ignorés qu’il contient (tels que .env ou les dossiers de build)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rimozione di un albero di lavoro elimina anche i file ignorati al suo interno (come .env o le cartelle di build)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa eltávolítása a benne lévő, figyelmen kívül hagyott fájlokat (például a .env fájlt vagy a build mappákat) is törli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verwijderen van een worktree verwijdert ook genegeerde bestanden erin (zoals .env of buildmappen)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie drzewa roboczego usuwa również znajdujące się w nim ignorowane pliki (np. .env lub foldery kompilacji)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover uma árvore de trabalho também exclui arquivos ignorados dentro dela (como .env ou pastas de build)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ta bort en worktree raderar även ignorerade filer i den (som .env eller byggmappar)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำ worktree ออกจะลบไฟล์ที่ถูก ignore ภายในด้วย (เช่น .env หรือโฟลเดอร์ build)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çalışma ağacını kaldırmak, içindeki yoksayılan dosyaları da (.env veya derleme klasörleri gibi) siler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление рабочего дерева также удаляет игнорируемые файлы внутри него (например, .env или папки сборки)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення робочого дерева також видаляє ігноровані файли всередині нього (наприклад, .env або папки збірки)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーを削除すると、内部の無視対象ファイル（.env やビルドフォルダなど）も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 트리를 제거하면 그 안의 무시된 파일(.env 또는 빌드 폴더 등)도 함께 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除工作树时也会删除其中的被忽略文件（例如 .env 或构建文件夹）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除工作樹也會刪除其中的已忽略檔案（例如 .env 或建置檔案夾）。"
          }
        }
      }
    },
