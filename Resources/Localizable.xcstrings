    "Git LFS is not installed. Install it via Homebrew (brew install git-lfs) to manage LFS files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS is not installed. Install it via Homebrew (brew install git-lfs) to manage LFS files."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS není nainstalován. Pro správu souborů LFS jej nainstalujte přes Homebrew (brew install git-lfs)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS ist nicht installiert. Installiere es über Homebrew (brew install git-lfs), um LFS-Dateien zu verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS no está instalado. Instálalo mediante Homebrew (brew install git-lfs) para gestionar archivos LFS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS n’est pas installé. Installez-le via Homebrew (brew install git-lfs) pour gérer les fichiers LFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS non è installato. Installalo tramite Homebrew (brew install git-lfs) per gestire i file LFS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git LFS nincs telepítve. Az LFS-fájlok kezeléséhez telepítse Homebrew-val (brew install git-lfs)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS is niet geïnstalleerd. Installeer het via Homebrew (brew install git-lfs) om LFS-bestanden te beheren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS nie jest zainstalowany. Zainstaluj go przez Homebrew (brew install git-lfs), aby zarządzać plikami LFS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git LFS não está instalado. Instale-o via Homebrew (brew install git-lfs) para gerenciar arquivos LFS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS är inte installerat. Installera det via Homebrew (brew install git-lfs) för att hantera LFS-filer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ติดตั้ง Git LFS ให้ติดตั้งผ่าน Homebrew (brew install git-lfs) เพื่อจัดการไฟล์ LFS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS yüklü değil. LFS dosyalarını yönetmek için Homebrew ile yükleyin (brew install git-lfs)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS не установлен. Установите его через Homebrew (brew install git-lfs), чтобы управлять файлами LFS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS не встановлено. Установіть його через Homebrew (brew install git-lfs), щоб керувати файлами LFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS がインストールされていません。LFS ファイルを管理するには Homebrew（brew install git-lfs）でインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git LFS가 설치되어 있지 않습니다. LFS 파일을 관리하려면 Homebrew(brew install git-lfs)로 설치하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 Git LFS。请通过 Homebrew（brew install git-lfs）安装以管理 LFS 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安裝 Git LFS。請透過 Homebrew（brew install git-lfs）安裝以管理 LFS 檔案。"
          }
