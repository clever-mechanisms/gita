    "Enable recommended Git optimizations for faster status and graph operations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable recommended Git optimizations for faster status and graph operations."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte doporučené optimalizace Gitu pro rychlejší status a práci s grafem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere empfohlene Git-Optimierungen für schnellere Status- und Graph-Operationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las optimizaciones recomendadas de Git para acelerar el estado y el grafo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les optimisations Git recommandées pour accélérer le statut et le graphe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le ottimizzazioni Git consigliate per velocizzare stato e grafico."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az ajánlott Git-optimalizálásokat a gyorsabb állapot- és gráfműveletekhez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel aanbevolen Git-optimalisaties in voor snellere status- en grafiekbewerkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz zalecane optymalizacje Gita, aby przyspieszyć status i operacje na grafie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as otimizações recomendadas do Git para acelerar status e operações no grafo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera rekommenderade Git-optimeringar för snabbare status och grafoperationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้การปรับประสิทธิภาพ Git ที่แนะนำเพื่อเร่งความเร็วสถานะและกราฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı durum ve grafik işlemleri için önerilen Git iyileştirmelerini etkinleştirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите рекомендуемые оптимизации Git для ускорения status и работы с графом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть рекомендовані оптимізації Git для швидшої роботи status і графа."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータス確認やグラフ操作を高速化するため、推奨される Git 最適化を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 확인과 그래프 작업 속도를 높이려면 권장 Git 최적화를 활성화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用推荐的 Git 优化以加快状态检查和提交图操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用建議的 Git 最佳化以加快狀態檢查與提交圖操作。"
          }
        }
      }
    },
    "Enable three-way apply to use the common base. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
