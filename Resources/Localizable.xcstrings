    "Remove replacement refs before editing this history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove replacement refs before editing this history."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před úpravou této historie odstraňte náhradní reference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las referencias de sustitución antes de editar este historial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne Ersetzungsreferenzen, bevor du diesen Verlauf bearbeitest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előzmények szerkesztése előtt távolítsa el a helyettesítő hivatkozásokat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les références de remplacement avant de modifier cet historique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この履歴を編集する前に置換参照を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록을 편집하기 전에 대체 참조를 제거하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑此历史前，请移除替换引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯此歷史前，請移除替換參照。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi i riferimenti sostitutivi prima di modificare questa cronologia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed edycją tej historii usuń referencje zastępcze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder vervangingsreferenties voordat je deze geschiedenis bewerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova as referências de substituição antes de editar este histórico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçmişi düzenlemeden önce replace referanslarını kaldırın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort ersättningsreferenser innan du redigerar denna historik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите замещающие ссылки перед редактированием этой истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаліть замінювальні посилання перед редагуванням цієї історії."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำ replacement ref ออกก่อนแก้ไขประวัตินี้"
          }
        }
      }
    },
