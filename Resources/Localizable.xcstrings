          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie pozwala zatwierdzić własnego pull requesta ani prosić w nim o zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
