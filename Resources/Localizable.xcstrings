    "Adds Gitā's hooks to %@ (keeping a backup) and the gita skill to %@/skills.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds Gitā's hooks to %@ (keeping a backup) and the gita skill to %@/skills."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá hooky Gitā do %@ (se zálohou) a skill gita do %@/skills."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Hooks von Gitā zu %@ hinzu (mit Sicherungskopie) und den gita-Skill zu %@/skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los hooks de Gitā a %@ (con una copia de seguridad) y el skill gita a %@/skills."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les hooks de Gitā à %@ (avec une sauvegarde) et le skill gita à %@/skills."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge gli hook di Gitā a %@ (con un backup) e la skill gita a %@/skills."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáadja a Gitā hookjait ide: %@ (biztonsági mentéssel), a gita skillt pedig ide: %@/skills."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt de hooks van Gitā toe aan %@ (met een reservekopie) en de gita-skill aan %@/skills."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje hooki Gitā do %@ (z kopią zapasową) i skill gita do %@/skills."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os hooks do Gitā a %@ (com um backup) e a skill gita a %@/skills."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till Gitā hooks i %@ (med en säkerhetskopia) och gita-skillen i %@/skills."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā hook’larını %@ konumuna (yedekle birlikte) ve gita skill’ini %@/skills konumuna ekler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет хуки Gitā в %@ (с резервной копией) и навык gita в %@/skills."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає хуки Gitā до %@ (з резервною копією) і навичку gita до %@/skills."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā のフックを %@ に（バックアップ付きで）、gita スキルを %@/skills に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā 훅을 %@에(백업 포함), gita 스킬을 %@/skills에 추가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Gitā 的钩子添加到 %@（保留备份），并将 gita 技能添加到 %@/skills。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Gitā 的掛鉤加入 %@（保留備份），並將 gita 技能加入 %@/skills。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม hook ของ Gitā ลงใน %@ (สำรองไว้) และเพิ่ม skill gita ลงใน %@/skills"
          }
        }
      }
    },
