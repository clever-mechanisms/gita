    "Replace the last commit with this message and the staged changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the last commit with this message and the staged changes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit poslední revizi touto zprávou a připravenými změnami."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituir el último commit por este mensaje y los cambios preparados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den letzten Commit durch diese Nachricht und die gestagten Änderungen ersetzen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó commit lecserélése erre az üzenetre és az előkészített változásokra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer le dernier commit par ce message et les modifications indexées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前のコミットを、このメッセージとステージ済みの変更で置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 커밋을 이 메시지와 스테이징된 변경 사항으로 대체합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此消息和已暂存更改替换上次提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用此訊息和已暫存變更取代上次提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci l’ultimo commit con questo messaggio e le modifiche preparate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp ostatni commit tym komunikatem i zmianami z indeksu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de laatste commit door dit bericht en de klaargezette wijzigingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir o último commit por esta mensagem e as alterações preparadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son commiti bu ileti ve hazırlanan değişikliklerle değiştir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätt den senaste commiten med detta meddelande och de förberedda ändringarna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить последний коммит этим сообщением и изменениями из индекса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити останній коміт цим повідомленням і змінами з індексу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่ commit ล่าสุดด้วยข้อความนี้และการเปลี่ยนแปลงที่ staged"
          }
        }
      }
    },
