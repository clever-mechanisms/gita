    "Finish bisect and use a complete history without grafts before editing commits.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před úpravou revizí dokončete bisect a použijte úplnou historii bez graftů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Bisect und verwende vor dem Bearbeiten von Commits einen vollständigen Verlauf ohne Grafts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish bisect and use a complete history without grafts before editing commits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina bisect y usa un historial completo sin grafts antes de editar commits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez bisect et utilisez un historique complet sans greffons avant de modifier les commits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A commitok szerkesztése előtt fejezze be a bisect műveletet, és használjon teljes, graftok nélküli előzményeket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina bisect e usa una cronologia completa senza graft prima di modificare i commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットを編集する前に bisect を終了し、graft のない完全な履歴を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋을 편집하기 전에 bisect를 완료하고 graft 없는 전체 기록을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi bisect en gebruik een volledige geschiedenis zonder grafts voordat je commits bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed edycją commitów zakończ bisect i użyj pełnej historii bez graftów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua bisect e use um histórico completo sem grafts antes de editar commits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите bisect и используйте полную историю без grafts перед редактированием коммитов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför bisect och använd en fullständig historik utan grafts innan du redigerar commits."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำ bisect ให้เสร็จและใช้ประวัติที่สมบูรณ์โดยไม่มี graft ก่อนแก้ไข commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitleri düzenlemeden önce bisect işlemini bitirin ve graft içermeyen eksiksiz bir geçmiş kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть bisect і використовуйте повну історію без grafts перед редагуванням комітів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑提交前，请结束 bisect，并使用不含 graft 的完整历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯提交前，請結束 bisect，並使用不含 graft 的完整歷史。"
          }
        }
      }
    },
