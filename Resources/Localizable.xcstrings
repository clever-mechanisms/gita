    "Continue or abort the current Git operation first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve pokračujte v aktuální operaci Gitu nebo ji přerušte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze zuerst den aktuellen Git-Vorgang fort oder brich ihn ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue or abort the current Git operation first."
          }
