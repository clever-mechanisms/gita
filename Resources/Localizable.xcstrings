            "state": "translated",
            "value": "Některá metadata žádosti o začlenění nejsou dostupná."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos metadatos de la pull request no están disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
