    "Working-tree blame requires a readable regular file of 16 MiB or smaller.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazení původu řádků v pracovním stromu vyžaduje čitelný běžný soubor o velikosti nejvýše 16 MiB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blame im Arbeitsbaum erfordert eine lesbare reguläre Datei bis höchstens 16 MiB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working-tree blame requires a readable regular file of 16 MiB or smaller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blame en el árbol de trabajo requiere un archivo regular legible de 16 MiB o menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blame de l’arbre de travail nécessite un fichier ordinaire lisible de 16 Mio maximum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa blame-jéhez legfeljebb 16 MiB méretű, olvasható normál fájl szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blame dell’albero di lavoro richiede un file regolare leggibile di dimensioni pari o inferiori a 16 MiB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーの Blame には、16 MiB 以下の読み取り可能な通常ファイルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 트리 블레임에는 16 MiB 이하의 읽을 수 있는 일반 파일이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blame voor de werkboom vereist een leesbaar normaal bestand van maximaal 16 MiB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja blame dla drzewa roboczego wymaga czytelnego zwykłego pliku o rozmiarze do 16 MiB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O blame da árvore de trabalho requer um arquivo comum legível de até 16 MiB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для авторства строк рабочего дерева нужен читаемый обычный файл размером до 16 МиБ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blame för arbetsträdet kräver en läsbar vanlig fil på högst 16 MiB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "blame ใน working tree ต้องใช้ไฟล์ปกติที่อ่านได้ขนาดไม่เกิน 16 MiB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ağacı satır geçmişi için 16 MiB veya daha küçük, okunabilir normal bir dosya gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для авторства рядків робочого дерева потрібен доступний для читання звичайний файл розміром до 16 МіБ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树追溯需要 16 MiB 或更小的可读常规文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹追溯需要 16 MiB 或更小的可讀取一般檔案。"
          }
        }
      }
    },
