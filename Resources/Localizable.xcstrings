    "This commit is already on the upstream branch. Amending it needs a force push.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This commit is already on the upstream branch. Amending it needs a force push."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato revize už je v nadřazené větvi. Její doplnění vyžaduje vynucené odeslání."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este commit ya está en la rama upstream. Enmendarlo requiere un envío forzado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Commit ist bereits im Upstream-Branch. Das Ergänzen erfordert einen erzwungenen Push."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a commit már szerepel a követett ágon. Módosításához kényszerített feltöltés szükséges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce commit est déjà sur la branche amont. L’amender nécessite un push forcé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコミットはすでに上流ブランチにあります。修正するには強制プッシュが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커밋은 이미 업스트림 브랜치에 있습니다. 수정하려면 강제 푸시가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提交已在上游分支上。修订它需要强制推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此提交已在上游分支上。修訂它需要強制推送。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo commit è già nel ramo upstream. Modificarlo richiede un push forzato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten commit jest już w gałęzi śledzonej. Jego poprawienie wymaga wymuszonego wypchnięcia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze commit staat al op de upstreambranch. Aanpassen vereist geforceerd pushen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este commit já está na branch upstream. Emendá-lo exige um push forçado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu commit zaten izlenen dalda. Düzeltmek için zorla göndermek gerekir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här commiten finns redan på uppströmsgrenen. Att ändra den kräver en tvingad sändning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот коммит уже есть в отслеживаемой ветке. Для его исправления нужна принудительная отправка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей коміт уже є у відстежуваній гілці. Щоб виправити його, потрібне примусове надсилання."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit นี้อยู่บน branch upstream แล้ว การแก้ไขต้องใช้ force push"
          }
        }
      }
    },
