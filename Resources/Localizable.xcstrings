    "Merge and stage the conflicted files whose changes do not overlap; the rest stay for you": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučit a připravit konfliktní soubory, jejichž změny se nepřekrývají; zbytek zůstane na vás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfliktdateien, deren Änderungen sich nicht überschneiden, zusammenführen und stagen; der Rest bleibt für dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge and stage the conflicted files whose changes do not overlap; the rest stay for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionar y preparar los archivos en conflicto cuyos cambios no se solapan; el resto queda para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner et indexer les fichiers en conflit dont les modifications ne se chevauchent pas ; les autres restent pour vous"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azon ütköző fájlok egyesítése és előkészítése, amelyek változásai nem fedik egymást; a többi Önre vár"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci e prepara i file in conflitto le cui modifiche non si sovrappongono; gli altri restano a te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更が重ならない競合ファイルをマージしてステージします。残りは手動で対応してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 겹치지 않는 충돌 파일을 병합하고 스테이징합니다. 나머지는 직접 처리하도록 남겨 둡니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg conflicterende bestanden waarvan de wijzigingen niet overlappen samen en zet ze klaar; de rest blijft voor jou"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scal i dodaj do indeksu pliki z konfliktem, których zmiany się nie nakładają; pozostałe zostaną dla Ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclar e preparar os arquivos em conflito cujas alterações não se sobrepõem; o restante fica para você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слить и добавить в индекс файлы с конфликтами, изменения в которых не пересекаются; остальные останутся вам"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå samman och förbered konfliktfilerna vars ändringar inte överlappar; resten lämnas åt dig"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "merge และ stage ไฟล์ที่มี conflict ซึ่งการเปลี่ยนแปลงไม่ทับซ้อนกัน ส่วนที่เหลือเก็บไว้ให้คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri örtüşmeyen çakışmalı dosyaları birleştir ve hazırla; geri kalanı size kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злити й додати до індексу конфліктні файли, зміни в яких не перетинаються; решту залишити вам"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并并暂存更改互不重叠的冲突文件；其余文件留给你处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併並暫存變更互不重疊的衝突檔案；其餘檔案留給你處理"
          }
        }
      }
    },
