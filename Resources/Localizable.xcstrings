          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-kontot %@ är inte inloggat. Kör gh auth login i Terminal och uppdatera sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี GitHub %@ ยังไม่ได้ลงชื่อเข้าใช้ ให้รัน gh auth login ใน Terminal แล้วรีเฟรช"
