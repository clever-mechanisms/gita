    "The message for %@ must fit in 64 KiB.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpráva pro %@ musí mít nejvýše 64 KiB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht für %@ darf höchstens 64 KiB groß sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message for %@ must fit in 64 KiB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de %@ debe caber en 64 KiB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message pour %@ doit tenir dans 64 KiB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
