    "Rollout aborted. Production stays on the previous deployment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollout aborted. Production stays on the previous deployment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavádění přerušeno. Produkce zůstává na předchozím nasazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollout abgebrochen. Produktion bleibt bei der vorherigen Bereitstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despliegue gradual abortado. Producción sigue en el despliegue anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déploiement progressif abandonné. La production reste sur le déploiement précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascio graduale interrotto. La produzione resta sulla distribuzione precedente."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevezetés megszakítva. Az éles környezet az előző telepítésen marad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitrol afgebroken. Productie blijft op de vorige implementatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wdrażanie przerwane. Produkcja pozostaje na poprzednim wdrożeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Implantação gradual abortada. A produção continua na implantação anterior."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrullningen avbröts. Produktionen stannar på föregående driftsättning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kademeli dağıtım durduruldu. Üretim önceki dağıtımda kalır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкатка прервана. Продакшен остаётся на предыдущем развёртывании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Викочування перервано. Продакшен залишається на попередньому розгортанні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロールアウトを中止しました。本番環境は以前のデプロイのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "롤아웃을 중단했습니다. 프로덕션은 이전 배포를 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布已中止。生产环境保留之前的部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發布已中止。正式環境保留先前的部署。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก rollout แล้ว production ยังอยู่ที่ deployment ก่อนหน้า"
          }
        }
      }
    },
    "Rollout completed. The new deployment serves all traffic.": {
