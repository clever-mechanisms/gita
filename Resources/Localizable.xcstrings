    "Resolve the pending changes, then continue.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyřešte nevyřízené změny a poté pokračujte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse die ausstehenden Änderungen und fahre dann fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the pending changes, then continue."
          }
