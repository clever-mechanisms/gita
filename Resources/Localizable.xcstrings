    "Multiple fetch URLs or credential-bearing URL settings are read-only here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple fetch URLs or credential-bearing URL settings are read-only here."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení s více URL pro vyzvednutí nebo s přihlašovacími údaji v URL jsou zde jen pro čtení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las configuraciones con varias URL de obtención o con credenciales son de solo lectura aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen mit mehreren Abruf-URLs oder Zugangsdaten in URLs sind hier schreibgeschützt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A több lekérési URL-t vagy hitelesítési adatokat tartalmazó URL-beállítások itt csak olvashatók."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages avec plusieurs URL de récupération ou des identifiants intégrés sont en lecture seule ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のフェッチ URL や認証情報を含む URL 設定はここでは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 가져오기 URL이나 자격 증명이 포함된 URL 설정은 여기서 읽기 전용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个获取 URL 或含凭据的 URL 设置在此处为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個擷取 URL 或含憑證的 URL 設定在此處為唯讀。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni con più URL di recupero o con credenziali negli URL sono di sola lettura qui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia z wieloma URL pobierania lub URL zawierającymi poświadczenia są tutaj tylko do odczytu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen met meerdere ophaal-URL’s of inloggegevens in URL’s zijn hier alleen-lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurações com vários URLs de busca ou credenciais nos URLs são somente leitura aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla getirme URL'si veya kimlik bilgileri içeren URL ayarları burada salt okunurdur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inställningar med flera hämtnings-URL:er eller inloggningsuppgifter i URL:er är skrivskyddade här."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки с несколькими URL получения или URL с учётными данными здесь доступны только для чтения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри з кількома URL отримання або URL з обліковими даними тут доступні лише для читання."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า fetch URL หลายรายการหรือ URL ที่มีข้อมูลรับรองจะแก้ไขที่นี่ไม่ได้"
          }
        }
      }
    },
