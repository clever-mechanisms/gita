        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una URL de repositorio HTTPS o SSH, o una ruta local absoluta, sin credenciales incrustadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine HTTPS- oder SSH-Repository-URL oder einen absoluten lokalen Pfad ohne eingebettete Zugangsdaten ein."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg HTTPS- vagy SSH-tároló-URL-t, illetve abszolút helyi útvonalat beágyazott hitelesítési adatok nélkül."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL de dépôt HTTPS ou SSH, ou un chemin local absolu, sans identifiants intégrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を含まない HTTPS または SSH のリポジトリ URL、またはローカルの絶対パスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명을 포함하지 않는 HTTPS 또는 SSH 저장소 URL이나 로컬 절대 경로를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含嵌入式凭据的 HTTPS 或 SSH 仓库 URL，或本地绝对路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入不含內嵌憑證的 HTTPS 或 SSH 版本庫 URL，或本機絕對路徑。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un URL di repository HTTPS o SSH, o un percorso locale assoluto, senza credenziali incorporate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz URL repozytorium HTTPS lub SSH albo bezwzględną ścieżkę lokalną bez osadzonych poświadczeń."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een HTTPS- of SSH-repository-URL of een absoluut lokaal pad in, zonder ingesloten inloggegevens."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um URL de repositório HTTPS ou SSH, ou um caminho local absoluto, sem credenciais incorporadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gömülü kimlik bilgileri içermeyen bir HTTPS veya SSH depo URL'si ya da mutlak yerel yol girin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en HTTPS- eller SSH-URL till ett kodförråd, eller en absolut lokal sökväg, utan inbäddade inloggningsuppgifter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите HTTPS- или SSH-адрес репозитория либо абсолютный локальный путь без встроенных учётных данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть HTTPS- або SSH-адресу репозиторію чи абсолютний локальний шлях без вбудованих облікових даних."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอก URL ของ repository แบบ HTTPS หรือ SSH หรือพาธในเครื่องแบบ absolute โดยไม่ฝังข้อมูลรับรอง"
          }
        }
      }
    },
