    "Replace changes in %@ with turn %lld? A safety snapshot will be saved first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace changes in %@ with turn %lld? A safety snapshot will be saved first."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit změny v %@ tahem %lld? Nejprve bude uložen bezpečnostní snímek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen in %@ durch Zug %lld ersetzen? Zuerst wird ein Sicherheits-Snapshot gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sustituir los cambios en %@ por el turno %lld? Se guardará antes una instantánea de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer les modifications dans %@ par le tour %lld ? Un instantané de sécurité sera enregistré au préalable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire le modifiche in %1$@ con il turno %2$lld? Verrà prima salvata un’istantanea di sicurezza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecseréli a(z) %@ változásait a(z) %lld. kör állapotára? Előtte biztonsági pillanatkép készül."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in %@ vervangen door beurt %lld? Er wordt eerst een veiligheidsmomentopname opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpić zmiany w %@ turą %lld? Najpierw zostanie zapisana migawka bezpieczeństwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir as alterações em %@ pelo turno %lld? Um snapshot de segurança será salvo primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätt ändringar i %@ med omgång %lld? En säkerhetsögonblicksbild sparas först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่การเปลี่ยนแปลงใน %@ ด้วยรอบ %lld หรือไม่? ระบบจะบันทึก snapshot สำรองไว้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki değişiklikler tur %lld ile değiştirilsin mi? Önce bir güvenlik anlık görüntüsü kaydedilecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить изменения в %@ на ход %lld? Сначала будет сохранён резервный снимок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити зміни в %@ на хід %lld? Спершу буде збережено резервний знімок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の変更をターン %2$lld の状態に置き換えますか？先に安全スナップショットが保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 변경 사항을 %lld번째 턴으로 대체하시겠습니까? 먼저 안전 스냅샷이 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将 %@ 中的更改替换为第 %lld 轮吗？系统会先保存安全快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將 %@ 中的變更替換為第 %lld 輪嗎？系統會先儲存安全快照。"
          }
        }
      }
    },
