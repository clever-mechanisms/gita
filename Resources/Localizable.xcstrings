    "GitHub doesn’t let you approve or request changes on your own pull request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub doesn’t let you approve or request changes on your own pull request."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nedovoluje schválit vlastní pull request ani v něm žádat o změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
