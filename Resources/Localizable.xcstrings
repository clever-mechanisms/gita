    "Pause on Low Data Mode, expensive networks and Low Power Mode": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavit v režimu nízkých dat, drahých sítích a režimu nízké spotřeby"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Datensparmodus, kostenpflichtigen Netzen und Stromsparmodus pausieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause on Low Data Mode, expensive networks and Low Power Mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar en modo de datos reducidos, redes de uso medido y modo de bajo consumo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause en mode Faibles données, sur les réseaux coûteux et en mode Économie d’énergie"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetés alacsony adatforgalmi módban, költséges hálózatokon és alacsony töltöttségi módban"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospendi con Consumo ridotto di dati, reti a consumo e Risparmio energetico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省データモード、従量制ネットワーク、低電力モードでは一時停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저데이터 모드, 요금제 네트워크 및 저전력 모드에서 일시 정지"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer bij Databesparing, dure netwerken en Energiebesparingsmodus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymuj w trybie niskiego transferu, przy płatnych sieciach i w trybie niskiego zużycia energii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar no Modo de Economia de Dados, redes tarifadas e Modo de Pouca Energia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливать в режиме экономии трафика, при лимитных сетях и в режиме энергосбережения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa vid Låg data-läge, dyra nätverk och Strömsparläge"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราวในโหมดประหยัดข้อมูล เครือข่ายที่มีค่าใช้จ่ายสูง และโหมดประหยัดพลังงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Veri Modunda, maliyetli ağlarda ve Düşük Güç Modunda duraklat"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупиняти в режимі економії даних, у платних мережах і в режимі енергозбереження"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在低数据模式、按流量计费网络和低电量模式下暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在低數據模式、計費網路與低耗電模式下暫停"
          }
        }
      }
    },
