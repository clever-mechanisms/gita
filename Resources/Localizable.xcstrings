    "The result was saved but could not be staged. Your saved file is preserved. %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek byl uložen, ale nepodařilo se jej připravit k zápisu. Uložený soubor je zachován. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis wurde gesichert, konnte aber nicht gestagt werden. Deine gesicherte Datei bleibt erhalten. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result was saved but could not be staged. Your saved file is preserved. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardó el resultado, pero no se pudo preparar. El archivo guardado se conserva. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat a été enregistré, mais n’a pas pu être indexé. Votre fichier enregistré est conservé. %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredmény mentve lett, de az előkészítése sikertelen. A mentett fájl megmaradt. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato è stato salvato ma non è stato possibile prepararlo. Il file salvato è conservato. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は保存されましたがステージできませんでした。保存済みのファイルは保持されています。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 저장했지만 스테이징하지 못했습니다. 저장한 파일은 보존됩니다. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat is bewaard, maar kon niet worden klaargezet. Je bewaarde bestand blijft behouden. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik zapisano, ale nie udało się dodać go do indeksu. Zapisany plik został zachowany. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado foi salvo, mas não pôde ser preparado. O arquivo salvo foi preservado. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
