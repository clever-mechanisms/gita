    "Put the file as it is in the working tree into the result, as resolved in another editor": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložit do výsledku soubor tak, jak je v pracovním stromu, jako vyřešený v jiném editoru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei so ins Ergebnis übernehmen, wie sie im Arbeitsbaum liegt, wie in einem anderen Editor gelöst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the file as it is in the working tree into the result, as resolved in another editor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner en el resultado el archivo tal como está en el árbol de trabajo, resuelto en otro editor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer dans le résultat le fichier tel qu’il est dans l’arbre de travail, comme résolu dans un autre éditeur"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl munkapéldánybeli állapotának átvétele az eredménybe, ahogy egy másik szerkesztőben feloldották"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci nel risultato il file così com’è nell’albero di lavoro, come risolto in un altro editor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のエディタで解決したものとして、ワークツリー内のファイルをそのまま結果に入れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 편집기에서 해결한 것으로 보고 작업 트리의 파일을 그대로 결과에 넣기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het bestand zoals het in de werkboom staat in het resultaat, zoals opgelost in een andere editor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstaw do wyniku plik w postaci z drzewa roboczego, jako rozwiązany w innym edytorze"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar no resultado o arquivo como está na árvore de trabalho, como resolvido em outro editor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместить в результат файл в том виде, в каком он находится в рабочем дереве (после разрешения в другом редакторе)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg filen som den är i arbetsträdet i resultatet, som löst i en annan editor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำไฟล์ตามที่เป็นอยู่ใน working tree ใส่ในผลลัพธ์ตามที่แก้ไว้ในเอดิเตอร์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyayı, başka bir düzenleyicide çözüldüğü hâliyle çalışma kopyasından sonuca koy"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помістити файл із робочого дерева в результат без змін, як розв’язаний в іншому редакторі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将工作树中的文件原样放入结果，视为已在其他编辑器中解决"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將工作樹中的檔案原樣放入結果，視為已在其他編輯器中解決"
          }
        }
      }
    },
