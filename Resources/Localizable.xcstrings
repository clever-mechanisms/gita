          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub angav inte vilket konto som läste in den här pull requesten. Uppdatera och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ไม่ได้ระบุว่าบัญชีใดโหลด pull request นี้ ให้รีเฟรชแล้วลองอีกครั้ง"
          }
        },
        "tr": {
