    "Orca reports this agent’s state, so Gitā needs no hooks of its own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav tohoto agenta hlásí Orca, takže Gitā nepotřebuje vlastní hooky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca meldet den Zustand dieses Agenten, daher braucht Gitā keine eigenen Hooks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca reports this agent’s state, so Gitā needs no hooks of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca informa del estado de este agente, así que Gitā no necesita hooks propios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca signale l’état de cet agent : Gitā n’a pas besoin de ses propres hooks."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ügynök állapotát az Orca jelenti, így a Gitānak nincs szüksége saját hookokra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca segnala lo stato di questo agente, quindi Gitā non ha bisogno di hook propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントの状態は Orca が報告するため、Gitā 独自のフックは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca가 이 에이전트의 상태를 알려 주므로 Gitā 자체 훅이 필요하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca meldt de status van deze agent, dus Gitā heeft geen eigen hooks nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca zgłasza stan tego agenta, więc Gitā nie potrzebuje własnych hooków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Orca informa o estado deste agente, então o Gitā não precisa de hooks próprios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca сообщает состояние этого агента, поэтому Gitā не нужны собственные хуки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca rapporterar agentens tillstånd, så Gitā behöver inga egna hooks."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca รายงานสถานะของ agent นี้ Gitā จึงไม่ต้องใช้ hook ของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ajanın durumunu Orca bildirir, bu yüzden Gitā’nın kendi hook’larına gerek yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca повідомляє стан цього агента, тож Gitā не потрібні власні хуки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 会报告此代理的状态，因此 Gitā 不需要自己的钩子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca 會回報此代理的狀態，因此 Gitā 不需要自己的掛鉤。"
          }
        }
      }
    },
    "Orca returned a limited workspace page; some sessions may be missing.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca vrátila omezenou stránku pracovních prostorů; některé relace mohou chybět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca hat eine begrenzte Workspace-Seite geliefert; einige Sitzungen können fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca returned a limited workspace page; some sessions may be missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca devolvió una página limitada del espacio de trabajo; pueden faltar sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca a renvoyé une page d’espace de travail limitée ; certaines sessions peuvent manquer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Orca korlátozott munkaterületoldalt adott vissza; néhány munkamenet hiányozhat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca ha restituito una pagina dell’area di lavoro limitata; alcune sessioni potrebbero mancare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca が返したワークスペースのページは一部に限られており、セッションが欠けている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca가 제한된 작업 공간 페이지를 반환하여 일부 세션이 누락되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca gaf een beperkte werkruimtepagina; sommige sessies kunnen ontbreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca zwróciła ograniczoną stronę przestrzeni roboczej; niektórych sesji może brakować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Orca retornou uma página limitada da área de trabalho; algumas sessões podem estar ausentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca вернул ограниченную страницу рабочей области; некоторые сеансы могут отсутствовать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca returnerade en begränsad arbetsytesida; vissa sessioner kan saknas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca ส่งหน้า workspace แบบจำกัดกลับมา บาง session อาจหายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orca sınırlı bir çalışma alanı sayfası döndürdü; bazı oturumlar eksik olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
