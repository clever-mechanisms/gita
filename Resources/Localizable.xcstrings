    "Install or sign in where something is missing. Nothing changes until you press a button.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde něco chybí, nainstalujte to nebo se přihlaste. Dokud nestisknete tlačítko, nic se nezmění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere oder melde dich an, wo etwas fehlt. Nichts ändert sich, bis du auf eine Schaltfläche klickst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or sign in where something is missing. Nothing changes until you press a button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o inicia sesión donde falte algo. No cambia nada hasta que hagas clic en un botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez ou connectez-vous là où il manque quelque chose. Rien ne change tant que vous ne cliquez pas sur un bouton."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahol valami hiányzik, telepítsen vagy jelentkezzen be. Semmi sem változik, amíg meg nem nyom egy gombot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa o accedi dove manca qualcosa. Nulla cambia finché non fai clic su un pulsante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足りないものがあれば、インストールまたはサインインしてください。ボタンを押すまで何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠진 항목이 있으면 설치하거나 로그인하세요. 버튼을 누르기 전에는 아무것도 바뀌지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer of log in waar iets ontbreekt. Er verandert niets totdat je op een knop klikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj lub zaloguj się tam, gdzie czegoś brakuje. Nic się nie zmieni, dopóki nie klikniesz przycisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale ou inicie sessão onde faltar algo. Nada muda até você clicar em um botão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите недостающее или войдите в учётную запись. Ничего не изменится, пока вы не нажмёте кнопку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera eller logga in där något saknas. Inget ändras förrän du klickar på en knapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งหรือลงชื่อเข้าใช้ในส่วนที่ขาดไป จะไม่มีการเปลี่ยนแปลงจนกว่าคุณจะกดปุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik olan bir şey varsa yükleyin veya oturum açın. Bir düğmeye basana kadar hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть те, чого бракує, або ввійдіть в обліковий запис. Нічого не зміниться, доки ви не натиснете кнопку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有缺失，请安装或登录。在你按下按钮之前，不会进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如有缺少，請安裝或登入。在你按下按鈕之前，不會進行任何變更。"
          }
        }
      }
    },
