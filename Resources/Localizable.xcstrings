          "stringUnit": {
            "state": "translated",
            "value": "Виберіть і поганий, і добрий коміт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad コミットと Good コミットの両方を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁨 커밋과 좋음 커밋을 모두 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请同时选择异常提交和正常提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請同時選擇異常提交與正常提交。"
          }
        }
      }
    },
    "Choose the executable directly. Shell command strings cannot run.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the executable directly. Shell command strings cannot run."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte přímo spustitelný soubor. Řetězce příkazů shellu nelze spouštět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die ausführbare Datei direkt aus. Shell-Befehlszeilen können nicht ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el ejecutable directamente. No se pueden ejecutar cadenas de comandos de shell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez directement l’exécutable. Les chaînes de commande shell ne peuvent pas être exécutées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli direttamente l’eseguibile. Non è possibile eseguire stringhe di comandi shell."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közvetlenül a futtatható fájlt válassza ki. Parancssori karaktersorozatok nem futtathatók."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies het uitvoerbare bestand rechtstreeks. Shell-opdrachtregels kunnen niet worden uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz bezpośrednio plik wykonywalny. Ciągi poleceń powłoki nie mogą być uruchamiane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o executável diretamente. Comandos de shell em texto não podem ser executados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj den körbara filen direkt. Skalkommandosträngar kan inte köras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไฟล์เรียกใช้โดยตรง ไม่สามารถรันสตริงคำสั่ง shell ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yürütülebilir dosyayı doğrudan seçin. Kabuk komut dizeleri çalıştırılamaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сам исполняемый файл. Командные строки оболочки не поддерживаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть виконуваний файл безпосередньо. Командні рядки оболонки не підтримуються."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行可能ファイルを直接指定してください。シェルコマンド文字列は実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 파일을 직접 선택하세요. 셸 명령 문자열은 실행할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
