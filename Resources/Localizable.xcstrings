    "Merges fold away their commits until you open them, so long histories stay readable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merges fold away their commits until you open them, so long histories stay readable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučení skrývají své revize, dokud je neotevřete, takže i dlouhá historie zůstává přehledná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merges klappen ihre Commits ein, bis du sie öffnest – so bleibt auch ein langer Verlauf lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fusiones pliegan sus commits hasta que las abres, para que los historiales largos sigan siendo legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fusions replient leurs commits jusqu’à ce que vous les ouvriez : les longs historiques restent lisibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyesítések elrejtik a commitjaikat, amíg meg nem nyitja őket, így a hosszú előzmények is áttekinthetők maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I merge comprimono i loro commit finché non li apri, così le cronologie lunghe restano leggibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージは開くまでコミットを折りたたむので、長い履歴でも読みやすく保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합은 열기 전까지 커밋을 접어 두므로 긴 기록도 읽기 쉽게 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merges vouwen hun commits in totdat je ze opent, zodat lange geschiedenissen leesbaar blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalenia zwijają swoje commity, dopóki ich nie otworzysz, dzięki czemu długa historia pozostaje czytelna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesclagens recolhem seus commits até você abri-las, para que históricos longos continuem legíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слияния сворачивают свои коммиты, пока вы их не откроете, поэтому даже длинная история остаётся читаемой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagningar fäller ihop sina commits tills du öppnar dem, så att långa historiker förblir läsbara."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirmeler, siz açana kadar commitlerini katlar; böylece uzun geçmişler okunaklı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злиття згортають свої коміти, доки ви їх не відкриєте, тож навіть довга історія залишається читабельною."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并会折叠其提交，直到你将其打开，让长历史依然清晰易读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併會收合其提交，直到你將其打開，讓長歷史依然清晰易讀。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "merge จะพับ commit ไว้จนกว่าคุณจะเปิด ทำให้ประวัติยาวยังอ่านได้"
          }
        }
      }
    },
