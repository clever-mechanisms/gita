    "Choose a linear ancestor range. Merge-containing or unrelated histories cannot be edited here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte lineární rozsah předků. Historii se sloučeními nebo nesouvisející historii zde nelze upravovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen linearen Vorfahrenbereich. Verläufe mit Merges oder ohne Zusammenhang können hier nicht bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a linear ancestor range. Merge-containing or unrelated histories cannot be edited here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un intervalo lineal de antecesores. Aquí no se pueden editar historiales sin relación o con fusiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une plage linéaire d’ancêtres. Les historiques sans lien ou contenant des fusions ne sont pas modifiables ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon lineáris őstartományt. Egyesítéseket tartalmazó vagy nem kapcsolódó előzmények itt nem szerkeszthetők."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un intervallo lineare di antenati. Qui non puoi modificare cronologie non correlate o contenenti merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直線状の祖先範囲を選択してください。マージを含む履歴や無関係の履歴はここでは編集できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선형 조상 범위를 선택하세요. 병합이 포함되거나 관련 없는 기록은 여기서 편집할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een lineair bereik van voorouders. Geschiedenissen met merges of zonder onderling verband kunnen hier niet worden bewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz liniowy zakres przodków. Historii zawierającej scalenia lub niepowiązanej historii nie można tutaj edytować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um intervalo linear de ancestrais. Históricos sem relação ou com mesclagens não podem ser editados aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите линейный диапазон предков. Здесь нельзя редактировать историю со слияниями или несвязанную историю."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
