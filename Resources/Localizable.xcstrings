    "Commit or stash tracked changes before starting this operation.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zahájením této operace zapište nebo odložte sledované změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Committe oder stashe Änderungen an verfolgten Dateien vor diesem Vorgang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit or stash tracked changes before starting this operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz commit o stash de los cambios en archivos seguidos antes de iniciar esta operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un commit ou un stash des modifications suivies avant de lancer cette opération."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A művelet indítása előtt véglegesítse vagy tegye félre a követett változásokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il commit o lo stash delle modifiche tracciate prima di avviare questa operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を開始する前に、追跡対象の変更をコミットまたはスタッシュしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 시작하기 전에 추적된 변경 사항을 커밋하거나 스태시하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit of stash gevolgde wijzigingen voordat je deze bewerking start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed rozpoczęciem tej operacji zatwierdź lub odłóż śledzone zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça commit ou stash das alterações rastreadas antes de iniciar esta operação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед этой операцией закоммитьте или отложите отслеживаемые изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en commit eller stash av spårade ändringar innan du startar denna åtgärd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit หรือ stash การเปลี่ยนแปลงที่ติดตามอยู่ก่อนเริ่มการดำเนินการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işleme başlamadan önce izlenen değişikliklerle commit oluşturun veya değişiklikleri saklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед цією операцією закомітьте або відкладіть відстежувані зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始此操作前，请提交或贮藏已跟踪更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
