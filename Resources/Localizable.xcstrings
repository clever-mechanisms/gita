    "Too many provider notifications are waiting to be submitted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na odeslání čeká příliš mnoho oznámení poskytovatelů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anbieter-Mitteilungen warten auf die Übermittlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many provider notifications are waiting to be submitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas notificaciones de proveedores pendientes de envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de notifications de fournisseurs sont en attente d’envoi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok szolgáltatói értesítés vár beküldésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe notifiche dei provider sono in attesa di invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信待ちのサービス通知が多すぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출 대기 중인 서비스 알림이 너무 많습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wachten te veel providermeldingen op verzending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele powiadomień usług oczekuje na przesłanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há notificações de provedores demais aguardando envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много уведомлений провайдеров ожидают отправки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många leverantörsnotiser väntar på att skickas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการแจ้งเตือนจาก provider รอส่งมากเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilmeyi bekleyen çok fazla sağlayıcı bildirimi var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато сповіщень провайдерів очікують надсилання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
