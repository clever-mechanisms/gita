    "This diff changed. Refresh it before applying a hunk.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento rozdíl se změnil. Před použitím bloku jej obnovte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Diff hat sich geändert. Aktualisiere ihn, bevor du einen Block anwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This diff changed. Refresh it before applying a hunk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comparación cambió. Actualízala antes de aplicar un bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce diff a changé. Actualisez-le avant d’appliquer un bloc."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eltérés megváltozott. Blokk alkalmazása előtt frissítse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo diff è cambiato. Aggiornalo prima di applicare un blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この差分が変更されました。ハンクを適用する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차이가 변경되었습니다. 헝크를 적용하기 전에 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze diff is gewijzigd. Vernieuw deze voordat je een blok toepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te różnice zmieniły się. Odśwież je przed zastosowaniem fragmentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este diff mudou. Atualize-o antes de aplicar um bloco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сравнение изменилось. Обновите его перед применением фрагмента."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna diff ändrades. Uppdatera den innan du tillämpar ett block."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "diff นี้เปลี่ยนไป ให้รีเฟรชก่อนใช้ hunk"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fark gösterimi değişti. Bir fark bloğu uygulamadan önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це порівняння змінилося. Оновіть його перед застосуванням фрагмента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此差异已更改。请刷新后再应用区块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此差異已變更。請重新整理後再套用區塊。"
          }
        }
      }
    },
