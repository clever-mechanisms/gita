    "Wait for the current Git action to finish.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počkejte na dokončení aktuální akce Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die aktuelle Git-Aktion abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current Git action to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la acción de Git actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l’action Git en cours."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várja meg az aktuális Git-művelet befejezését."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il termine dell’azione Git attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の Git 操作が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Git 동작이 완료될 때까지 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige Git-actie is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącego działania Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da ação Git atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения текущего действия Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta tills den aktuella Git-åtgärden är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอให้การกระทำ Git ปัจจุบันเสร็จก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli Git eyleminin bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дочекайтеся завершення поточної дії Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前 Git 操作完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待目前 Git 操作完成。"
          }
        }
      }
    },
