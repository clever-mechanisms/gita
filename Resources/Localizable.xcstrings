    "Sends a sample from a coding agent, GitHub and Vercel, each with its mark.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle ukázku od programovacího agenta, GitHubu a Vercelu, každou s vlastním logem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet je ein Beispiel von einem Coding-Agenten, GitHub und Vercel, jeweils mit seinem Logo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a sample from a coding agent, GitHub and Vercel, each with its mark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un ejemplo de un agente de programación, de GitHub y de Vercel, cada uno con su logotipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un exemple d’un agent de programmation, de GitHub et de Vercel, chacun avec son logo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mintaértesítést küld egy kódoló ügynöktől, a GitHubtól és a Verceltől, mindegyiket a saját jelével."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un esempio da un agente di programmazione, da GitHub e da Vercel, ciascuno con il suo logo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェント、GitHub、Vercel のサンプルを、それぞれのマーク付きで送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트, GitHub, Vercel의 샘플을 각각의 마크와 함께 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt een voorbeeld van een codeeragent, GitHub en Vercel, elk met zijn eigen logo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła przykładowe powiadomienia od agenta programistycznego, GitHub i Vercel, każde z własnym logo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia uma amostra de um agente de programação, do GitHub e da Vercel, cada uma com seu logotipo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет примеры от агента для программирования, GitHub и Vercel, каждый со своим значком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar ett exempel från en kodagent, GitHub och Vercel, var och en med sin logotyp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งตัวอย่างจาก coding agent, GitHub และ Vercel พร้อมเครื่องหมายของแต่ละรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kodlama ajanından, GitHub'dan ve Vercel'den, her biri kendi simgesiyle birer örnek gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає зразки від агента програмування, GitHub і Vercel, кожен зі своїм значком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送来自编程代理、GitHub 和 Vercel 的示例通知，各带其标志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送來自程式設計代理、GitHub 和 Vercel 的範例通知，各帶其標誌。"
          }
        }
      }
    },
