          }
        }
      }
    },
    "A coding agent finishes its turn and waits for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coding agent finishes its turn and waits for you."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Programovací agent dokončí svůj tah a čeká na vás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Coding-Agent beendet seinen Zug und wartet auf dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente de programación termina su turno y te espera."
