    "Only Reword accepts a replacement message.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhradní zprávu přijímá pouze akce Upravit zprávu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Umformulieren erlaubt eine Ersatznachricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Reword accepts a replacement message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Reformular admite un mensaje de sustitución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Reformuler accepte un message de remplacement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyettesítő üzenetet csak az Üzenet átírása művelet fogad el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Riscrivi accetta un messaggio sostitutivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置換メッセージを指定できるのは「メッセージ変更」のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 메시지는 '메시지 변경'에서만 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen Herformuleer accepteert een vervangend bericht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko Zmień komunikat przyjmuje nowy komunikat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente Reformular aceita uma mensagem de substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новое сообщение допустимо только для действия «Изменить сообщение»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast Ändra meddelande accepterar ett ersättningsmeddelande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะ Reword เท่านั้นที่รับข้อความแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca İletiyi değiştir eylemi yeni ileti kabul eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нове повідомлення допустиме лише для дії «Змінити повідомлення»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有“改写消息”接受替换消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有「改寫訊息」接受替換訊息。"
          }
        }
      }
    },
