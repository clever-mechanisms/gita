    },
    "The following worktree and branch will be permanently deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following worktree and branch will be permanently deleted."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Následující pracovní strom a větev budou trvale smazány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der folgende Worktree und Branch werden endgültig gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente el siguiente árbol de trabajo y la siguiente rama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arbre de travail et la branche suivants seront définitivement supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seguente albero di lavoro e il relativo ramo verranno eliminati definitivamente."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő munkafa és ág véglegesen törlődik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende worktree en branch worden definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następujące drzewo robocze i gałąź zostaną trwale usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A árvore de trabalho e a branch a seguir serão excluídas permanentemente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följande worktree och gren kommer att raderas permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "worktree และ branch ต่อไปนี้จะถูกลบอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki çalışma ağacı ve dal kalıcı olarak silinecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующие рабочее дерево и ветка будут безвозвратно удалены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведені нижче робоче дерево та гілку буде видалено назавжди."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のワークツリーとブランチは完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 작업 트리와 브랜치가 영구적으로 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下工作树和分支将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下工作樹和分支將被永久刪除。"
          }
        }
      }
    },
    "The following worktrees and branches will be permanently deleted.": {
