    "Arguments and paths cannot contain invalid characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments and paths cannot contain invalid characters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenty a cesty nesmí obsahovat neplatné znaky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumente und Pfade dürfen keine ungültigen Zeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos y las rutas no pueden contener caracteres no válidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arguments et les chemins ne peuvent pas contenir de caractères non valides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti e i percorsi non possono contenere caratteri non validi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az argumentumok és útvonalak nem tartalmazhatnak érvénytelen karaktereket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenten en paden mogen geen ongeldige tekens bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenty i ścieżki nie mogą zawierać nieprawidłowych znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumentos e caminhos não podem conter caracteres inválidos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Argument och sökvägar får inte innehålla ogiltiga tecken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาร์กิวเมนต์และพาธต้องไม่มีอักขระที่ไม่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argümanlar ve yollar geçersiz karakter içeremez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы и пути не могут содержать недопустимые символы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументи та шляхи не можуть містити неприпустимі символи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引数やパスに無効な文字を含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인수와 경로에는 유효하지 않은 문자를 포함할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数和路径不能包含无效字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引數和路徑不能包含無效字元。"
          }
        }
      }
    },
    "Asks each remote which branch tips moved (git ls-remote). Downloads nothing and writes nothing to your repositories.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotáže se každého vzdáleného repozitáře, které špičky větví se posunuly (git ls-remote). Nic nestahuje ani do repozitářů nezapisuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt jedes Remote, welche Branch-Spitzen sich bewegt haben (git ls-remote). Lädt nichts herunter und schreibt nichts in deine Repositories."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks each remote which branch tips moved (git ls-remote). Downloads nothing and writes nothing to your repositories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta a cada remoto qué puntas de rama se movieron (git ls-remote). No descarga nada ni escribe nada en tus repositorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à chaque dépôt distant quelles pointes de branche ont bougé (git ls-remote). Ne télécharge rien et n’écrit rien dans vos dépôts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megkérdezi minden távoli tárolótól, mely ágvégek mozdultak el (git ls-remote). Nem tölt le semmit, és nem ír semmit a tárolókba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede a ciascun remoto quali estremità dei rami si sono spostate (git ls-remote). Non scarica nulla e non scrive nulla nei tuoi repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リモートにどのブランチの先端が移動したかを問い合わせます（git ls-remote）。ダウンロードもリポジトリへの書き込みも行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 원격에 브랜치 끝이 이동했는지 확인합니다(git ls-remote). 아무것도 다운로드하지 않으며 저장소에 아무것도 쓰지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt elke remote welke branchuiteinden zijn verplaatst (git ls-remote). Downloadt niets en schrijft niets naar je repositories."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta każde zdalne repozytorium, które końcówki gałęzi się przesunęły (git ls-remote). Niczego nie pobiera i niczego nie zapisuje w repozytoriach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cada remoto para saber quais pontas de branch mudaram (git ls-remote). Não baixa nada nem grava nada nos seus repositórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает у каждого удалённого репозитория, какие вершины веток переместились (git ls-remote). Ничего не скачивает и не записывает в ваши репозитории."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågar varje fjärrarkiv vilka grenspetsar som flyttats (git ls-remote). Hämtar inget och skriver inget till dina kodförråd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สอบถามแต่ละ remote ว่าปลาย branch ใดเลื่อน (git ls-remote) โดยไม่ดาวน์โหลดและไม่เขียนข้อมูลลงใน repository ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uzak depoya hangi dal uçlarının taşındığını sorar (git ls-remote). Depolarınıza hiçbir şey indirmez ve yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує в кожного віддаленого репозиторію, які вершини гілок перемістилися (git ls-remote). Нічого не завантажує і не записує у ваші репозиторії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向每个远程查询哪些分支末端已移动（git ls-remote）。不会下载任何内容，也不会向仓库写入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向每個遠端查詢哪些分支末端已移動（git ls-remote）。不會下載任何內容，也不會寫入您的版本庫。"
          }
        }
      }
    },
