    "Git could not remove the local remote configuration. Reload the configuration and tracking references.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git could not remove the local remote configuration. Reload the configuration and tracking references."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nemohl odstranit místní konfiguraci vzdáleného repozitáře. Načtěte konfiguraci a sledovací reference znovu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git no pudo eliminar la configuración local del remoto. Vuelve a cargar la configuración y las referencias de seguimiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git konnte die lokale Remote-Konfiguration nicht entfernen. Lade Konfiguration und Tracking-Referenzen neu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git nem tudta eltávolítani a távoli tároló helyi beállításait. Töltse újra a beállításokat és a követési hivatkozásokat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git n’a pas pu supprimer la configuration locale du dépôt distant. Rechargez la configuration et les références de suivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git はローカルのリモート設定を削除できませんでした。設定と追跡参照を再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git이 로컬 원격 구성을 제거하지 못했습니다. 구성 및 추적 참조를 다시 로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 无法移除本地远程配置。请重新载入配置和跟踪引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 無法移除本機遠端設定。請重新載入設定和追蹤參照。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git non ha potuto rimuovere la configurazione locale del remoto. Ricarica la configurazione e i riferimenti di tracciamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nie może usunąć lokalnej konfiguracji zdalnego repozytorium. Wczytaj ponownie konfigurację i referencje śledzące."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kon de lokale remoteconfiguratie niet verwijderen. Laad de configuratie en trackingreferenties opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git não pôde remover a configuração local do remoto. Recarregue a configuração e as referências de rastreamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git yerel uzak depo yapılandırmasını kaldıramadı. Yapılandırmayı ve izleme referanslarını yeniden yükleyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kunde inte ta bort den lokala fjärrarkivskonfigurationen. Läs in konfigurationen och spårningsreferenserna igen."
          }
        },
        "ru": {
          "stringUnit": {
