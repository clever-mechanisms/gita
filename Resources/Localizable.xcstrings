    "An incomplete Git sequence is active. Finish it with Git before starting another operation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An incomplete Git sequence is active. Finish it with Git before starting another operation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá neúplná posloupnost Gitu. Před zahájením jiné operace ji dokončete pomocí Gitu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una secuencia de Git incompleta activa. Termínala con Git antes de iniciar otra operación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unvollständige Git-Sequenz ist aktiv. Beende sie mit Git, bevor du einen weiteren Vorgang startest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiányos Git-műveletsor van folyamatban. Másik művelet indítása előtt fejezze be a Gittel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séquence Git incomplète est active. Terminez-la avec Git avant de lancer une autre opération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了の Git シーケンスがあります。別の操作を始める前に Git で完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되지 않은 Git 시퀀스가 실행 중입니다. 다른 작업을 시작하기 전에 Git으로 완료하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的 Git 操作序列。请先使用 Git 完成，再开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的 Git 操作序列。請先使用 Git 完成，再開始其他操作。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una sequenza Git incompleta. Terminala con Git prima di avviare un’altra operazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa niepełna sekwencja Gitā. Zakończ ją w Gicie przed rozpoczęciem innej operacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een onvolledige Git-reeks actief. Voltooi deze met Git voordat je een andere bewerking start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma sequência Git incompleta ativa. Conclua-a com o Git antes de iniciar outra operação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanmamış bir Git dizisi etkin. Başka bir işlem başlatmadan önce Git ile tamamlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ofullständig Git-sekvens är aktiv. Slutför den med Git innan du startar en annan åtgärd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть незавершённая последовательность Git. Завершите её средствами Git перед новой операцией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є незавершена послідовність Git. Завершіть її засобами Git перед новою операцією."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีลำดับคำสั่ง Git ที่ยังทำไม่เสร็จอยู่ ให้ทำให้เสร็จด้วย Git ก่อนเริ่มการดำเนินการอื่น"
          }
        }
      }
    },
    "An unsupported Git sequence is active. Finish it with Git before starting another operation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unsupported Git sequence is active. Finish it with Git before starting another operation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá nepodporovaná posloupnost Gitu. Před zahájením jiné operace ji dokončete pomocí Gitu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una secuencia de Git no compatible activa. Termínala con Git antes de iniciar otra operación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine nicht unterstützte Git-Sequenz ist aktiv. Beende sie mit Git, bevor du einen weiteren Vorgang startest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem támogatott Git-műveletsor van folyamatban. Másik művelet indítása előtt fejezze be a Gittel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une séquence Git non prise en charge est active. Terminez-la avec Git avant de lancer une autre opération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応の Git シーケンスが実行中です。別の操作を始める前に Git で完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 Git 시퀀스가 실행 중입니다. 다른 작업을 시작하기 전에 Git으로 완료하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有不支持的 Git 操作序列正在进行。请先使用 Git 完成，再开始其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有不支援的 Git 操作序列正在進行。請先使用 Git 完成，再開始其他操作。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attiva una sequenza Git non supportata. Terminala con Git prima di avviare un’altra operazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa nieobsługiwana sekwencja Gitā. Zakończ ją w Gicie przed rozpoczęciem innej operacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een niet-ondersteunde Git-reeks actief. Voltooi deze met Git voordat je een andere bewerking start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma sequência Git incompatível ativa. Conclua-a com o Git antes de iniciar outra operação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmeyen bir Git dizisi etkin. Başka bir işlem başlatmadan önce Git ile tamamlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En Git-sekvens som inte stöds är aktiv. Slutför den med Git innan du startar en annan åtgärd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть неподдерживаемая последовательность Git. Завершите её средствами Git перед новой операцией."
          }
        },
        "uk": {
