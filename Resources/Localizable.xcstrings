            "state": "translated",
            "value": "심볼릭 링크가 너무 커서 검토할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De symbolische koppeling is te groot om te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel dowiązania symbolicznego jest zbyt duży, aby go sprawdzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link simbólico é muito grande para revisar."
          }
        },
        "ru": {
