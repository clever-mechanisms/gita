    "Remote URL is refused by policy (plain HTTP is not allowed).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL vzdáleného repozitáře byla zásadami odmítnuta (prosté HTTP není povoleno)."
          }
        },
        "de": {
          "stringUnit": {
