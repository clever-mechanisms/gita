          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szolgáltatói elem azonosítója érvénytelen. Frissítse a listát, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identità dell’elemento del provider non è valida. Aggiorna il suo elenco e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービス項目の識別情報が無効です。一覧を更新して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 항목의 식별 정보가 잘못되었습니다. 목록을 새로 고치고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het provideritem heeft een ongeldige identiteit. Vernieuw de lijst en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element usługi ma nieprawidłowy identyfikator. Odśwież jego listę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item do provedor tem uma identidade inválida. Atualize a lista e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор элемента провайдера недопустим. Обновите список и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantörsobjektet har en ogiltig identitet. Uppdatera listan och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการจาก provider มีตัวตนที่ไม่ถูกต้อง ให้รีเฟรชรายการแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
