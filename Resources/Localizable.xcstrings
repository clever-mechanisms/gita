            "state": "translated",
            "value": "Bu dalı silmek commitlerin kaybolmasına yol açabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление этой ветки может привести к потере коммитов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення цієї гілки може призвести до втрати комітів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチを削除するとコミットが失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치를 삭제하면 커밋이 손실될 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此分支可能会丢弃提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此分支可能會捨棄提交。"
          }
        }
      }
    },
    "Dense, zoomable history with search, filters and lazy commit trees.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hutná historie s přibližováním, hledáním, filtry a stromy revizí načítanými na vyžádání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakter, zoombarer Verlauf mit Suche, Filtern und bei Bedarf geladenen Commit-Bäumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dense, zoomable history with search, filters and lazy commit trees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial compacto y ampliable con búsqueda, filtros y árboles de commits que se cargan bajo demanda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique dense et zoomable, avec recherche, filtres et arbres de commits chargés à la demande."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tömör, nagyítható előzmények kereséssel, szűrőkkel és igény szerint betöltődő commitfákkal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia compatta e zoomabile con ricerca, filtri e alberi dei commit caricati su richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索、フィルタ、必要時に読み込むコミットツリーを備えた、高密度で拡大縮小できる履歴。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색, 필터, 필요할 때 불러오는 커밋 트리를 갖춘 촘촘하고 확대/축소 가능한 기록."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacte, zoombare geschiedenis met zoeken, filters en commitbomen die op aanvraag laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwarta historia z powiększaniem, wyszukiwaniem, filtrami i drzewami commitów wczytywanymi na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico compacto e ampliável, com busca, filtros e árvores de commits carregadas sob demanda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плотная масштабируемая история с поиском, фильтрами и деревьями коммитов, загружаемыми по требованию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt, zoombar historik med sökning, filter och committräd som läses in vid behov."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติที่แน่นและซูมได้ พร้อมการค้นหา ตัวกรอง และ tree ของ commit ที่โหลดเมื่อต้องใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama, filtreler ve gerektiğinde yüklenen commit ağaçlarıyla yoğun, yakınlaştırılabilir geçmiş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щільна історія з масштабуванням, пошуком, фільтрами й деревами комітів, що завантажуються на вимогу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑、可缩放的历史，支持搜索、筛选和按需加载的提交树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "緊湊、可縮放的歷史，支援搜尋、篩選和按需載入的提交樹。"
          }
        }
      }
    },
