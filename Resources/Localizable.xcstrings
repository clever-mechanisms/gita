    "Keep staged and working changes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovat připravené i pracovní změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestagte und Arbeitsänderungen behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep staged and working changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar los cambios preparados y de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les modifications indexées et de travail."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előkészített és munkapéldánybeli változások megtartása."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le modifiche preparate e di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ済みの変更と作業中の変更を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징된 변경과 작업 중인 변경을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud klaargezette en werkwijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj zmiany w indeksie i kopii roboczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter alterações preparadas e de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить изменения в индексе и рабочем дереве."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll förberedda ändringar och arbetsändringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บการเปลี่ยนแปลงที่ staged และใน working tree ไว้"
