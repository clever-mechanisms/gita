    "Keep staged and working changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep staged and working changes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovat připravené i pracovní změny."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar los cambios preparados y de trabajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestagte und Arbeitsänderungen behalten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előkészített és munkapéldánybeli változások megtartása."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les modifications indexées et de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ済みの変更と作業中の変更を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징된 변경과 작업 중인 변경을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已暂存更改和工作区更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已暫存變更和工作區變更。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le modifiche preparate e di lavoro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj zmiany w indeksie i kopii roboczej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud klaargezette en werkwijzigingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter alterações preparadas e de trabalho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlanan değişiklikleri ve çalışma değişikliklerini koru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll förberedda ändringar och arbetsändringar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить изменения в индексе и рабочем дереве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти зміни в індексі та робочому дереві."
          }
        },
        "th": {
