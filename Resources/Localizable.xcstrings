    "Open at Login is unavailable for this copy of Gitā. Use the installed app in Applications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevírání po přihlášení není pro tuto kopii Gitā dostupné. Použijte nainstalovanou aplikaci ve složce Aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Beim Anmelden öffnen“ ist für diese Kopie von Gitā nicht verfügbar. Verwende die installierte App im Ordner Programme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login is unavailable for this copy of Gitā. Use the installed app in Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión no está disponible para esta copia de Gitā. Usa la app instalada en Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouverture à l’ouverture de session n’est pas disponible pour cette copie de Gitā. Utilisez l’app installée dans Applications."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā e példányánál nem érhető el a bejelentkezéskori megnyitás. Használja az Alkalmazások mappába telepített alkalmazást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri al login non è disponibile per questa copia di Gitā. Usa l’app installata in Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Gitā では「ログイン時に開く」を利用できません。アプリケーションフォルダのインストール済みアプリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Gitā 복사본에서는 '로그인 시 열기'를 사용할 수 없습니다. 응용 프로그램 폴더에 설치된 앱을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open bij inloggen is niet beschikbaar voor deze kopie van Gitā. Gebruik de geïnstalleerde app in Apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieranie podczas logowania jest niedostępne dla tej kopii Gitā. Użyj zainstalowanej aplikacji w folderze Aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ao Iniciar Sessão não está disponível para esta cópia do Gitā. Use o app instalado em Aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытие при входе недоступно для этой копии Gitā. Используйте установленное приложение из папки «Программы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
