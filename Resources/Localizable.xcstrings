            "value": "File exceeds the structured diff size limit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor překračuje limit velikosti pro strukturované porovnání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei überschreitet das Größenlimit für strukturierte Diffs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo supera el límite de tamaño de la comparación estructurada."
          }
