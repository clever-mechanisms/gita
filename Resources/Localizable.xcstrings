        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 업스트림에 있는 커밋을 수정할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een commit aanpassen die al op de upstream staat?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawić commit, który jest już w gałęzi śledzonej?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emendar um commit que já está no upstream?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправить коммит, который уже есть в отслеживаемой ветке?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra en commit som redan finns uppströms?"
