    },
    "The repository changed while preparing the reset review. Reload it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Repozitář se během přípravy kontroly resetu změnil. Načtěte jej znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository hat sich beim Vorbereiten der Reset-Prüfung geändert. Lade sie neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository changed while preparing the reset review. Reload it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio cambió al preparar la revisión del reset. Vuelve a cargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt a changé pendant la préparation de l’examen du reset. Rechargez-le."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tároló megváltozott a visszaállítási áttekintés előkészítése közben. Töltse újra."
          }
        },
        "it": {
