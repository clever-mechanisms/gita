        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 브랜치에서 묶을 연속된 비병합 커밋을 선택하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer opeenvolgende niet-mergecommits op de huidige branch om te squashen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
