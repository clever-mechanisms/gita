        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kon de lokale remoteconfiguratie niet verwijderen. Laad de configuratie en trackingreferenties opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nie może usunąć lokalnej konfiguracji zdalnego repozytorium. Wczytaj ponownie konfigurację i referencje śledzące."
          }
        },
        "pt-BR": {
          "stringUnit": {
