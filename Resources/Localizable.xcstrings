    "Return to the state before this operation. Uncommitted changes made during it may be discarded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit stav před touto operací. Nezapsané změny provedené během ní mohou být zahozeny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zustand vor diesem Vorgang zurückkehren. Währenddessen vorgenommene Änderungen ohne Commit können verworfen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the state before this operation. Uncommitted changes made during it may be discarded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver al estado anterior a esta operación. Los cambios sin commit realizados durante ella podrían descartarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à l’état précédant cette opération. Les modifications sans commit effectuées pendant celle-ci peuvent être abandonnées."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszatérés a művelet előtti állapothoz. A művelet közben létrehozott, nem véglegesített változások elveszhetnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna allo stato precedente all’operazione. Le modifiche senza commit apportate durante l’operazione potrebbero essere scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作の前の状態に戻します。操作中に行った未コミットの変更は破棄される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 이전 상태로 돌아갑니다. 작업 중에 만든 커밋되지 않은 변경 사항은 버려질 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keer terug naar de staat vóór deze bewerking. Niet-gecommitte wijzigingen die tijdens de bewerking zijn gemaakt, kunnen worden verworpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć do stanu sprzed tej operacji. Zmiany wprowadzone w jej trakcie i niezapisane w commitach mogą zostać odrzucone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar ao estado anterior à operação. Alterações sem commit feitas durante ela podem ser descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться к состоянию до этой операции. Незакоммиченные изменения, сделанные во время неё, могут быть отброшены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återgå till tillståndet före denna åtgärd. Ändringar utan commit som gjorts under åtgärden kan kastas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับไปยังสถานะก่อนการดำเนินการนี้ การเปลี่ยนแปลงที่ยังไม่ commit ระหว่างนั้นอาจถูกทิ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlemden önceki duruma dönün. İşlem sırasında yapılan ve commit oluşturulmamış değişiklikler atılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернутися до стану перед цією операцією. Незакомічені зміни, зроблені під час неї, може бути відкинуто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回此操作之前的状态。操作期间所做的未提交更改可能被丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回此操作之前的狀態。操作期間所做的未提交變更可能被捨棄。"
          }
        }
      }
    },
