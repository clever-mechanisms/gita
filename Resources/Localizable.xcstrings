            "state": "translated",
            "value": "Запрос на слияние изменился после загрузки. Обновите и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requesten har ändrats sedan den lästes in. Uppdatera och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pull request เปลี่ยนไปตั้งแต่โหลด ให้รีเฟรชแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirme isteği yüklendikten sonra değişti. Yenileyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит на злиття змінився після завантаження. Оновіть і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取请求在载入后已更改。请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提取要求在載入後已變更。請重新整理後再試一次。"
          }
        }
      }
    },
    "The pull request hasn’t loaded.": {
      "localizations": {
        "cs": {
