    "Quitting now will cancel the active race and clean up its temporary worktrees.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting now will cancel the active race and clean up its temporary worktrees."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukončením nyní zrušíte aktivní závod a vyčistíte jeho dočasné pracovní stromy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt beendest, wird das laufende Rennen abgebrochen und seine temporären Worktrees werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir ahora cancelará la competición activa y limpiará sus worktrees temporales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter maintenant annulera la course en cours et supprimera ses worktrees temporaires."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kilépés megszakítja az aktív versenyt, és eltávolítja az ideiglenes munkafáit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire ora annullerà il confronto attivo e rimuoverà i suoi worktree temporanei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ終了すると、実行中のレースが中止され、一時ワークツリーが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 종료하면 진행 중인 레이스가 취소되고 임시 워크트리가 정리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu stoppen annuleert de actieve race en ruimt de tijdelijke worktrees op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończenie teraz anuluje aktywny wyścig i usunie jego tymczasowe drzewa robocze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair agora cancelará a corrida ativa e limpará suas worktrees temporárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход сейчас отменит активное состязание и удалит его временные рабочие деревья."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att avsluta nu avbryter den aktiva tävlingen och rensar dess tillfälliga arbetskataloger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกตอนนี้จะยกเลิกการประลองที่กำลังทำงานอยู่และลบ worktree ชั่วคราวออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi çıkmak etkin yarışı iptal eder ve geçici çalışma ağaçlarını temizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід зараз скасує активні перегони та очистить їхні тимчасові робочі дерева."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出将取消正在进行的竞速并清理其临时工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在結束將取消進行中的競速並清理其暫存工作樹。"
          }
        }
      }
    },
