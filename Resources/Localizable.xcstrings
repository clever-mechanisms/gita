    "Some details are unavailable or extend beyond the first 50 entries. Open the pull request for the full view.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some details are unavailable or extend beyond the first 50 entries. Open the pull request for the full view."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé podrobnosti nejsou dostupné nebo přesahují prvních 50 položek. Úplný přehled získáte otevřením žádosti o začlenění."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos detalles no están disponibles o superan las primeras 50 entradas. Abre la pull request para ver todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Details sind nicht verfügbar oder liegen nach den ersten 50 Einträgen. Öffne den Pull Request für die vollständige Ansicht."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes részletek nem érhetők el, vagy túlnyúlnak az első 50 bejegyzésen. A teljes nézethez nyissa meg a beolvasztási kérelmet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains détails sont indisponibles ou dépassent les 50 premières entrées. Ouvrez la pull request pour la vue complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の詳細が取得できないか、最初の50件を超えています。全体はプルリクエストを開いて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 상세 정보를 사용할 수 없거나 처음 50개 항목 범위를 벗어납니다. 전체 내용은 풀 리퀘스트를 열어 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分详情不可用或超出前 50 个条目。请打开拉取请求查看全部内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分詳細資訊無法使用或超過前 50 個項目。請打開提取要求檢視全部內容。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni dettagli non sono disponibili o superano le prime 50 voci. Apri la pull request per la vista completa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre szczegóły są niedostępne lub wykraczają poza pierwszych 50 wpisów. Otwórz pull request, aby zobaczyć całość."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige details zijn niet beschikbaar of vallen buiten de eerste 50 items. Open de pullrequest voor de volledige weergave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns detalhes estão indisponíveis ou ultrapassam as primeiras 50 entradas. Abra o pull request para a visualização completa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı ayrıntılar kullanılamıyor veya ilk 50 girdinin dışında. Tam görünüm için birleştirme isteğini açın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa detaljer är inte tillgängliga eller finns efter de första 50 posterna. Öppna pull requesten för hela vyn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые сведения недоступны или не входят в первые 50 записей. Откройте запрос на слияние для полного просмотра."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі відомості недоступні або не входять до перших 50 записів. Відкрийте запит на злиття для повного перегляду."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดบางส่วนใช้ไม่ได้หรือเกิน 50 รายการแรก เปิด pull request เพื่อดูทั้งหมด"
          }
        }
      }
    },
    "Some pull request metadata is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some pull request metadata is unavailable."
          }
        },
        "cs": {
