    "Nothing to join, so main just moves up to origin/main.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co spojovat, takže se main jen posune na origin/main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu verbinden, daher rückt main einfach auf origin/main vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to join, so main just moves up to origin/main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que unir, así que main simplemente avanza hasta origin/main."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à réunir : main avance simplement jusqu’à origin/main."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs mit összekötni, ezért a main egyszerűen előrelép az origin/main-re."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da unire, quindi main avanza semplicemente fino a origin/main."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結合するものがないため、main は origin/main まで進むだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합칠 것이 없으므로 main이 origin/main으로 앞으로 이동하기만 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets samen te voegen, dus main schuift gewoon op naar origin/main."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma czego łączyć, więc main po prostu przesuwa się do origin/main."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a unir, então main apenas avança até origin/main."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединять нечего, поэтому main просто передвигается к origin/main."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att förena, så main flyttas bara fram till origin/main."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรต้องรวม main จึงเลื่อนขึ้นไปที่ origin/main"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirilecek bir şey yok, bu yüzden main yalnızca origin/main konumuna ilerler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема чого об’єднувати, тож main просто пересувається до origin/main."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需合并，因此 main 直接前移到 origin/main。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需合併，因此 main 直接前移到 origin/main。"
          }
        }
      }
    },
    "Nothing to replay, so main just moves up to origin/main.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co znovu použít, takže se main jen posune na origin/main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
