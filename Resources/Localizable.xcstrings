          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активен пользовательский хук: %@. Gitā не перезапишет его без подтверждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний власний хук: %@. Gitā не перезапише його без підтвердження."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムフックが有効です: %@。Gitā は確認なしに上書きしません。"
