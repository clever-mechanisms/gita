            "value": "GitHub потребує коментаря для цієї рецензії."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレビューには GitHub でコメントが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 검토에는 GitHub에서 댓글이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 要求此审查附带评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 要求此審查附上留言。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ต้องมีความคิดเห็นสำหรับรีวิวนี้"
          }
        }
      }
    },
    "GitHub returned jobs that could not be verified for this run attempt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returned jobs that could not be verified for this run attempt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub vrátil úlohy, které nebylo možné ověřit pro tento pokus běhu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub devolvió trabajos que no se pudieron verificar para este intento de ejecución."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat Jobs geliefert, die für diesen Ausführungsversuch nicht verifiziert werden konnten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub olyan feladatokat adott vissza, amelyek nem ellenőrizhetők ehhez a futtatási kísérlethez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a renvoyé des tâches qui n’ont pas pu être vérifiées pour cette tentative d’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub が返したジョブをこの実行試行のものとして検証できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 반환한 작업이 이 실행 시도에 해당하는지 검증하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 GitHub 返回的作业是否属于此次运行尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 GitHub 傳回的作業是否屬於此次執行嘗試。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ha restituito processi che non è stato possibile verificare per questo tentativo di esecuzione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub zwrócił zadania, których nie można zweryfikować dla tej próby uruchomienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub gaf jobs die niet konden worden geverifieerd voor deze uitvoeringspoging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub retornou trabalhos que não puderam ser verificados para esta tentativa de execução."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub bu çalıştırma denemesi için doğrulanamayan işler döndürdü."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub returnerade jobb som inte kunde verifieras för detta körningsförsök."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub вернул задания, которые не удалось подтвердить для этой попытки запуска."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub повернув завдання, які не вдалося підтвердити для цієї спроби запуску."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ส่ง job ที่ตรวจสอบไม่ได้สำหรับการทำงานครั้งนี้กลับมา"
          }
        }
      }
    },
