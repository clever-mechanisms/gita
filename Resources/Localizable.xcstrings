    "Apply every change that conflicts with nothing, from both sides": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít všechny změny bez konfliktu z obou stran"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede konfliktfreie Änderung beider Seiten anwenden"
