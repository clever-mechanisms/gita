            "state": "translated",
            "value": "The message, files and checks under the history. ⌘D"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje, los archivos y las comprobaciones bajo el historial. ⌘D"
