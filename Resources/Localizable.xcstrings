            "state": "translated",
            "value": "Il commit richiede modifiche preparate e un messaggio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit wymaga zmian w indeksie i komunikatu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een commit vereist klaargezette wijzigingen en een bericht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O commit precisa de alterações preparadas e uma mensagem"
