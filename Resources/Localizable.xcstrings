    "Sizes use APFS allocated blocks. Cleaned folders move to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizes use APFS allocated blocks. Cleaned folders move to Trash."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikosti vycházejí z přidělených bloků APFS. Vyčištěné složky se přesunou do koše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größen basieren auf zugewiesenen APFS-Blöcken. Bereinigte Ordner wandern in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños usan bloques asignados de APFS. Las carpetas limpiadas van a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tailles utilisent les blocs alloués APFS. Les dossiers nettoyés vont dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dimensioni usano i blocchi APFS allocati. Le cartelle pulite vanno nel Cestino."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A méretek az APFS lefoglalt blokkjait mutatják. A tisztított mappák a Kukába kerülnek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groottes gebruiken toegewezen APFS-blokken. Opgeschoonde mappen gaan naar de prullenmand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiary opierają się na przydzielonych blokach APFS. Wyczyszczone foldery trafiają do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tamanhos usam blocos alocados do APFS. As pastas limpas vão para o Lixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Storlekar använder allokerade APFS-block. Rensade mappar flyttas till papperskorgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดคำนวณจากบล็อกที่จัดสรรบน APFS โฟลเดอร์ที่ล้างจะถูกย้ายไปยังถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutlar ayrılmış APFS bloklarını kullanır. Temizlenen klasörler Çöp Sepeti’ne taşınır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размеры указаны по выделенным блокам APFS. Очищенные папки перемещаются в Корзину."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розміри вказано за виділеними блоками APFS. Очищені теки переміщуються у Смітник."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズは APFS の割り当てブロック基準です。クリーンされたフォルダはゴミ箱に移動されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기는 APFS 할당 블록 기준이며 정리된 폴더는 휴지통으로 이동됩니다."
