    "Merge stops and nothing changes, since main has commits search lacks.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučení se zastaví a nic se nezmění, protože main má revize, které search nemá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zusammenführen stoppt und nichts ändert sich, da main Commits hat, die search fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge stops and nothing changes, since main has commits search lacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusión se detiene y no cambia nada, porque main tiene commits que search no tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion s’arrête et rien ne change, car main a des commits absents de search."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyesítés leáll, és semmi sem változik, mivel a main olyan commitokat tartalmaz, amelyek a search ágból hiányoznak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il merge si ferma e nulla cambia, perché main ha commit che search non ha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "main に search にないコミットがあるため、マージは停止し、何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "main에 search에 없는 커밋이 있으므로 병합이 중단되고 아무것도 바뀌지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen stopt en er verandert niets, omdat main commits heeft die search mist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalanie zatrzymuje się i nic się nie zmienia, ponieważ main ma commity, których brakuje w search."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesclagem para e nada muda, pois main tem commits que search não tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слияние останавливается, и ничего не меняется: в main есть коммиты, которых нет в search."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagningen stoppar och inget ändras, eftersom main har commits som search saknar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "merge จะหยุดและไม่มีการเปลี่ยนแปลง เพราะ main มี commit ที่ search ไม่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "main dalında search dalında olmayan commitler olduğu için birleştirme durur ve hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливання зупиняється й нічого не змінюється, бо в main є коміти, яких немає в search."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并将停止且不做任何更改，因为 main 有 search 所没有的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併將停止且不做任何變更，因為 main 有 search 所沒有的提交。"
          }
        }
      }
    },
