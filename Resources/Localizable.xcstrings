          "stringUnit": {
            "state": "translated",
            "value": "Git no pudo renombrar el remoto. Vuelve a cargar la configuración y las referencias de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git n’a pas pu renommer le dépôt distant. Rechargez la configuration et les références de suivi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git nem tudta átnevezni a távoli tárolót. Töltse újra a beállításokat és a követési hivatkozásokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git non ha potuto rinominare il remoto. Ricarica la configurazione e i riferimenti di tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git はリモート名を変更できませんでした。設定と追跡参照を再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git이 원격 이름을 변경하지 못했습니다. 구성 및 추적 참조를 다시 로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kon de remote niet hernoemen. Laad de configuratie en trackingreferenties opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nie może zmienić nazwy zdalnego repozytorium. Wczytaj ponownie konfigurację i referencje śledzące."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git não pôde renomear o remoto. Recarregue a configuração e as referências de rastreamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не удалось переименовать удалённый репозиторий. Перезагрузите конфигурацию и ссылки отслеживания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kunde inte byta namn på fjärrarkivet. Läs in konfigurationen och spårningsreferenserna igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git เปลี่ยนชื่อ remote ไม่ได้ ให้โหลดการตั้งค่าและ tracking reference ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git uzak deponun adını değiştiremedi. Yapılandırmayı ve izleme referanslarını yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не вдалося перейменувати віддалений репозиторій. Перезавантажте конфігурацію та посилання відстеження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 无法重命名远程仓库。请重新载入配置和跟踪引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 無法重新命名遠端版本庫。請重新載入設定和追蹤參照。"
          }
        }
      }
    },
