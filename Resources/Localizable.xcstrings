          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーのメタデータが変更されました。リポジトリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 트리 메타데이터가 변경되었습니다. 저장소를 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
