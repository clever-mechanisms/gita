    "See which agent works where, and which one waits for you, next to its branch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U každé větve uvidíte, který agent kde pracuje a který na vás čeká."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh neben jedem Branch, welcher Agent wo arbeitet und welcher auf dich wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which agent works where, and which one waits for you, next to its branch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué agente trabaja dónde y cuál te espera, junto a su rama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez quel agent travaille où, et lequel vous attend, à côté de sa branche."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lássa az águk mellett, melyik ügynök hol dolgozik, és melyik vár Önre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri quale agente lavora dove e quale ti aspetta, accanto al suo ramo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのエージェントがどこで作業しているか、どれがあなたを待っているかを、ブランチの横で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 에이전트가 어디서 작업 중이고 어떤 에이전트가 기다리고 있는지 브랜치 옆에서 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie naast de branch welke agent waar werkt en welke op je wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz obok gałęzi, który agent gdzie pracuje i który na Ciebie czeka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja qual agente trabalha onde, e qual está esperando por você, ao lado da branch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите рядом с веткой, какой агент где работает и какой ждёт вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bredvid grenen vilken agent som arbetar var och vilken som väntar på dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่า agent ไหนทำงานที่ไหน และตัวไหนรอคุณ อยู่ถัดจาก branch ของมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi ajanın nerede çalıştığını ve hangisinin sizi beklediğini dalının yanında görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивіться поруч із гілкою, який агент де працює і який чекає на вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在分支旁查看哪个代理在哪里工作、哪个在等你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在分支旁查看哪個代理在哪裡工作、哪個在等你。"
          }
        }
      }
    },
