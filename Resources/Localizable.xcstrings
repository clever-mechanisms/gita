        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取期间关联的 Vercel 项目已更改。请刷新以载入其部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
