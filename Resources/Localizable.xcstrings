    "This diff changed. Refresh it before applying a hunk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This diff changed. Refresh it before applying a hunk."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento rozdíl se změnil. Před použitím bloku jej obnovte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comparación cambió. Actualízala antes de aplicar un bloque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Diff hat sich geändert. Aktualisiere ihn, bevor du einen Block anwendest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
