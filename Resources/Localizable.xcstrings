            "state": "translated",
            "value": "Vercel знову збере це розгортання. Середовище: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel はこのデプロイを %@ 環境で再ビルドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 이 배포를 %@ 환경에서 다시 빌드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 将在 %@ 环境中重新构建此部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 將在 %@ 環境中重新建置此部署。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel จะ build deployment นี้ใหม่ใน %@"
          }
        }
      }
    },
    "Vercel returned project details that could not be verified.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel returned project details that could not be verified."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel vrátil podrobnosti projektu, které nebylo možné ověřit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel devolvió detalles del proyecto que no se pudieron verificar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel hat Projektdetails geliefert, die nicht verifiziert werden konnten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel nem ellenőrizhető projektrészleteket adott vissza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel a renvoyé des détails de projet qui n’ont pas pu être vérifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel が返したプロジェクトの詳細を検証できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 반환한 프로젝트 상세 정보를 검증하지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
