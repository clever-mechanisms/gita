    "Promotion requested. Production switches when Vercel finishes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povýšení bylo vyžádáno. Produkce se přepne, jakmile Vercel dokončí zpracování."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochstufung angefordert. Die Produktion wechselt, sobald Vercel fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotion requested. Production switches when Vercel finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó la promoción. Producción cambiará cuando Vercel termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotion demandée. La production basculera quand Vercel aura terminé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előléptetési kérés elküldve. Az éles környezet átvált, amint a Vercel végez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promozione richiesta. La produzione cambierà quando Vercel avrà finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昇格をリクエストしました。Vercel の処理が完了すると本番が切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승격을 요청했습니다. Vercel이 작업을 마치면 프로덕션이 전환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotie aangevraagd. Productie schakelt om zodra Vercel klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlecono promowanie. Produkcja przełączy się, gdy Vercel zakończy pracę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Promoção solicitada. A produção muda quando o Vercel terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод запрошен. Рабочая среда переключится, когда Vercel завершит операцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Befordran begärd. Produktion växlar när Vercel är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอ promote แล้ว production จะสลับเมื่อ Vercel ทำงานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükseltme istendi. Vercel işlemi bitirdiğinde canlı ortam geçiş yapacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переведення запитано. Робоче середовище перемкнеться, коли Vercel завершить операцію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求提升。Vercel 完成后，生产环境将切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求提升。Vercel 完成後，正式環境將切換。"
          }
        }
      }
    },
