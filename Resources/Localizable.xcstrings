        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시작할 앱을 열지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervangende app kon niet worden geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć zastępczej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
