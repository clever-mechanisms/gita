    "Deleting this branch could discard commits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this branch could discard commits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáním této větve můžete přijít o revize."
          }
        },
