            "value": "Committe oder stashe zuerst die Änderungen in diesem Worktree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero haz commit o stash de los cambios de este árbol de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitez ou mettez en stash les modifications de cet arbre de travail d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui prima il commit o lo stash delle modifiche in questo albero di lavoro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb véglegesítse vagy tegye félre a változásokat ebben a munkafában."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit of stash eerst de wijzigingen in deze worktree."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zatwierdź zmiany w tym drzewie roboczym lub odłóż je do schowka zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça commit ou stash das alterações nesta árvore de trabalho primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en commit eller stasha ändringarna i denna worktree först."
