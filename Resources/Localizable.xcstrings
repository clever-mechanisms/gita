            "state": "translated",
            "value": "Vercel toto nasazení znovu sestaví v prostředí %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel újra összeállítja ezt a telepítést a(z) %@ környezetben."
          }
        },
        "pl": {
