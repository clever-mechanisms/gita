    "Choose an ancestor before at least one current-branch commit.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte předka, za kterým následuje alespoň jedna revize aktuální větve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Vorfahren vor mindestens einem Commit des aktuellen Branches."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an ancestor before at least one current-branch commit."
          }
        },
