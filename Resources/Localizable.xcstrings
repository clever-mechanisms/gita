          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นที่ต้องแก้ไขก่อน merge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirmeden önce ele alınması gereken geri bildirim gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати відгук, який треба врахувати до злиття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
