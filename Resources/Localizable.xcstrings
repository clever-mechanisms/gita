    "Imported actions always ask for confirmation before running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported actions always ask for confirmation before running."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importované akce před spuštěním vždy vyžadují potvrzení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Aktionen fragen vor der Ausführung immer nach einer Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones importadas siempre piden confirmación antes de ejecutarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions importées demandent toujours confirmation avant leur exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni importate chiedono sempre conferma prima dell’esecuzione."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az importált műveletek futtatás előtt mindig megerősítést kérnek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïmporteerde acties vragen altijd om bevestiging vóór uitvoering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane akcje zawsze proszą o potwierdzenie przed uruchomieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações importadas sempre pedem confirmação antes de executar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importerade åtgärder ber alltid om bekräftelse före körning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่นำเข้าจะขอการยืนยันก่อนรันเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan eylemler çalıştırılmadan önce her zaman onay ister."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные действия всегда запрашивают подтверждение перед запуском."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані дії завжди запитують підтвердження перед запуском."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだアクションは実行前に必ず確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 동작은 실행 전에 항상 확인을 요청합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的操作在运行前始终会请求确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的動作在執行前一律會要求確認。"
          }
        }
      }
    },
