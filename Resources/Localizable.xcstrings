    "Switch branches in these worktrees before restacking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch branches in these worktrees before restacking."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před přeskupením zásobníku přepněte větve v těchto pracovních stromech."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle vor dem Neustapeln die Branches in diesen Worktrees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de rama en estos árboles de trabajo antes de reapilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de branche dans ces arbres de travail avant le réempilage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ramo in questi alberi di lavoro prima di riallineare lo stack."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újrarendezés előtt váltson ágat ezekben a munkafákban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel over naar een andere branch in deze worktrees vóór het herstapelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącz gałęzie w tych drzewach roboczych przed przebudowaniem stosu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne as branches nestas árvores de trabalho antes de reempilhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt gren i dessa worktrees före omstapling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับ branch ใน worktree เหล่านี้ก่อนทำ restack"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden hizalamadan önce bu çalışma ağaçlarındaki dalları değiştirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите ветки в этих рабочих деревьях перед пересборкой стека."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемкніть гілки в цих робочих деревах перед перебудовою стеку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再スタックする前に、これらのワークツリーでブランチを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리스택하기 전에 이 작업 트리들의 브랜치를 전환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新堆叠前，请先切换这些工作树中的分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新堆疊前，請先切換這些工作樹中的分支。"
          }
        }
      }
    },
