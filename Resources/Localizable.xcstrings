    "Enter a nonempty reword message of at most 64 KB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nonempty reword message of at most 64 KB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte neprázdnou náhradní zprávu o velikosti nejvýše 64 KB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un mensaje de reformulación no vacío de 64 KB como máximo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine nicht leere neue Nachricht mit höchstens 64 KB ein."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg legfeljebb 64 KB-os, nem üres helyettesítő üzenetet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un message de reformulation non vide de 64 KB maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き換えメッセージを空にせず、64 KB 以内で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비어 있지 않은 메시지를 64 KB 이내로 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入非空的改写消息，大小不超过 64 KB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入非空的改寫訊息，大小不超過 64 KB。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un messaggio sostitutivo non vuoto di massimo 64 KB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz niepusty nowy komunikat o rozmiarze do 64 KB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een niet-leeg vervangend bericht van maximaal 64 KB in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma mensagem de reformulação não vazia de no máximo 64 KB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 64 KB boyutunda, boş olmayan bir yeni ileti girin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett ersättningsmeddelande som inte är tomt och högst 64 KB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите непустое новое сообщение размером не более 64 КБ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть непорожнє нове повідомлення розміром не більше ніж 64 КБ."
