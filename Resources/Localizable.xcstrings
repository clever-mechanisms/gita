        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某项更改被多次分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某項變更被重複指派。"
          }
        }
      }
    },
    "A coding agent finishes its turn and waits for you.": {
