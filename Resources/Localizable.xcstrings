        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie ma już skrótu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não tem mais atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У команды «%@» больше нет сочетания клавиш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” har inte längre något kortkommando."
