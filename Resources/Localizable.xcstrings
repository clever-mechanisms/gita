    "Inherited, included or non-local remote settings are read-only here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inherited, included or non-local remote settings are read-only here."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zděděná, zahrnutá nebo jiná než místní nastavení vzdáleného repozitáře jsou zde jen pro čtení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes heredados, incluidos o no locales del remoto son de solo lectura aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geerbte, eingebundene oder nicht lokale Remote-Einstellungen sind hier schreibgeschützt."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az örökölt, beemelt vagy nem helyi távoli beállítások itt csak olvashatók."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages distants hérités, inclus ou non locaux sont en lecture seule ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継承、インクルード、またはローカル以外のリモート設定はここでは読み取り専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상속되거나 포함된 설정 및 로컬이 아닌 원격 설정은 여기서 읽기 전용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的继承、包含或非本地远程设置为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的繼承、包含或非本機遠端設定為唯讀。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni remote ereditate, incluse o non locali sono di sola lettura qui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziedziczone, dołączone lub nielokalne ustawienia zdalnego repozytorium są tutaj tylko do odczytu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overgenomen, ingevoegde of niet-lokale remote-instellingen zijn hier alleen-lezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes remotos herdados, incluídos ou não locais são somente leitura aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devralınan, dahil edilen veya yerel olmayan uzak depo ayarları burada salt okunurdur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ärvda, inkluderade eller icke-lokala fjärrarkivsinställningar är skrivskyddade här."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Унаследованные, подключённые или нелокальные настройки удалённого репозитория здесь доступны только для чтения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Успадковані, підключені або нелокальні параметри віддаленого репозиторію тут доступні лише для читання."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า remote ที่สืบทอดมา ถูกรวมไว้ หรือไม่ได้อยู่ในเครื่อง จะแก้ไขที่นี่ไม่ได้"
          }
        }
      }
    },
