    "Changed on one side and deleted on the other. Keep the file or delete it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed on one side and deleted on the other. Keep the file or delete it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na jedné straně změněn a na druhé smazán. Soubor zachovejte, nebo jej smažte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificado en un lado y eliminado en el otro. Conserva el archivo o elimínalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer Seite geändert und auf der anderen gelöscht. Behalte die Datei oder lösche sie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik oldalon módosult, a másikon törölték. Tartsa meg vagy törölje a fájlt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié d’un côté et supprimé de l’autre. Conservez le fichier ou supprimez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一方で変更され、もう一方で削除されました。ファイルを残すか削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한쪽에서는 변경되고 다른 쪽에서는 삭제되었습니다. 파일을 유지하거나 삭제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一侧已更改，另一侧已删除。请保留或删除此文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一側已變更，另一側已刪除。請保留或刪除此檔案。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificato da un lato ed eliminato dall’altro. Mantieni il file o eliminalo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniony po jednej stronie i usunięty po drugiej. Zachowaj plik lub go usuń."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan de ene kant gewijzigd en aan de andere verwijderd. Behoud het bestand of verwijder het."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterado de um lado e excluído do outro. Mantenha o arquivo ou exclua-o."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarafta değiştirildi, diğerinde silindi. Dosyayı koruyun veya silin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrad på ena sidan och borttagen på den andra. Behåll filen eller ta bort den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменён на одной стороне и удалён на другой. Оставьте файл или удалите его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінено на одній стороні й видалено на іншій. Збережіть файл або видаліть його."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝ่ายหนึ่งแก้ไข อีกฝ่ายลบ ให้เก็บไฟล์ไว้หรือลบ"
          }
        }
      }
    },
