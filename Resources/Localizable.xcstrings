            "state": "translated",
            "value": "Installa la CLI di %@ per connettere questo provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj CLI %@, aby połączyć tę usługę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer de CLI van %@ om deze provider te verbinden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a CLI de %@ para conectar este provedor."
