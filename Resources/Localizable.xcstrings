            "value": "Oldja fel a függőben lévő változásokat, majd folytassa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi le modifiche in sospeso, poi continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の変更を解決してから続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 중인 변경 사항을 해결한 다음 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los de openstaande wijzigingen op en ga dan door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż oczekujące zmiany, a następnie kontynuuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva as alterações pendentes e continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработайте оставшиеся изменения, затем продолжите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös väntande ändringar och fortsätt sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้การเปลี่ยนแปลงที่ค้างอยู่แล้วดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen değişiklikleri çözün, ardından devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опрацюйте решту змін, потім продовжте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解决待处理更改，然后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先解決待處理變更，然後繼續。"
          }
        }
      }
    },
    "Resolve this oversized or special working file outside the editor, then stage it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento příliš velký nebo speciální pracovní soubor vyřešte mimo editor a poté jej připravte k zápisu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse diese übergroße oder spezielle Arbeitsdatei außerhalb des Editors und stage sie dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve this oversized or special working file outside the editor, then stage it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve este archivo de trabajo especial o demasiado grande fuera del editor y prepáralo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez ce fichier de travail spécial ou trop volumineux hors de l’éditeur, puis indexez-le."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A túlméretes vagy speciális munkafájlt a szerkesztőn kívül rendezze, majd készítse elő."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi questo file di lavoro speciale o troppo grande fuori dall’editor, poi preparalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この大きすぎるファイルまたは特殊な作業ファイルはエディタ外で解決してからステージしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기가 너무 크거나 특수한 이 작업 파일은 편집기 밖에서 해결한 다음 스테이징하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dit te grote of speciale werkbestand buiten de editor op en zet het dan klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż zmiany w tym zbyt dużym lub specjalnym pliku roboczym poza edytorem, a następnie dodaj go do indeksu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva este arquivo de trabalho especial ou muito grande fora do editor e prepare-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработайте этот слишком большой или специальный рабочий файл вне редактора, затем добавьте его в индекс."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös denna för stora eller speciella arbetsfil utanför editorn och förbered den sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไฟล์ใน working tree ที่ใหญ่เกินหรือเป็นไฟล์พิเศษนี้นอกเอดิเตอร์ แล้ว stage"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çok büyük veya özel çalışma dosyasını düzenleyici dışında çözün, ardından hazırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опрацюйте цей завеликий або спеціальний робочий файл поза редактором, потім додайте його до індексу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在编辑器之外解决此超大或特殊工作文件，然后暂存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在編輯器之外解決此過大或特殊工作檔案，然後暫存。"
          }
        }
      }
