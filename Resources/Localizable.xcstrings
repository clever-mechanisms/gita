          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub не позволяет одобрить собственный pull request или запросить в нём изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
