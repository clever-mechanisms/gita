    "The last commit changed. Refresh before amending it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední revize se změnila. Před doplněním obnovte zobrazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Commit hat sich geändert. Aktualisiere, bevor du ihn ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last commit changed. Refresh before amending it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último commit cambió. Actualiza antes de enmendarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier commit a changé. Actualisez avant de l’amender."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó commit megváltozott. Módosítás előtt frissítsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo commit è cambiato. Aggiorna prima di modificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前のコミットが変更されました。修正する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 커밋이 변경되었습니다. 수정하기 전에 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste commit is gewijzigd. Vernieuw voordat je hem aanpast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni commit się zmienił. Odśwież przed jego poprawieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último commit mudou. Atualize antes de emendá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний коммит изменился. Обновите перед его исправлением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste commiten har ändrats. Uppdatera innan du ändrar den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ล่าสุดเปลี่ยนไป ให้รีเฟรชก่อนแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son commit değişti. Düzeltmeden önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Останній коміт змінився. Оновіть дані, перш ніж виправляти його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次提交已更改。请先刷新再修订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次提交已變更。請先重新整理再修訂。"
          }
        }
      }
    },
    "The linked Vercel project changed during the read. Refresh to load its deployments.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojený projekt Vercel se během čtení změnil. Obnovte zobrazení a načtěte jeho nasazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verknüpfte Vercel-Projekt hat sich während des Lesens geändert. Aktualisiere, um seine Bereitstellungen zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked Vercel project changed during the read. Refresh to load its deployments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto Vercel vinculado cambió durante la lectura. Actualiza para cargar sus despliegues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet Vercel lié a changé pendant la lecture. Actualisez pour charger ses déploiements."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolt Vercel-projekt olvasás közben megváltozott. Frissítsen a telepítései betöltéséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto Vercel collegato è cambiato durante la lettura. Aggiorna per caricare le sue distribuzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り中にリンク先の Vercel プロジェクトが変更されました。更新してデプロイを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽는 동안 연결된 Vercel 프로젝트가 변경되었습니다. 새로 고쳐 배포를 로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gekoppelde Vercel-project is tijdens het lezen gewijzigd. Vernieuw om de implementaties te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązany projekt Vercel zmienił się podczas odczytu. Odśwież, aby wczytać jego wdrożenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto Vercel vinculado mudou durante a leitura. Atualize para carregar suas implantações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанный проект Vercel изменился во время чтения. Обновите данные, чтобы загрузить его развёртывания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det länkade Vercel-projektet ändrades under läsningen. Uppdatera för att läsa in dess driftsättningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ Vercel ที่เชื่อมไว้เปลี่ยนไประหว่างการอ่าน ให้รีเฟรชเพื่อโหลด deployment"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı Vercel projesi okuma sırasında değişti. Dağıtımlarını yüklemek için yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пов’язаний проєкт Vercel змінився під час читання. Оновіть дані, щоб завантажити його розгортання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取期间关联的 Vercel 项目已更改。请刷新以载入其部署。"
          }
