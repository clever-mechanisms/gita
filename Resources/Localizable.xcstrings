    "Pick a Bad commit and an older Good commit. Git checks out the midpoint so you can mark steps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Bad commit and an older Good commit. Git checks out the midpoint so you can mark steps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte chybnou revizi a starší dobrou revizi. Git přepne na střed mezi nimi, abyste mohli označovat jednotlivé kroky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen fehlerhaften Commit und einen älteren guten Commit. Git checkt die Mitte aus, damit du Schritte markieren kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un commit Malo y un commit Bueno anterior. Git extrae el punto intermedio para que puedas marcar los pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mauvais commit et un bon commit plus ancien. Git extrait le point médian afin que vous puissiez marquer les étapes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un commit Difettoso e un commit Funzionante precedente. Git effettuerà il checkout del punto intermedio così da poter contrassegnare i passaggi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy Hibás és egy régebbi Jó commitot. A Git kiveszi a középső pontot, így megjelölheti a lépéseket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een slechte commit en een oudere goede commit. Git checkt het middelpunt uit zodat je stappen kunt markeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Błędny commit i starszy Dobry commit. Git przełączy na commit środkowy, aby umożliwić oznaczanie kroków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um commit Ruim e um commit Bom mais antigo. O Git faz checkout do ponto intermediário para você marcar as etapas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en felaktig commit och en äldre fungerande commit. Git checkar ut mittpunkten så att du kan markera steg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก commit ที่เสียและ commit ที่ดีที่เก่ากว่า Git จะ checkout จุดกึ่งกลางเพื่อให้คุณทำเครื่องหมายทีละขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Hatalı commit ve daha eski bir Sağlam commit seçin. Git, adımları işaretleyebilmeniz için orta noktayı kullanıma alır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите плохой коммит и более ранний хороший. Git переключится на середину диапазона, чтобы вы могли отмечать шаги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть поганий коміт і старіший добрий коміт. Git перемкнеться на середній коміт, щоб ви могли позначати кроки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad コミットとそれより古い Good コミットを選択してください。Git が中間点をチェックアウトするので、各ステップを判定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁨 커밋과 그보다 이전의 좋음 커밋을 선택하세요. 단계를 표시할 수 있도록 Git이 중간 지점을 체크아웃합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个异常提交和一个更早的正常提交。Git 会检出中间提交供你逐步标记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個異常提交與一個較早的正常提交。Git 會簽出中點提交供你逐步標記。"
          }
        }
      }
    },
