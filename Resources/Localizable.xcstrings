    "Merge commits cannot be simulated in linear rebase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge commits cannot be simulated in linear rebase."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slučovací revize nelze simulovat při lineárním přesazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge-Commits können bei einem linearen Rebase nicht simuliert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los commits de fusión no se pueden simular en un rebase lineal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commits de fusion ne peuvent pas être simulés dans un rebase linéaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I commit di merge non possono essere simulati in un rebase lineare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyesítési commitok nem szimulálhatók lineáris újraalapozásban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge-commits kunnen niet worden gesimuleerd in een lineaire rebase."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitów scalających nie można zasymulować w liniowej zmianie bazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Commits de mesclagem não podem ser simulados em um rebase linear."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagningscommits kan inte simuleras i en linjär rebase."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำลอง merge commit ใน linear rebase ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirme commitleri doğrusal yeniden temellendirmede simüle edilemez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коммиты слияния нельзя смоделировать при линейном перебазировании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коміти зливання не можна змоделювати в лінійному перебазовуванні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージコミットは線形リベースではシミュレーションできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 커밋은 선형 리베이스에서 시뮬레이션할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
