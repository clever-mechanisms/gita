    "Git could not add the local remote configuration. Reload the remote list.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nemohl přidat místní konfiguraci vzdáleného repozitáře. Načtěte seznam znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git konnte die lokale Remote-Konfiguration nicht hinzufügen. Lade die Remote-Liste neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git could not add the local remote configuration. Reload the remote list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git no pudo añadir la configuración local del remoto. Vuelve a cargar la lista de remotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git n’a pas pu ajouter la configuration locale du dépôt distant. Rechargez la liste des dépôts distants."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git nem tudta hozzáadni a távoli tároló helyi beállításait. Töltse újra a távoli tárolók listáját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git non ha potuto aggiungere la configurazione locale del remoto. Ricarica l’elenco dei remoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git はローカルのリモート設定を追加できませんでした。リモート一覧を再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git이 로컬 원격 구성을 추가하지 못했습니다. 원격 목록을 다시 로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kon de lokale remoteconfiguratie niet toevoegen. Laad de remotelijst opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nie może dodać lokalnej konfiguracji zdalnego repozytorium. Wczytaj ponownie listę zdalnych repozytoriów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git não pôde adicionar a configuração local do remoto. Recarregue a lista de remotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не удалось добавить локальную конфигурацию удалённого репозитория. Перезагрузите список удалённых репозиториев."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kunde inte lägga till den lokala fjärrarkivskonfigurationen. Läs in listan över fjärrarkiv igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git เพิ่มการตั้งค่า remote ในเครื่องไม่ได้ ให้โหลดรายการ remote ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git yerel uzak depo yapılandırmasını ekleyemedi. Uzak depo listesini yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не вдалося додати локальну конфігурацію віддаленого репозиторію. Перезавантажте список віддалених репозиторіїв."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 无法添加本地远程配置。请重新载入远程列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 無法加入本機遠端設定。請重新載入遠端列表。"
          }
        }
      }
    },
    "Git could not change the local fetch URL. Reload the remote list.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nemohl změnit místní URL pro vyzvednutí. Načtěte seznam vzdálených repozitářů znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git konnte die lokale Abruf-URL nicht ändern. Lade die Remote-Liste neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git could not change the local fetch URL. Reload the remote list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git no pudo cambiar la URL local de obtención. Vuelve a cargar la lista de remotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git n’a pas pu modifier l’URL locale de récupération. Rechargez la liste des dépôts distants."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git nem tudta módosítani a helyi lekérési URL-t. Töltse újra a távoli tárolók listáját."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git non ha potuto modificare l’URL locale di recupero. Ricarica l’elenco dei remoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git はローカルのフェッチ URL を変更できませんでした。リモート一覧を再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git이 로컬 가져오기 URL을 변경하지 못했습니다. 원격 목록을 다시 로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kon de lokale ophaal-URL niet wijzigen. Laad de remotelijst opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git nie może zmienić lokalnego URL pobierania. Wczytaj ponownie listę zdalnych repozytoriów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git não pôde alterar o URL local de busca. Recarregue a lista de remotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не удалось изменить локальный URL получения. Перезагрузите список удалённых репозиториев."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kunde inte ändra den lokala hämtnings-URL:en. Läs in listan över fjärrarkiv igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
