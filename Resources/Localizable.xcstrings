    "Showing the first 50 jobs and up to 200 steps per job. Open GitHub for the full view.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the first 50 jobs and up to 200 steps per job. Open GitHub for the full view."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeno prvních 50 úloh a nejvýše 200 kroků na úlohu. Úplný přehled najdete na GitHubu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran los primeros 50 trabajos y hasta 200 pasos por trabajo. Abre GitHub para ver todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten 50 Jobs und bis zu 200 Schritte pro Job werden angezeigt. Öffne GitHub für die vollständige Ansicht."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első 50 feladat és feladatonként legfeljebb 200 lépés látható. A teljes nézethez nyissa meg a GitHubot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des 50 premières tâches et de 200 étapes maximum par tâche. Ouvrez GitHub pour la vue complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の50件のジョブと各ジョブの最大200ステップを表示しています。全体は GitHub で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 50개 작업과 작업당 최대 200개 단계를 표시합니다. 전체 내용은 GitHub에서 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示前 50 个作业，每个作业最多 200 个步骤。请打开 GitHub 查看全部内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在顯示前 50 個作業，每個作業最多 200 個步驟。請打開 GitHub 檢視全部內容。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati i primi 50 processi e fino a 200 passaggi per processo. Apri GitHub per la vista completa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlono pierwszych 50 zadań i do 200 kroków na zadanie. Otwórz GitHub, aby zobaczyć całość."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste 50 jobs en maximaal 200 stappen per job worden getoond. Open GitHub voor de volledige weergave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibindo os primeiros 50 trabalhos e até 200 etapas por trabalho. Abra o GitHub para a visualização completa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk 50 iş ve her iş için en fazla 200 adım gösteriliyor. Tam görünüm için GitHub'ı açın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar de första 50 jobben och upp till 200 steg per jobb. Öppna GitHub för hela vyn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны первые 50 заданий и до 200 шагов на задание. Полный список доступен в GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано перші 50 завдань і до 200 кроків на завдання. Повний список доступний у GitHub."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง job 50 รายการแรกและไม่เกิน 200 ขั้นต่อ job เปิด GitHub เพื่อดูทั้งหมด"
          }
        }
      }
    },
    "Showing the latest 100 reviews, comments and threads. Open GitHub for the rest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the latest 100 reviews, comments and threads. Open GitHub for the rest."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se posledních 100 posouzení, komentářů a vláken. Zbytek najdete na GitHubu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden die neuesten 100 Reviews, Kommentare und Threads angezeigt. Öffne GitHub für den Rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran las 100 revisiones, comentarios e hilos más recientes. Abre GitHub para ver el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des 100 révisions, commentaires et fils les plus récents. Ouvrez GitHub pour le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati gli ultimi 100 elementi tra revisioni, commenti e thread. Apri GitHub per il resto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi 100 véleményezés, megjegyzés és szál látható. A többihez nyissa meg a GitHubot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste 100 reviews, opmerkingen en threads worden getoond. Open GitHub voor de rest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlono ostatnie 100 recenzji, komentarzy i wątków. Resztę zobaczysz w GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando as últimas 100 revisões, comentários e threads. Abra o GitHub para ver o restante."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar de senaste 100 granskningarna, kommentarerna och trådarna. Öppna GitHub för resten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 100 inceleme, yorum ve konu gösteriliyor. Geri kalanı için GitHub'ı açın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны последние 100 рецензий, комментариев и обсуждений. Остальное откройте на GitHub."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано останні 100 рецензій, коментарів і обговорень. Решту відкрийте на GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新 100 件のレビュー、コメント、スレッドを表示しています。残りは GitHub を開いて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 검토, 댓글, 스레드 100개를 표시합니다. 나머지는 GitHub에서 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最近 100 条审查、评论和讨论串。其余内容请打开 GitHub 查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示最近 100 則審查、留言和討論串。其餘內容請打開 GitHub 檢視。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงรีวิว ความคิดเห็น และ thread ล่าสุด 100 รายการ เปิด GitHub สำหรับส่วนที่เหลือ"
          }
        }
      }
    },
