      }
    },
    "Vercel stops this build. It cannot be resumed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel toto sestavení zastaví. Pokračovat v něm už nebude možné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stoppt diesen Build. Er kann nicht fortgesetzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stops this build. It cannot be resumed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel detiene esta compilación. No se puede reanudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel arrête ce build. Il ne pourra pas être repris."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel leállítja ezt az összeállítást. Később nem folytatható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel interrompe questa build. Non potrà essere ripresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel はこのビルドを停止します。停止したビルドは再開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 이 빌드를 중지합니다. 중지된 빌드는 재개할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stopt deze build. Deze kan niet worden hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zatrzyma tę kompilację. Nie będzie można jej wznowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel interrompe este build. Ele não poderá ser retomado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel остановит эту сборку. Возобновить её будет нельзя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel stoppar detta bygge. Det kan inte återupptas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel จะหยุด build นี้และทำต่อไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bu derlemeyi durdurur. Derleme daha sonra sürdürülemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel зупинить цю збірку. Відновити її буде неможливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 将停止此构建。停止后无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 將停止此建置。停止後無法恢復。"
          }
        }
      }
