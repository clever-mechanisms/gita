    "Pull stops and nothing changes; merge or rebase to bring the commits in.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování se zastaví a nic se nezmění; revize přinesete sloučením nebo přesazením."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull stoppt und nichts ändert sich; führe zusammen oder nutze Rebase, um die Commits zu übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull stops and nothing changes; merge or rebase to bring the commits in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pull se detiene y no cambia nada; fusiona o haz rebase para incorporar los commits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pull s’arrête et rien ne change ; fusionnez ou rebasez pour intégrer les commits."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lehúzás leáll, és semmi sem változik; a commitok behozásához használjon egyesítést vagy újraalapozást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pull si ferma e nulla cambia; esegui merge o rebase per integrare i commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プルは停止し、何も変更されません。コミットを取り込むにはマージまたはリベースしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀이 중단되고 아무것도 바뀌지 않습니다. 커밋을 가져오려면 병합하거나 리베이스하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull stopt en er verandert niets; voeg samen of rebase om de commits binnen te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ściąganie zatrzymuje się i nic się nie zmienia; scal lub zmień bazę, aby wprowadzić commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull para e nada muda; mescle ou faça rebase para trazer os commits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получение останавливается, и ничего не меняется; чтобы принять коммиты, выполните слияние или перебазирование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningen stoppar och inget ändras; slå samman eller rebasa för att föra in commits."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pull จะหยุดและไม่มีการเปลี่ยนแปลง ให้ merge หรือ rebase เพื่อนำ commit เข้ามา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekme durur ve hiçbir şey değişmez; commitleri almak için birleştirin veya yeniden temellendirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримання зупиняється й нічого не змінюється; щоб внести коміти, виконайте зливання або перебазовування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取将停止且不做任何更改；请合并或变基以引入这些提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提取將停止且不做任何變更；請合併或重定基底以引入這些提交。"
          }
        }
      }
    },
