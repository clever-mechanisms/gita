    "Active agent detected; immediate pruning is deferred for safety.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active agent detected; immediate pruning is deferred for safety."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjištěn aktivní agent; okamžité pročištění je z bezpečnostních důvodů odloženo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver Agent erkannt; sofortiges Bereinigen wird aus Sicherheitsgründen verschoben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectó un agente activo; la purga inmediata se pospone por seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent actif détecté ; le nettoyage immédiat est différé par sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato un agente attivo; l’eliminazione immediata è rimandata per sicurezza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktív ügynök észlelve; az azonnali törlés biztonsági okokból elhalasztva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve agent gedetecteerd; direct opruimen is uit veiligheid uitgesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto aktywnego agenta; natychmiastowe usuwanie odroczono dla bezpieczeństwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente ativo detectado; a limpeza imediata foi adiada por segurança."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv agent upptäckt; omedelbar rensning skjuts upp av säkerhetsskäl."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจพบเอเจนต์ที่กำลังทำงานอยู่ จึงเลื่อนการลบทันทีเพื่อความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin ajan algılandı; güvenlik için anında temizleme ertelendi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен активный агент; немедленная очистка отложена для безопасности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виявлено активного агента; негайне очищення відкладено для безпеки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "稼働中のエージェントを検出したため、安全のため即時プルーニングを延期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 에이전트가 감지되어 안전을 위해 즉시 정리를 연기합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到活动代理；为安全起见已延迟立即清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到使用中的代理；為安全起見已延後立即清理。"
          }
        }
      }
    },
