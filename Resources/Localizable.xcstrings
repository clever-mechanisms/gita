    "Reviews branches and commits from their menus, in the terminal chosen in General": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluje větve a commity z jejich nabídek v terminálu zvoleném v Obecných"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Branches und Commits über deren Menüs im unter Allgemein gewählten Terminal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews branches and commits from their menus, in the terminal chosen in General"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa ramas y commits desde sus menús, en el terminal elegido en General"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit les branches et commits depuis leurs menus, dans le terminal choisi dans Général"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ágakat és commitokat néz át a menüjükből, az Általános alatt választott terminálban"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivede rami e commit dai loro menu, nel terminale scelto in Generali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチやコミットのメニューから、「一般」で選んだターミナルでレビューします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브랜치와 커밋의 메뉴에서 일반에서 선택한 터미널로 리뷰합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeelt branches en commits vanuit hun menu’s, in de terminal die in Algemeen is gekozen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląda gałęzie i commity z ich menu, w terminalu wybranym w Ogólnych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa ramos e commits pelos menus deles, no terminal escolhido em Geral"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет ветки и коммиты из их меню в терминале, выбранном в Основных"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granskar grenar och commits från deras menyer, i terminalen som valts i Allmänt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีวิว branch และ commit จากเมนูของรายการนั้น ใน Terminal ที่เลือกไว้ในทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalları ve commit'leri menülerinden, Genel'de seçilen terminalde inceler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядає гілки й коміти з їхніх меню в терміналі, вибраному в Загальних"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从分支和提交的菜单中，在“通用”中选择的终端里审查"
