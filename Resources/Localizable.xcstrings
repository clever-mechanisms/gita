          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma czego stosować ponownie, więc main po prostu przesuwa się do origin/main."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a reaplicar, então main apenas avança até origin/main."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно применять нечего, поэтому main просто передвигается к origin/main."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att tillämpa igen, så main flyttas bara fram till origin/main."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรต้องเล่นซ้ำ main จึงเลื่อนขึ้นไปที่ origin/main"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden uygulanacak bir şey yok, bu yüzden main yalnızca origin/main konumuna ilerler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема чого повторно застосовувати, тож main просто пересувається до origin/main."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需重放，因此 main 直接前移到 origin/main。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需重播，因此 main 直接前移到 origin/main。"
          }
        }
      }
    },
