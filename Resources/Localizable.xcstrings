    "Stage changes, then Continue to amend this commit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage changes, then Continue to amend this commit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připravte změny a poté zvolte Pokračovat, čímž doplníte tuto revizi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara los cambios y usa Continuar para enmendar este commit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage Änderungen und wähle Fortsetzen, um diesen Commit zu ergänzen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készítse elő a változásokat, majd a commit módosításához válassza a Folytatás lehetőséget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexez les modifications, puis choisissez Continuer pour amender ce commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更をステージしてから「続ける」でこのコミットを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 스테이징한 다음 '계속'으로 이 커밋을 수정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请暂存更改，然后选择“继续”以修订此提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請暫存變更，然後選擇「繼續」以修訂此提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara le modifiche, poi scegli Continua per modificare questo commit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zmiany do indeksu, a następnie wybierz Kontynuuj, aby poprawić ten commit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet wijzigingen klaar en kies Ga door om deze commit aan te passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare as alterações e use Continuar para emendar este commit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri hazırlayın, ardından bu commiti düzeltmek için Devam Et'i seçin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered ändringar och välj Fortsätt för att ändra denna commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте изменения в индекс и нажмите «Продолжить», чтобы исправить этот коммит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте зміни до індексу й натисніть «Продовжити», щоб виправити цей коміт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "stage การเปลี่ยนแปลง แล้วกดดำเนินการต่อเพื่อแก้ไข commit นี้"
          }
        }
      }
    },
    "Stage changes, then continue to amend this commit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage changes, then continue to amend this commit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připravte změny a poté pokračujte, čímž doplníte tuto revizi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara los cambios y continúa para enmendar este commit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage Änderungen und setze fort, um diesen Commit zu ergänzen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készítse elő a változásokat, majd folytassa a commit módosításához."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexez les modifications, puis continuez pour amender ce commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更をステージしてから続行し、このコミットを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 스테이징한 다음 계속하여 이 커밋을 수정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请暂存更改，然后继续以修订此提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請暫存變更，然後繼續以修訂此提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara le modifiche, poi continua per modificare questo commit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zmiany do indeksu, a następnie kontynuuj, aby poprawić ten commit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet wijzigingen klaar en ga door om deze commit aan te passen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare as alterações e continue para emendar este commit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri hazırlayın, ardından bu commiti düzeltmek için devam edin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered ändringar och fortsätt för att ändra denna commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте изменения в индекс, затем продолжите, чтобы исправить этот коммит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте зміни до індексу, потім продовжте, щоб виправити цей коміт."
          }
        },
        "th": {
