        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти зміни в індексі та робочому дереві."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已暂存更改和工作区更改。"
          }
        },
