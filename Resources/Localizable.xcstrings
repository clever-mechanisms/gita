            "state": "translated",
            "value": "ネイティブのリベースエディタの実行ファイルを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 리베이스 편집기 실행 파일을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitvoerbare bestand van de native rebase-editor is niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik wykonywalny natywnego edytora zmiany bazy jest niedostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O executável do editor nativo de rebase está indisponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исполняемый файл встроенного редактора перебазирования недоступен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inbyggda rebase-editorns körbara fil är inte tillgänglig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
