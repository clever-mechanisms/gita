    "Someone else merges a pull request on your repositories; the notification says who.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo jiný sloučí žádost o začlenění ve vašich repozitářích; oznámení uvede kdo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes führt einen Pull Request in deinen Repositorys zusammen; die Mitteilung sagt, wer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else merges a pull request on your repositories; the notification says who."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona fusiona una pull request en tus repositorios; la notificación indica quién."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre fusionne une pull request sur vos dépôts ; la notification indique qui."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki más egyesít egy beolvasztási kérelmet az Ön tárolóiban; az értesítés megmondja, ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro integra una pull request nei tuoi repository; la notifica indica chi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人があなたのリポジトリでプルリクエストをマージしたとき。誰がマージしたかが通知に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 내 저장소의 풀 리퀘스트를 병합할 때. 알림에 누가 병합했는지 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand anders voegt een pullrequest samen in je repository’s; de melding zegt wie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś inny scala pull request w Twoich repozytoriach; powiadomienie mówi, kto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa mescla um pull request nos seus repositórios; a notificação diz quem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то другой сливает запрос на слияние в ваших репозиториях; в уведомлении сказано, кто."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon annan slår samman en pull request i dina förråd; notisen säger vem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนอื่น merge pull request ใน repository ของคุณ การแจ้งเตือนจะบอกว่าเป็นใคร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka biri depolarınızda bir birleştirme isteğini birleştirir; bildirim kim olduğunu söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось інший зливає запит на злиття у ваших репозиторіях; у сповіщенні сказано, хто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人合并了你仓库中的拉取请求时；通知会显示是谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人合併了你儲存庫中的提取要求時；通知會顯示是誰。"
          }
        }
      }
    },
