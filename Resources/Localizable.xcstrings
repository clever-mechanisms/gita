    "Vercel builds a new production deployment from this preview with Production environment variables, then %@ serves it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel z tohoto náhledu sestaví nové produkční nasazení s proměnnými prostředí produkce a poté je začne poskytovat doména %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel erstellt aus dieser Vorschau eine neue Produktions-Bereitstellung mit den Umgebungsvariablen von Produktion. Danach liefert %@ sie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel builds a new production deployment from this preview with Production environment variables, then %@ serves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel compila un nuevo despliegue de producción a partir de esta vista previa con las variables de entorno de Producción y luego %@ lo sirve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel crée un nouveau déploiement de production à partir de cet aperçu avec les variables d’environnement de Production, puis %@ le sert."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel ebből az előnézetből új éles telepítést állít össze az éles környezet változóival, majd a(z) %@ ezt szolgálja ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel crea una nuova distribuzione di produzione da questa anteprima con le variabili d’ambiente di Produzione, poi %@ la serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel はこのプレビューから本番の環境変数を使って新しい本番デプロイをビルドし、その後 %@ で配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 이 미리보기에서 프로덕션 환경 변수로 새 프로덕션 배포를 빌드한 다음 %@에서 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bouwt vanuit deze voorvertoning een nieuwe productie-implementatie met de omgevingsvariabelen van Productie, waarna %@ deze serveert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zbuduje z tego podglądu nowe wdrożenie produkcyjne ze zmiennymi środowiskowymi produkcji, a następnie domena %@ zacznie je serwować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel compila uma nova implantação de produção a partir desta prévia com as variáveis de ambiente de Produção e, em seguida, %@ passa a servi-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel соберёт из этого предпросмотра новое развёртывание для рабочей среды с её переменными окружения, затем его будет обслуживать %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bygger en ny produktionsdriftsättning från denna förhandsvisning med miljövariablerna för Produktion, och sedan levererar %@ den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel สร้าง production deployment ใหม่จากตัวอย่างนี้ด้วยตัวแปรสภาพแวดล้อม production แล้ว %@ จะให้บริการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bu önizlemeden canlı ortam değişkenleriyle yeni bir canlı ortam dağıtımı derler, ardından bu dağıtımı %@ sunar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel збере з цього попереднього перегляду нове розгортання для робочого середовища з його змінними середовища, потім його обслуговуватиме %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 将使用生产环境变量，从此预览构建新的生产部署，然后由 %@ 提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 將使用正式環境變數，從此預覽建置新的正式部署，然後由 %@ 提供。"
          }
        }
      }
    },
    "Vercel did not provide a verified project identity. Project details are unavailable.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel neposkytl ověřenou identitu projektu. Podrobnosti projektu nejsou dostupné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel hat keine verifizierte Projektidentität geliefert. Projektdetails sind nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel did not provide a verified project identity. Project details are unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel no proporcionó una identidad de proyecto verificada. Los detalles del proyecto no están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel n’a pas fourni d’identité de projet vérifiée. Les détails du projet sont indisponibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel nem adott ellenőrzött projektazonosítót. A projekt részletei nem érhetők el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel non ha fornito un’identità del progetto verificata. I dettagli del progetto non sono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel は検証済みのプロジェクト識別情報を提供しませんでした。プロジェクトの詳細は取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 검증된 프로젝트 식별 정보를 제공하지 않았습니다. 프로젝트 상세 정보를 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel gaf geen geverifieerde projectidentiteit. Projectdetails zijn niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel nie podał zweryfikowanego identyfikatora projektu. Szczegóły projektu są niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vercel não forneceu uma identidade de projeto verificada. Os detalhes do projeto estão indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel не предоставил подтверждённый идентификатор проекта. Сведения о проекте недоступны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel angav ingen verifierad projektidentitet. Projektdetaljer är inte tillgängliga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel ไม่ได้ให้ตัวตนโปรเจกต์ที่ตรวจสอบแล้ว จึงไม่มีรายละเอียดโปรเจกต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel doğrulanmış bir proje kimliği sağlamadı. Proje ayrıntıları kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel не надав підтвердженого ідентифікатора проєкту. Відомості про проєкт недоступні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 未提供已验证的项目标识。项目详情不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 未提供已驗證的專案識別資訊。專案詳細資訊無法使用。"
          }
        }
      }
    },
    "Vercel finishes a preview deployment; open the preview from the notification.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel dokončí nasazení náhledu; náhled otevřete z oznámení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel schließt eine Vorschau-Bereitstellung ab; öffne die Vorschau aus der Mitteilung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel finishes a preview deployment; open the preview from the notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel termina un despliegue de vista previa; abre la vista previa desde la notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel termine un déploiement d’aperçu ; ouvrez l’aperçu depuis la notification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel befejez egy előnézeti telepítést; az előnézetet az értesítésből nyithatja meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel completa una distribuzione di anteprima; apri l'anteprima dalla notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel がプレビューデプロイを完了したとき。通知からプレビューを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 미리보기 배포를 완료할 때. 알림에서 미리보기를 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel rondt een voorvertoningsimplementatie af; open de voorvertoning vanuit de melding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel kończy wdrożenie podglądu; otwórz podgląd z powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel conclui uma implantação de prévia; abra a prévia pela notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel завершает развёртывание для предпросмотра; откройте предпросмотр из уведомления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel slutför en förhandsdriftsättning; öppna förhandsvisningen från notisen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel ทำ deployment ตัวอย่างเสร็จ ให้เปิดตัวอย่างจากการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel bir önizleme dağıtımını tamamlar; önizlemeyi bildirimden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel завершує розгортання для попереднього перегляду; відкрийте попередній перегляд зі сповіщення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 完成预览部署时；可从通知中打开预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 完成預覽部署時；可從通知中打開預覽。"
          }
        }
      }
    },
    "Vercel raises an alert on a linked project's production, such as a sudden rise in errors. You hear about each new alert once.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel vyvolá upozornění na produkci propojeného projektu, například při náhlém nárůstu chyb. O každém novém upozornění se dozvíte jednou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel meldet eine Warnung für die Produktion eines verknüpften Projekts, etwa einen plötzlichen Anstieg der Fehler. Du erfährst von jeder neuen Warnung einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel raises an alert on a linked project's production, such as a sudden rise in errors. You hear about each new alert once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel emite una alerta sobre la producción de un proyecto vinculado, como un aumento repentino de errores. Te enteras de cada alerta nueva una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel déclenche une alerte sur la production d’un projet lié, comme une hausse soudaine des erreurs. Vous êtes averti une seule fois de chaque nouvelle alerte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel riasztást ad egy csatolt projekt éles környezetére, például a hibák hirtelen megugrásakor. Minden új riasztásról egyszer értesül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel genera un avviso sulla produzione di un progetto collegato, ad esempio un improvviso aumento degli errori. Vieni informato una sola volta di ogni nuovo avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクされたプロジェクトの本番環境で、エラーの急増などのアラートを Vercel が発したとき。新しいアラートごとに 1 回だけ通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel이 연결된 프로젝트의 프로덕션에 오류 급증 같은 알림을 발생시킬 때. 새 알림마다 한 번씩 알려 드립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel geeft een waarschuwing voor de productie van een gekoppeld project, zoals een plotselinge stijging van fouten. Je hoort elke nieuwe waarschuwing één keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel zgłasza alert dotyczący produkcji połączonego projektu, na przykład nagły wzrost liczby błędów. O każdym nowym alercie dowiadujesz się raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vercel emite um alerta sobre a produção de um projeto vinculado, como um aumento repentino de erros. Você fica sabendo de cada novo alerta uma única vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel поднимает оповещение о продакшене связанного проекта, например о резком росте ошибок. О каждом новом оповещении вы узнаёте один раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel utlöser en varning för ett länkat projekts produktion, till exempel en plötslig ökning av fel. Du får höra om varje ny varning en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel แจ้งเตือนบน production ของโปรเจกต์ที่เชื่อมไว้ เช่น ข้อผิดพลาดเพิ่มขึ้นกะทันหัน คุณจะได้รับการแจ้งเตือนใหม่แต่ละครั้งเพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel, bağlı bir projenin üretim ortamı için bir uyarı verir; örneğin hatalarda ani bir artış. Her yeni uyarıdan bir kez haberdar olursunuz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel піднімає сповіщення про продакшен пов’язаного проєкту, наприклад про різке зростання помилок. Про кожне нове сповіщення ви дізнаєтеся один раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 对已关联项目的生产环境发出告警时，例如错误突然增多。每条新告警只通知一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vercel 對已連結專案的正式環境發出警示時，例如錯誤突然增加。每則新警示只通知一次。"
          }
        }
      }
    },
    "Vercel rebuilds this deployment in %@.": {
      "localizations": {
        "cs": {
