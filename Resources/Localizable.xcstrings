    "Pull remote changes and bring them into your local branch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull remote changes and bring them into your local branch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne vzdálené změny a začlení je do vaší místní větve"
