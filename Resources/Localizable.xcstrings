    "Permanently delete all recorded snapshots for %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete all recorded snapshots for %@?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale smazat všechny zaznamenané snímky pro %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aufgezeichneten Snapshots für %@ endgültig löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar de forma permanente todas las instantáneas registradas de %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement tous les instantanés enregistrés pour %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente tutte le istantanee registrate per %@?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törli a(z) %@ összes rögzített pillanatképét?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vastgelegde momentopnamen voor %@ definitief verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usunąć wszystkie nagrane migawki dla %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir permanentemente todos os snapshots gravados de %@?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera alla inspelade ögonblicksbilder för %@ permanent?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ snapshot ที่บันทึกไว้ทั้งหมดสำหรับ %@ อย่างถาวรหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için kaydedilen tüm anlık görüntüler kalıcı olarak silinsin mi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удалить все записанные снимки для %@?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видалити всі записані знімки для %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の記録済みスナップショットをすべて完全に削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 기록된 스냅샷을 모두 영구적으로 삭제하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除 %@ 的所有已记录快照？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除 %@ 的所有已記錄快照？"
          }
        }
      }
    },
