          "stringUnit": {
            "state": "translated",
            "value": "Bu depoda güvenle incelenemeyecek kadar çok çalışma ağacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому репозиторії забагато робочих дерев для безпечної перевірки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此仓库的工作树过多，无法安全检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本庫的工作樹過多，無法安全檢查。"
          }
        }
      }
    },
    "This reset changes submodule paths. Handle that transition with Git before resetting here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento reset mění cesty dílčích modulů. Před resetem v aplikaci proveďte tento přechod pomocí Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Reset ändert Submodulpfade. Führe diesen Übergang mit Git aus, bevor du hier zurücksetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reset changes submodule paths. Handle that transition with Git before resetting here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este reset cambia rutas de submódulos. Gestiona esa transición con Git antes de restablecer aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce reset modifie les chemins des sous-modules. Gérez cette transition avec Git avant de réinitialiser ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a visszaállítás almodulútvonalakat módosít. Az itteni visszaállítás előtt kezelje az átmenetet a Gittel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo reset modifica i percorsi dei sottomoduli. Gestisci la transizione con Git prima di reimpostare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリセットはサブモジュールのパスを変更します。ここでリセットする前に Git でその変更を処理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리셋은 하위 모듈 경로를 변경합니다. 여기서 리셋하기 전에 Git으로 해당 전환을 처리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reset wijzigt submodulepaden. Verwerk die overgang met Git voordat je hier reset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten reset zmienia ścieżki podmodułów. Obsłuż to przejście za pomocą Git przed resetowaniem tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este reset altera caminhos de submódulos. Trate essa transição com o Git antes de redefinir aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сброс изменяет пути подмодулей. Выполните этот переход средствами Git перед сбросом здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna återställning ändrar undermodulsökvägar. Hantera övergången med Git innan du återställer här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "reset นี้เปลี่ยนพาธของ submodule ให้จัดการการเปลี่ยนนั้นด้วย Git ก่อน reset ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sıfırlama alt modül yollarını değiştiriyor. Burada sıfırlamadan önce bu geçişi Git ile yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це скидання змінює шляхи підмодулів. Виконайте цей перехід засобами Git перед скиданням тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此重置会更改子模块路径。请先使用 Git 处理此转换，再在此处重置。"
          }
