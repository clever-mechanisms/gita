    "The branch that is checked out. Automatic is lime, and moves to another colour when lime would match the theme.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuální větev. Možnost Automaticky je limetková a změní se na jinou barvu, když by limetková splývala s motivem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgecheckte Branch. Automatisch ist Limette und wechselt zu einer anderen Farbe, wenn Limette dem Design gleichen würde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The branch that is checked out. Automatic is lime, and moves to another colour when lime would match the theme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama activa. Automático es lima, y cambia a otro color cuando la lima se confundiría con el tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche extraite. Automatique est citron vert, et passe à une autre couleur quand le citron vert se confondrait avec le thème."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kivett ág. Az Automatikus limezöld, és más színre vált, ha a limezöld egybeolvadna a témával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo estratto. Automatico è verde lime e passa a un altro colore quando il verde lime si confonderebbe con il tema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックアウト中のブランチ。「自動」はライムで、テーマと同じ色になる場合は別の色に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크아웃된 브랜치입니다. '자동'은 라임색이며, 테마와 겹치면 다른 색상으로 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgecheckte branch. Automatisch is limoen en wordt een andere kleur als limoen met het thema zou samenvallen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca gałąź. Opcja Automatycznie to kolor limonkowy, zmieniany na inny, gdy limonkowy zlewałby się z motywem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branch em checkout. Automático é lima e muda para outra cor quando lima coincidiria com o tema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая ветка. В автоматическом режиме — лаймовый; он меняется на другой цвет, если совпадает с темой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den utcheckade grenen. Automatisk är lime och byter till en annan färg när lime skulle sammanfalla med temat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "branch ที่ checkout อยู่ โหมดอัตโนมัติใช้สีเขียวมะนาว และเปลี่ยนเป็นสีอื่นเมื่อสีนั้นซ้ำกับธีม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin dal. Otomatik, limon yeşilidir; limon yeşili temayla aynı olacaksa başka bir renge geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гілка, на якій ви зараз перебуваєте. «Автоматично» — лаймовий колір; якщо він збігається з темою, використовується інший."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检出的分支。“自动”为青柠色，当青柠色与主题相近时会改用其他颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢出的分支。「自動」為萊姆綠，當萊姆綠與主題相近時會改用其他顏色。"
          }
        }
      }
    },
