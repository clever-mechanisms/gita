    "Select a change or assign changes to this bucket.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a change or assign changes to this bucket."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte změnu nebo přiřaďte změny do této skupiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Änderung aus oder weise dieser Gruppe Änderungen zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un cambio o asigna cambios a este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une modification ou assignez des modifications à ce groupe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una modifica o assegna modifiche a questo gruppo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy változást, vagy rendeljen változásokat ehhez a gyűjtőhöz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een wijziging of wijs wijzigingen toe aan deze groep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zmianę lub przypisz zmiany do tego koszyka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma alteração ou atribua alterações a este grupo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en ändring eller tilldela ändringar till denna grupp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการเปลี่ยนแปลงหรือกำหนดการเปลี่ยนแปลงไปยังกลุ่มนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir değişiklik seçin veya bu gruba değişiklik atayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите изменение или назначьте изменения в эту группу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть зміну або призначте зміни до цієї групи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を選択するか、このバケットに変更を割り当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
