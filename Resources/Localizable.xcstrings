    "Discard staged and working changes in tracked files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard staged and working changes in tracked files."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit připravené i pracovní změny ve sledovaných souborech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar los cambios preparados y de trabajo en archivos seguidos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestagte und Arbeitsänderungen in verfolgten Dateien verwerfen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A követett fájlok előkészített és munkapéldánybeli változásainak elvetése."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications indexées et de travail des fichiers suivis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡対象ファイルのステージ済みの変更と作業中の変更を破棄します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적된 파일의 스테이징된 변경과 작업 중인 변경을 버립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃已跟踪文件中的已暂存更改和工作区更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄已追蹤檔案中的已暫存變更和工作區變更。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta le modifiche preparate e di lavoro nei file tracciati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzuć zmiany w indeksie i kopii roboczej śledzonych plików."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerp klaargezette en werkwijzigingen in gevolgde bestanden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar alterações preparadas e de trabalho nos arquivos rastreados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenen dosyalardaki hazırlanmış değişiklikleri ve çalışma değişikliklerini at."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasta förberedda ändringar och arbetsändringar i spårade filer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбросить изменения отслеживаемых файлов в индексе и рабочем дереве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкинути зміни відстежуваних файлів в індексі та робочому дереві."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งการเปลี่ยนแปลงที่ staged และใน working tree ของไฟล์ที่ติดตามอยู่"
          }
        }
      }
    },
    "Discard this commit’s pending changes and continue the sequence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this commit’s pending changes and continue the sequence."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit nevyřízené změny této revize a pokračovat v posloupnosti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar los cambios pendientes de este commit y continuar la secuencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Änderungen dieses Commits verwerfen und Sequenz fortsetzen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A commit függőben lévő változásainak elvetése és a műveletsor folytatása."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications en attente de ce commit et poursuivre la séquence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコミットの保留中の変更を破棄してシーケンスを続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커밋의 보류 중인 변경을 버리고 시퀀스를 계속합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃此提交待处理的更改并继续操作序列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄此提交待處理的變更並繼續操作序列。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta le modifiche in sospeso di questo commit e continua la sequenza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzuć oczekujące zmiany tego commita i kontynuuj sekwencję."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerp de openstaande wijzigingen van deze commit en ga door met de reeks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar as alterações pendentes deste commit e continuar a sequência."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu commitin bekleyen değişikliklerini at ve diziye devam et."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasta denna commits väntande ändringar och fortsätt sekvensen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбросить ожидающие изменения этого коммита и продолжить последовательность."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкинути зміни цього коміту, що очікують застосування, і продовжити послідовність."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งการเปลี่ยนแปลงที่ค้างอยู่ของ commit นี้แล้วทำลำดับต่อ"
          }
        }
      }
    },
