    "Someone else merges a pull request on your repositories; the notification says who.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else merges a pull request on your repositories; the notification says who."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo jiný sloučí žádost o začlenění ve vašich repozitářích; oznámení uvede kdo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes führt einen Pull Request in deinen Repositorys zusammen; die Mitteilung sagt, wer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona fusiona una pull request en tus repositorios; la notificación indica quién."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre fusionne une pull request sur vos dépôts ; la notification indique qui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro integra una pull request nei tuoi repository; la notifica indica chi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki más egyesít egy beolvasztási kérelmet az Ön tárolóiban; az értesítés megmondja, ki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand anders voegt een pullrequest samen in je repository’s; de melding zegt wie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś inny scala pull request w Twoich repozytoriach; powiadomienie mówi, kto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa mescla um pull request nos seus repositórios; a notificação diz quem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon annan slår samman en pull request i dina förråd; notisen säger vem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka biri depolarınızda bir birleştirme isteğini birleştirir; bildirim kim olduğunu söyler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то другой сливает запрос на слияние в ваших репозиториях; в уведомлении сказано, кто."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось інший зливає запит на злиття у ваших репозиторіях; у сповіщенні сказано, хто."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人があなたのリポジトリでプルリクエストをマージしたとき。誰がマージしたかが通知に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 내 저장소의 풀 리퀘스트를 병합할 때. 알림에 누가 병합했는지 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人合并了你仓库中的拉取请求时；通知会显示是谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人合併了你儲存庫中的提取要求時；通知會顯示是誰。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคนอื่น merge pull request ใน repository ของคุณ การแจ้งเตือนจะบอกว่าเป็นใคร"
          }
        }
      }
    },
    "Someone else opens a pull request on a repository you have open in Gitā.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else opens a pull request on a repository you have open in Gitā."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Někdo jiný otevře žádost o začlenění v repozitáři, který máte otevřený v Gitā."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes öffnet einen Pull Request in einem Repository, das du in Gitā geöffnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra persona abre una pull request en un repositorio que tienes abierto en Gitā."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un d’autre ouvre une pull request sur un dépôt que vous avez ouvert dans Gitā."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcun altro apre una pull request in un repository che hai aperto in Gitā."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valaki más beolvasztási kérelmet nyit egy olyan tárolóban, amely meg van nyitva a Gitā-ban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemand anders opent een pullrequest in een repository die je in Gitā open hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktoś inny otwiera pull request w repozytorium, które masz otwarte w Gitā."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa abre um pull request em um repositório que você tem aberto no Gitā."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Någon annan öppnar en pull request i ett förråd som du har öppet i Gitā."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka biri, Gitā'da açık olan bir deponuzda birleştirme isteği açar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то другой открывает запрос на слияние в репозитории, открытом у вас в Gitā."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хтось інший відкриває запит на злиття в репозиторії, відкритому у вас у Gitā."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā で開いているリポジトリで、ほかの人がプルリクエストを作成したとき。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā에서 열려 있는 저장소에 다른 사람이 풀 리퀘스트를 열 때."
          }
        },
        "zh-Hans": {
          "stringUnit": {
