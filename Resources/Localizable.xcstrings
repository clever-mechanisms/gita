    "Unstage changes; keep working files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unstage changes; keep working files."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat změny z připravených; zachovat pracovní soubory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar cambios del índice; conservar archivos de trabajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen aus dem Index entfernen; Arbeitsdateien behalten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előkészítés visszavonása; munkafájlok megtartása."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désindexer les modifications ; conserver les fichiers de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更のステージを解除し、作業ファイルを保持します。"
