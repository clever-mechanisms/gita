    "All commits from this branch will be added to the base branch via a merge commit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All commits from this branch will be added to the base branch via a merge commit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny commity z této větve budou přidány do základní větve slučovacím commitem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Commits aus diesem Branch werden über einen Merge-Commit in den Basis-Branch übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los commits de esta rama se añadirán a la rama base mediante un commit de fusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les commits de cette branche seront ajoutés à la branche de base par un commit de fusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i commit di questo branch verranno aggiunti al branch base tramite un commit di merge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág összes commitja egy merge commiton keresztül kerül az alapágba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle commits van deze branch worden via een samenvoegcommit aan de basisbranch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie commity z tej gałęzi zostaną dodane do gałęzi bazowej przez commit scalający."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os commits deste branch serão adicionados ao branch base por meio de um commit de mesclagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla commits från den här grenen läggs till i basgrenen via en sammanslagningscommit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dalın tüm commit'leri bir birleştirme commit'iyle temel dala eklenecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все коммиты из этой ветки будут добавлены в базовую ветку через merge-коммит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі коміти з цієї гілки буде додано до базової гілки через merge-коміт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチのすべてのコミットがマージコミットでベースブランチに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치의 모든 커밋이 병합 커밋을 통해 베이스 브랜치에 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的所有提交将通过合并提交添加到基础分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的所有提交將透過合併提交加入基礎分支。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ทั้งหมดจาก branch นี้จะถูกเพิ่มไปยัง base branch ด้วย merge commit"
          }
        }
      }
    },
