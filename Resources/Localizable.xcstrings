    "Discard %lld changed lines in %@?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit %lld změněných řádků v %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld geänderte Zeilen in %@ verwerfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard %lld changed lines in %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar %lld líneas modificadas en %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner %1$lld lignes modifiées dans %2$@ ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elvet %1$lld módosított sort ebben a fájlban: %2$@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartare %1$lld righe modificate in %2$@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の変更された %1$lld 行を破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에서 변경된 %1$lld줄을 버릴까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gewijzigde regels in %@ verwerpen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić %lld zmienionych wierszy w %@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar %lld linhas alteradas em %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отбросить %lld изменённой строки в %@?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasta %lld ändrade rader i %@?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิ้งบรรทัดที่เปลี่ยนแปลง %lld บรรทัดใน %@ หรือ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ içindeki %1$lld değişen satır atılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкинути %lld зміненого рядка у %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要丢弃 %2$@ 中的 %1$lld 行更改吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要捨棄 %2$@ 中的 %1$lld 行變更嗎？"
          }
        }
      }
    },
