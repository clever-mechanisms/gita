          }
        }
      }
    },
    "The replacement app did not open in time. Try restarting again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová instance aplikace se neotevřela včas. Zkuste restartovat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ersatz-App wurde nicht rechtzeitig geöffnet. Versuche den Neustart erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The replacement app did not open in time. Try restarting again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de sustitución no se abrió a tiempo. Intenta reiniciar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app de remplacement ne s’est pas ouverte à temps. Réessayez de redémarrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás új példánya nem nyílt meg időben. Próbálja újra az újraindítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app sostitutiva non si è aperta in tempo. Prova di nuovo a riavviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動先のアプリが時間内に開きませんでした。再起動を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시작할 앱이 제한 시간 안에 열리지 않았습니다. 다시 시작을 재시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervangende app is niet op tijd geopend. Probeer opnieuw te herstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępcza aplikacja nie otworzyła się na czas. Spróbuj uruchomić ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app substituto não abriu a tempo. Tente reiniciar novamente."
          }
        },
        "ru": {
