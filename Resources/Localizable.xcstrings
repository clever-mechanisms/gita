    "Merge every conflict whose sides change different lines or words": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučit každý konflikt, jehož strany mění různé řádky nebo slova"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Konflikt zusammenführen, dessen Seiten verschiedene Zeilen oder Wörter ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge every conflict whose sides change different lines or words"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionar cada conflicto cuyos lados cambian líneas o palabras distintas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner chaque conflit dont les côtés modifient des lignes ou des mots différents"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden olyan ütközés egyesítése, amelynek oldalai különböző sorokat vagy szavakat módosítanak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci ogni conflitto i cui lati modificano righe o parole diverse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側が異なる行または単語を変更しているすべての競合をマージ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽이 서로 다른 줄이나 단어를 변경한 모든 충돌 병합"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg elk conflict samen waarvan de kanten verschillende regels of woorden wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scal każdy konflikt, którego strony zmieniają różne wiersze lub słowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclar todo conflito cujos lados alteram linhas ou palavras diferentes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить все конфликты, стороны которых изменяют разные строки или слова"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå samman varje konflikt vars sidor ändrar olika rader eller ord"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "merge ทุก conflict ที่แต่ละฝ่ายแก้ต่างบรรทัดหรือต่างคำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taraflarının farklı satırları veya sözcükleri değiştirdiği tüm çakışmaları birleştir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злити всі конфлікти, сторони яких змінюють різні рядки чи слова"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并两侧更改了不同行或字词的所有冲突"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併兩側變更了不同行或字詞的所有衝突"
