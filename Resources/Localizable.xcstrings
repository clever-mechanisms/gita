    "Claude Code, Codex and others, by branch and by state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex and others, by branch and by state."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex a další podle větve a stavu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex und andere, nach Branch und Status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex y otros, por rama y por estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex et d’autres, par branche et par état."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex és mások, ág és állapot szerint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex e altri, per ramo e per stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex などをブランチ別・状態別に表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex 등을 브랜치별, 상태별로 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex en andere, per branch en per status."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex i inne, według gałęzi i stanu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex e outros, por branch e por estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex и другие — по веткам и состояниям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex och andra, per gren och status."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex ve diğerleri, dala ve duruma göre."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex та інші — за гілками й станами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex 等，按分支和状态显示。"
