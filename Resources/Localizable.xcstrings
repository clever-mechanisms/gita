    "Commit needs staged changes and a message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit needs staged changes and a message"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zápis revize vyžaduje připravené změny a zprávu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El commit necesita cambios preparados y un mensaje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Commit benötigt gestagte Änderungen und eine Nachricht"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A commithoz előkészített változások és üzenet szükséges"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commit nécessite des modifications indexées et un message"
