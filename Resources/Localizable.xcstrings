            "value": "Sağlayıcı öğesinin kimliği geçersiz. Listesini yenileyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ідентифікатор елемента провайдера неприпустимий. Оновіть список і спробуйте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务项目的标识无效。请刷新列表后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務項目的識別資訊無效。請重新整理列表後再試。"
          }
        }
      }
    },
    "The pull request changed since it was loaded. Refresh and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádost o začlenění se od načtení změnila. Obnovte a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pull Request hat sich seit dem Laden geändert. Aktualisiere und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pull request changed since it was loaded. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request cambió desde que se cargó. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request a changé depuis son chargement. Actualisez et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beolvasztási kérelem megváltozott a betöltés óta. Frissítsen, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pull request è cambiata dal caricamento. Aggiorna e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み後にプルリクエストが変更されました。更新してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로드한 후 풀 리퀘스트가 변경되었습니다. 새로 고친 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pullrequest is gewijzigd sinds het laden. Vernieuw en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request zmienił się od wczytania. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pull request mudou desde que foi carregado. Atualize e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на слияние изменился после загрузки. Обновите и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull requesten har ändrats sedan den lästes in. Uppdatera och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "pull request เปลี่ยนไปตั้งแต่โหลด ให้รีเฟรชแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirme isteği yüklendikten sonra değişti. Yenileyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит на злиття змінився після завантаження. Оновіть і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取请求在载入后已更改。请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提取要求在載入後已變更。請重新整理後再試一次。"
          }
        }
      }
    },
    "The pull request hasn’t loaded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádost o začlenění se nenačetla."
          }
        },
        "de": {
