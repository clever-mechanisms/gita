            "value": "サインイン中の GitHub アカウントで %@ を参照できるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 GitHub 계정 중 %@을(를) 볼 수 있는 계정이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel aangemeld GitHub-account kan %@ zien."
