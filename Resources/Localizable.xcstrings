    "%@\nReload to review this range again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNačtěte znovu a zkontrolujte tento rozsah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nNeu laden, um diesen Bereich erneut zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nReload to review this range again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nVuelve a cargar para revisar este intervalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nRechargez pour examiner à nouveau cette plage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nA tartomány újbóli ellenőrzéséhez töltse újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nRicarica per esaminare di nuovo questo intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n再読み込みしてこの範囲を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n다시 로드하여 이 범위를 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLaad opnieuw om dit bereik nogmaals te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nWczytaj ponownie, aby jeszcze raz sprawdzić ten zakres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nRecarregue para revisar este intervalo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nПерезагрузите, чтобы проверить этот диапазон снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLäs in igen för att granska intervallet på nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nโหลดใหม่เพื่อรีวิวช่วงนี้ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nBu aralığı yeniden incelemek için yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nПерезавантажте, щоб перевірити цей діапазон знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n请重新载入以再次检查此范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n請重新載入以再次檢查此範圍。"
          }
