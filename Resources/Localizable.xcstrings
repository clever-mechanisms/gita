            "state": "translated",
            "value": "Nachricht, Dateien und Prüfungen unter dem Verlauf. ⌘D"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje, los archivos y las comprobaciones bajo el historial. ⌘D"
