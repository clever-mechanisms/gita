    "Search commits that added, removed, or changed code matching a pattern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search commits that added, removed, or changed code matching a pattern."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledat revize, které přidaly, odebraly nebo změnily kód odpovídající vzoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche Commits, die Code passend zu einem Muster hinzugefügt, entfernt oder geändert haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca commits que hayan añadido, eliminado o modificado código coincidente con un patrón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez les commits ayant ajouté, supprimé ou modifié du code correspondant à un motif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca i commit che hanno aggiunto, rimosso o modificato codice corrispondente a un pattern."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mintának megfelelő kódot hozzáadó, eltávolító vagy módosító commitok keresése."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek commits die code hebben toegevoegd, verwijderd of gewijzigd die overeenkomt met een patroon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szukaj commitów, które dodały, usunęły lub zmieniły kod pasujący do wzorca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise commits que adicionaram, removeram ou alteraram código correspondente a um padrão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök commits som lade till, tog bort eller ändrade kod som matchar ett mönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหา commit ที่เพิ่ม ลบ หรือแก้ไขโค้ดที่ตรงกับรูปแบบที่ระบุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir desenle eşleşen kodu ekleyen, kaldıran veya değiştiren commitleri arayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск коммитов, которые добавляли, удаляли или изменяли код по шаблону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукати коміти, що додали, видалили або змінили код за шаблоном."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パターンに一致するコードを追加・削除・変更したコミットを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴과 일치하는 코드를 추가, 제거 또는 변경한 커밋을 검색합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
