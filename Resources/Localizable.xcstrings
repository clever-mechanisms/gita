    "Bad and Good commits must be different.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad and Good commits must be different."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybná a dobrá revize se musí lišit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlerhafter und guter Commit müssen unterschiedlich sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los commits Malo y Bueno deben ser distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commits Mauvais et Bon doivent être différents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I commit Difettoso e Funzionante devono essere diversi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Hibás és a Jó commitnak különbözőnek kell lennie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De slechte en goede commit moeten verschillend zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commity Błędny i Dobry muszą być różne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os commits Ruim e Bom devem ser diferentes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den felaktiga och den fungerande commiten måste vara olika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ที่เสียและ commit ที่ดีต้องเป็นคนละ commit กัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatalı ve Sağlam commitler farklı olmalıdır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плохой и хороший коммиты должны различаться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поганий і добрий коміти мають бути різними."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad コミットと Good コミットは別のコミットである必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁨 커밋과 좋음 커밋은 서로 달라야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "异常提交和正常提交必须不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "異常提交與正常提交必須不同。"
          }
        }
      }
    },
