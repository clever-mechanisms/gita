            "value": "Posledních 30 nasazení z projektu Vercel propojeného s tímto repozitářem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten 30 Bereitstellungen des mit diesem Repository verknüpften Vercel-Projekts."
          }
