    "Git's remaining rebase plan changed outside this review. Abort it or finish it with Git.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git's remaining rebase plan changed outside this review. Abort it or finish it with Git."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající plán přesazení Gitu se změnil mimo tuto kontrolu. Přerušte jej nebo dokončete pomocí Gitu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de rebase restante de Git cambió fuera de esta revisión. Abórtalo o termínalo con Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbleibende Git-Rebase-Plan wurde außerhalb dieser Prüfung geändert. Brich ihn ab oder beende ihn mit Git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git hátralévő újraalapozási terve az ellenőrzésen kívül megváltozott. Szakítsa meg vagy fejezze be a Gittel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan de rebase restant de Git a changé hors de cet examen. Abandonnez-le ou terminez-le avec Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git の残りのリベース計画がこの確認画面の外で変更されました。中止するか Git で完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 Git 리베이스 계획이 이 검토 밖에서 변경되었습니다. 중단하거나 Git으로 완료하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 剩余的变基计划已在此检查界面之外更改。请中止或使用 Git 完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 剩餘的重定基底計畫已在此檢查介面之外變更。請中止或使用 Git 完成。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano di rebase rimanente di Git è cambiato al di fuori di questa revisione. Interrompilo o terminalo con Git."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostały plan zmiany bazy Git zmienił się poza tym przeglądem. Przerwij go lub dokończ za pomocą Git."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resterende rebaseplan van Git is buiten deze beoordeling gewijzigd. Breek het af of voltooi het met Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano de rebase restante do Git mudou fora desta revisão. Aborte-o ou conclua-o com o Git."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git'in kalan yeniden temellendirme planı bu inceleme dışında değişti. İşlemi durdurun veya Git ile tamamlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gits återstående rebaseplan ändrades utanför denna granskning. Avbryt den eller slutför den med Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставшийся план перебазирования Git изменён вне этой проверки. Прервите перебазирование или завершите его средствами Git."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решту плану перебазовування Git змінено поза цією перевіркою. Перервіть перебазовування або завершіть його засобами Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผน rebase ที่เหลือของ Git เปลี่ยนไปนอกการรีวิวนี้ ให้ยกเลิกหรือทำต่อด้วย Git"
          }
        }
      }
    },
