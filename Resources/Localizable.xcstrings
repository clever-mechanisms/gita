    "Clean selected branches and worktrees?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean selected branches and worktrees?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyčistit vybrané větve a pracovní stromy?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Branches und Worktrees bereinigen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Limpiar las ramas y árboles de trabajo seleccionados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer les branches et arbres de travail sélectionnés ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulire i rami e gli alberi di lavoro selezionati?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tisztítja a kijelölt ágakat és munkafákat?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde branches en worktrees opruimen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyścić zaznaczone gałęzie i drzewa robocze?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar as branches e árvores de trabalho selecionadas?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa markerade grenar och worktrees?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างข้อมูล branch และ worktree ที่เลือกหรือไม่?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili dallar ve çalışma ağaçları temizlensin mi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить выбранные ветки и рабочие деревья?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистити вибрані гілки та робочі дерева?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したブランチとワークツリーをクリーンアップしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
