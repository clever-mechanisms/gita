    "GitHub didn’t say which account loaded this pull request. Refresh and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub neuvedl, který účet načetl tuto žádost o začlenění. Obnovte a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat nicht angegeben, welches Konto diesen Pull Request geladen hat. Aktualisiere und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub didn’t say which account loaded this pull request. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no indicó qué cuenta cargó esta pull request. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas indiqué quel compte a chargé cette pull request. Actualisez et réessayez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub nem közölte, melyik fiók töltötte be ezt a beolvasztási kérelmet. Frissítsen, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
