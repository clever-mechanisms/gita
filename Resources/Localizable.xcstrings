    "Compact loose objects and packfiles to reclaim space in .git.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact loose objects and packfiles to reclaim space in .git."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučí volné objekty a balíčky pro uvolnění místa v .git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimiert lose Objekte und Packfiles, um Speicherplatz in .git freizugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta objetos sueltos y archivos pack para recuperar espacio en .git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacte les objets isolés et les fichiers pack pour libérer de l’espace dans .git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatta oggetti sciolti e packfile per recuperare spazio in .git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tömöríti a laza objektumokat és csomagfájlokat a .git helyfelszabadításához."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimeert losse objecten en packfiles om ruimte vrij te maken in .git."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompaktuje luźne obiekty i pliki pack, aby odzyskać miejsce w .git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacta objetos soltos e arquivos pack para recuperar espaço em .git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimerar lösa objekt och packfiler för att frigöra utrymme i .git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บีบอัดอ็อบเจกต์อิสระและไฟล์แพ็กเพื่อเรียกคืนพื้นที่ใน .git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".git içinde alan açmak için dağınık nesneleri ve paket dosyalarını sıkıştırır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковывает свободные объекты и pack-файлы для освобождения места в .git."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковує окремі об’єкти та pack-файли, щоб звільнити місце у .git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーズオブジェクトとパックファイルを圧縮して .git の容量を回収します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느슨한 개체와 팩 파일을 압축하여 .git 공간을 확보합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩松散对象和包文件以回收 .git 空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮鬆散物件與封包檔案以回收 .git 空間。"
          }
        }
      }
    },
