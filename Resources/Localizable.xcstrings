    "Custom hook active: %@. Gitā will not overwrite it without confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom hook active: %@. Gitā will not overwrite it without confirmation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní vlastní hook: %@. Gitā jej bez potvrzení nepřepíše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigener Hook aktiv: %@. Gitā überschreibt ihn nicht ohne Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook personalizado activo: %@. Gitā no lo sobrescribirá sin confirmación."
          }
        },
