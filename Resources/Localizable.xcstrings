        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取期間連結的 Vercel 專案已變更。請重新整理以載入其部署。"
          }
        }
      }
    },
    "The local branch is not directly behind that commit, so it cannot move there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní větev není přímo za touto revizí, takže ji tam nelze posunout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Branch liegt nicht direkt hinter diesem Commit und kann daher nicht dorthin vorrücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local branch is not directly behind that commit, so it cannot move there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama local no está directamente por detrás de ese commit, así que no puede moverse allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche locale n’est pas directement en retard sur ce commit, elle ne peut donc pas s’y déplacer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi ág nem közvetlenül a commit mögött van, ezért nem léphet oda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo locale non è direttamente indietro rispetto a quel commit, quindi non può spostarsi lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルブランチがそのコミットの直接の祖先ではないため、そこまで進めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 브랜치가 그 커밋의 바로 뒤에 있지 않으므로 그곳으로 이동할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale branch staat niet direct achter die commit en kan daar dus niet naartoe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna gałąź nie jest bezpośrednio za tym commitem, więc nie można jej tam przesunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branch local não está diretamente atrás desse commit, então não pode ser movida até ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная ветка не отстаёт напрямую от этого коммита, поэтому её нельзя туда передвинуть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala grenen ligger inte direkt bakom den commiten, så den kan inte flyttas dit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "branch ในเครื่องไม่ได้อยู่หลัง commit นั้นโดยตรง จึงย้ายไปที่นั่นไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel dal doğrudan o commitin gerisinde değil, bu yüzden oraya taşınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна гілка не є прямим попередником цього коміту, тож її не можна туди пересунути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支并非直接落后于该提交，因此无法前移到那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機分支並非直接落後於該提交，因此無法前移到那裡。"
          }
        }
      }
    },
