          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не удалось удалить локальную конфигурацию удалённого репозитория. Перезагрузите конфигурацию и ссылки отслеживания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git kunde inte ta bort den lokala fjärrarkivskonfigurationen. Läs in konfigurationen och spårningsreferenserna igen."
          }
