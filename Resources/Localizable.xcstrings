    "The untracked file is deleted permanently.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesledovaný soubor bude trvale smazán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nicht verfolgte Datei wird endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The untracked file is deleted permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo sin seguimiento se eliminará de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier non suivi sera supprimé définitivement."
          }
        },
