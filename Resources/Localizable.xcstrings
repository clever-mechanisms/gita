          "stringUnit": {
            "state": "translated",
            "value": "捨棄已追蹤檔案中的已暫存變更和工作區變更。"
          }
        }
      }
    },
    "Discard this commit’s pending changes and continue the sequence.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit nevyřízené změny této revize a pokračovat v posloupnosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Änderungen dieses Commits verwerfen und Sequenz fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this commit’s pending changes and continue the sequence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar los cambios pendientes de este commit y continuar la secuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications en attente de ce commit et poursuivre la séquence."
