    "Draw a squash-merged branch joining its squash commit.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykreslit větev sloučenou pomocí squash, jak ústí do své squash revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet einen per Squash gemergten Branch, der in seinen Squash-Commit mündet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a squash-merged branch joining its squash commit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujar una rama fusionada con squash uniéndose a su commit de squash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner une branche fusionnée par squash rejoignant son commit squash."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A squash egyesítéssel beolvasztott ág rajzolása, ahogy a squash commitjába fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna un ramo unito con squash che confluisce nel suo commit squash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカッシュマージされたブランチを、そのスカッシュコミットに合流する形で描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스쿼시 병합된 브랜치가 해당 스쿼시 커밋으로 합류하도록 그립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken een squash-gemergde branch die in zijn squashcommit uitkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuj gałąź scaloną przez squash jako dołączającą do jej commita squash."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhar uma branch mesclada com squash se unindo ao seu commit de squash."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисовать ветку, слитую через squash, впадающей в её squash-коммит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita en squash-sammanslagen gren som ansluter till sin squash-commit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาด branch ที่ squash merge แล้วเชื่อมกับ commit ที่ squash ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash ile birleştirilmiş bir dalı, squash commitine katılırken çiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малювати гілку, злиту через squash, такою, що вливається у свій squash-коміт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将压缩合并的分支绘制为汇入其压缩提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將壓縮合併的分支繪製為匯入其壓縮提交。"
          }
        }
      }
    },
