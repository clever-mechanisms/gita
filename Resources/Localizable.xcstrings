    "Use Git’s built-in filesystem monitor to speed up working tree checks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Git’s built-in filesystem monitor to speed up working tree checks."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije vestavěné sledování souborového systému v Gitu pro zrychlení kontrol pracovního stromu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den integrierten Dateisystem-Monitor von Git für schnellere Arbeitsbaum-Prüfungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el monitor de sistema de archivos integrado de Git para acelerar las comprobaciones del árbol de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le moniteur de système de fichiers intégré de Git pour accélérer la vérification de la copie de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il monitor del file system integrato in Git per velocizzare il controllo dell’albero di lavoro."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git beépített fájlrendszer-figyelőjével gyorsítja a munkafa ellenőrzését."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de ingebouwde bestandssysteemmonitor van Git om werkmapcontroles te versnellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa wbudowanego monitora systemu plików Gita, aby przyspieszyć sprawdzanie drzewa roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o monitor de sistema de arquivos integrado do Git para acelerar a verificação da árvore de trabalho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder Gits inbyggda filsystemsövervakare för snabbare kontroller av arbetsträdet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตัวตรวจสอบระบบไฟล์ในตัวของ Git เพื่อเร่งความเร็วการตรวจสอบเวิร์กทรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ağacı kontrollerini hızlandırmak için Git’in yerleşik dosya sistemi izleyicisini kullanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует встроенный монитор файловой системы Git для ускорения проверки рабочего дерева."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вбудований монітор файлової системи Git для пришвидшення перевірки робочого дерева."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 組み込みのファイルシステムモニターを使って作業ツリーの確認を高速化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git의 내장 파일 시스템 모니터를 사용하여 작업 트리 확인 속도를 높입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Git 内置的文件系统监视器以加快工作树检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Git 內建的檔案系統監視器以加快工作樹檢查。"
          }
        }
      }
    },
