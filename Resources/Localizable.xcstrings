          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un remoto con este nombre o espacio de seguimiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Remote verwendet bereits diesen Namen oder Tracking-Namensraum."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy távoli tároló már használja ezt a nevet vagy követési névteret."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dépôt distant utilise déjà ce nom ou cet espace de suivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前または追跡用の名前空間は別のリモートで使用中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 원격 저장소가 이 이름이나 추적 네임스페이스를 사용 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有远程仓库使用此名称或跟踪命名空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有遠端版本庫使用此名稱或追蹤命名空間。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un remoto usa già questo nome o spazio dei nomi di tracciamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne repozytorium używa już tej nazwy lub przestrzeni nazw śledzenia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een remote gebruikt deze naam of trackingnaamruimte al."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um remoto já usa este nome ou espaço de rastreamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uzak depo bu adı veya izleme ad alanını zaten kullanıyor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fjärrarkiv använder redan detta namn eller spårningsnamnrymd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённый репозиторий уже использует это имя или пространство имён отслеживания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалений репозиторій уже використовує це ім’я або простір імен відстеження."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี remote ใช้ชื่อนี้หรือ tracking namespace นี้อยู่แล้ว"
          }
        }
      }
    },
    "A squash merge lands as one ordinary commit, so its branch looks unmerged. On, Gitā draws the branch joining its squash commit, like a merge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A squash merge lands as one ordinary commit, so its branch looks unmerged. On, Gitā draws the branch joining its squash commit, like a merge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash sloučení se zapíše jako jeden běžný commit, takže jeho větev vypadá nesloučeně. Je-li zapnuto, Gitā vykreslí větev, jak ústí do svého squash commitu, stejně jako u sloučení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Squash-Merge landet als ein gewöhnlicher Commit, daher wirkt sein Branch nicht zusammengeführt. Eingeschaltet zeichnet Gitā den Branch, wie er in seinen Squash-Commit mündet – wie bei einem Merge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fusión squash llega como un único commit normal, por lo que su rama parece sin fusionar. Si está activado, Gitā dibuja la rama uniéndose a su commit de squash, como una fusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fusion squash arrive sous la forme d’un seul commit ordinaire : sa branche semble donc non fusionnée. Si l’option est activée, Gitā dessine la branche rejoignant son commit squash, comme une fusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un merge squash arriva come un unico commit ordinario, quindi il suo ramo sembra non unito. Se attivo, Gitā disegna il ramo che confluisce nel suo commit squash, come un merge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A squash egyesítés egyetlen közönséges commitként érkezik, ezért az ága egyesítetlennek tűnik. Bekapcsolva a Gitā úgy rajzolja az ágat, ahogy a squash commitjába fut, mint egy egyesítésnél."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een squash-merge landt als één gewone commit, zodat zijn branch niet samengevoegd lijkt. Aan: Gitā tekent de branch die in zijn squashcommit uitkomt, net als een merge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalenie squash trafia jako jeden zwykły commit, więc jego gałąź wygląda na niescaloną. Po włączeniu Gitā rysuje gałąź dołączającą do jej commita squash, jak przy scaleniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mesclagem squash chega como um único commit comum, então sua branch parece não mesclada. Quando ativado, o Gitā desenha a branch se unindo ao seu commit de squash, como uma mesclagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En squash-sammanslagning landar som en vanlig commit, så dess gren ser osammanslagen ut. På: Gitā ritar grenen som ansluter till sin squash-commit, som en sammanslagning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir squash birleştirme tek bir sıradan commit olarak gelir, bu yüzden dalı birleştirilmemiş görünür. Açık olduğunda Gitā, dalı bir birleştirme gibi squash commitine katılırken çizer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash-слияние попадает в историю как один обычный коммит, поэтому его ветка выглядит неслитой. Если включено, Gitā рисует ветку впадающей в её squash-коммит, как при слиянии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Squash-злиття потрапляє в історію як один звичайний коміт, тому його гілка виглядає незлитою. Якщо ввімкнено, Gitā малює гілку такою, що вливається у свій squash-коміт, як при злитті."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スカッシュマージは通常のコミット 1 つとして取り込まれるため、そのブランチは未マージに見えます。オンにすると、Gitā はマージと同じように、ブランチがスカッシュコミットに合流する形で描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스쿼시 병합은 일반 커밋 하나로 들어오므로 해당 브랜치가 병합되지 않은 것처럼 보입니다. 켜면 Gitā가 병합처럼 브랜치가 스쿼시 커밋으로 합류하도록 그립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩合并会以一个普通提交落地，因此其分支看起来像未合并。打开后，Gitā 会像合并一样，将分支绘制为汇入其压缩提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮合併會以一個普通提交落地，因此其分支看起來像未合併。開啟後，Gitā 會像合併一樣，將分支繪製為匯入其壓縮提交。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ squash merge จะกลายเป็น commit ปกติหนึ่งรายการ ทำให้ branch ดูเหมือนยังไม่ถูก merge เมื่อเปิด Gitā จะวาด branch เชื่อมกับ commit ที่ squash ไว้เหมือน merge"
          }
        }
      }
    },
    "A submodule has local changes. Resolve them before a hard reset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A submodule has local changes. Resolve them before a hard reset."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dílčí modul obsahuje místní změny. Před tvrdým resetem je vyřešte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un submódulo tiene cambios locales. Resuélvelos antes de un reset hard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Submodul hat lokale Änderungen. Löse sie vor einem Hard Reset auf."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy almodul helyi változásokat tartalmaz. A teljes visszaállítás előtt rendezze őket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sous-module présente des modifications locales. Résolvez-les avant un reset hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールにローカル変更があります。ハードリセットの前に解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 모듈에 로컬 변경 사항이 있습니다. 하드 리셋 전에 해결하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子模块有本地更改。请先解决，再执行硬重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子模組有本機變更。請先解決，再執行硬重設。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sottomodulo contiene modifiche locali. Risolvile prima di un reset hard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podmoduł zawiera lokalne zmiany. Rozwiąż je przed twardym resetem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een submodule heeft lokale wijzigingen. Los deze op vóór een harde reset."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um submódulo tem alterações locais. Resolva-as antes de um reset hard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir alt modülde yerel değişiklikler var. Sert sıfırlamadan önce bunları çözün."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En undermodul har lokala ändringar. Lös dem före en hård återställning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В подмодуле есть локальные изменения. Разберите их перед жёстким сбросом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У підмодулі є локальні зміни. Опрацюйте їх перед жорстким скиданням."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "submodule มีการเปลี่ยนแปลงในเครื่อง ให้แก้ไขก่อนทำ hard reset"
          }
        }
      }
    },
    "A symbolic tracking reference is unsafe or unresolved. Repair it with Git before changing this remote.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A symbolic tracking reference is unsafe or unresolved. Repair it with Git before changing this remote."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolická sledovací reference je nebezpečná nebo nerozpoznaná. Před změnou vzdáleného repozitáře ji opravte pomocí Gitu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una referencia simbólica de seguimiento no es segura o no está resuelta. Repárala con Git antes de cambiar este remoto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine symbolische Tracking-Referenz ist unsicher oder nicht aufgelöst. Repariere sie mit Git, bevor du dieses Remote änderst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy szimbolikus követési hivatkozás nem biztonságos vagy nem oldható fel. A távoli tároló módosítása előtt javítsa a Gittel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une référence symbolique de suivi est dangereuse ou non résolue. Réparez-la avec Git avant de modifier ce dépôt distant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリック追跡参照が安全でないか未解決です。このリモートを変更する前に Git で修復してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 추적 참조가 안전하지 않거나 확인되지 않았습니다. 이 원격 저장소를 변경하기 전에 Git으로 복구하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号跟踪引用不安全或未解析。请先使用 Git 修复，再更改此远程仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符號追蹤參照不安全或未解析。請先使用 Git 修復，再更改此遠端版本庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riferimento simbolico di tracciamento non è sicuro o non è risolto. Riparalo con Git prima di modificare questo remoto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboliczna referencja śledząca jest niebezpieczna lub nierozwiązana. Napraw ją w Gicie przed zmianą zdalnego repozytorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een symbolische trackingreferentie is onveilig of niet opgelost. Herstel deze met Git voordat je deze remote wijzigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma referência simbólica de rastreamento é insegura ou não foi resolvida. Repare-a com o Git antes de alterar este remoto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembolik bir izleme referansı güvenli değil veya çözümlenemiyor. Bu uzak depoyu değiştirmeden önce Git ile onarın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En symbolisk spårningsreferens är osäker eller olöst. Reparera den med Git innan du ändrar detta fjärrarkiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символическая ссылка отслеживания небезопасна или не разрешена. Исправьте её средствами Git перед изменением этого удалённого репозитория."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символічне посилання відстеження небезпечне або нерозв’язане. Виправте його засобами Git перед зміною цього віддаленого репозиторію."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "symbolic tracking reference ไม่ปลอดภัยหรือยังแก้ไม่เสร็จ ให้ซ่อมด้วย Git ก่อนเปลี่ยน remote นี้"
          }
        }
      }
    },
    "A terminal is open in this window. Closing it ends the program running in it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal is open in this window. Closing it ends the program running in it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tomto okně je otevřený terminál. Jeho zavřením ukončíte program, který v něm běží."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un terminal abierto en esta ventana. Al cerrarlo termina el programa que se ejecuta en él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Fenster ist ein Terminal geöffnet. Beim Schließen wird das darin laufende Programm beendet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy terminál van nyitva ebben az ablakban. Bezárásával leáll a benne futó program."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un terminal est ouvert dans cette fenêtre. Le fermer met fin au programme qui s’y exécute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウでターミナルが開いています。閉じると、その中で実行中のプログラムが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 윈도우에 터미널이 열려 있습니다. 닫으면 터미널에서 실행 중인 프로그램이 종료됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口中有一个终端处于打开状态。关闭它将结束其中运行的程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗中有一個終端機處於打開狀態。關閉它將結束其中執行的程式。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa finestra è aperto un terminale. Chiudendolo termina il programma in esecuzione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym oknie jest otwarty terminal. Jego zamknięcie zakończy działający w nim program."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een terminal open in dit venster. Als je die sluit, wordt het programma dat erin draait beëindigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um terminal aberto nesta janela. Fechá-lo encerra o programa em execução nele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencerede bir terminal açık. Kapatmak, içinde çalışan programı sonlandırır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En terminal är öppen i det här fönstret. Om du stänger den avslutas programmet som körs i den."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом окне открыт терминал. При его закрытии запущенная в нём программа завершится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому вікні відкрито термінал. Якщо його закрити, програму, що в ньому виконується, буде завершено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี Terminal เปิดอยู่ในหน้าต่างนี้ การปิดจะยุติโปรแกรมที่กำลังทำงานอยู่"
          }
        }
      }
    },
    "A tracked path changed during review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tracked path changed during review."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovaná cesta se během kontroly změnila."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
