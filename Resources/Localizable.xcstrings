          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado foi salvo, mas não pôde ser preparado. O arquivo salvo foi preservado. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат сохранён, но его не удалось добавить в индекс. Сохранённый файл не потерян. %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet sparades men kunde inte förberedas. Din sparade fil är bevarad. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกผลลัพธ์แล้วแต่ stage ไม่ได้ ไฟล์ที่บันทึกไว้ยังอยู่ %@"
