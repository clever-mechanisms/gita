          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub levert geen diff van deze omvang. Open de bestanden op GitHub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie zwraca tak dużych różnic. Otwórz pliki w GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não retorna um diff tão grande. Abra os arquivos no GitHub."
          }
        },
        "sv": {
