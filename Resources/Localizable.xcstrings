        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conflict changed on disk. Reload it before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conflicto cambió en el disco. Vuelve a cargarlo antes de guardar."
