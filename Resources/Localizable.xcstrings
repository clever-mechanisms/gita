    "Stage changes before generating a commit message.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage changes before generating a commit message."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před generováním zprávy revize nejprve připravte změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage Änderungen, bevor du eine Commit-Nachricht erzeugst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara los cambios antes de generar un mensaje de commit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexez des modifications avant de générer un message de commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara le modifiche prima di generare un messaggio di commit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Commitüzenet generálása előtt készítsen elő változásokat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet wijzigingen klaar voordat je een commitbericht genereert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zmiany do indeksu przed wygenerowaniem komunikatu commita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare alterações antes de gerar uma mensagem de commit."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbered ändringar innan du genererar ett commitmeddelande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "stage การเปลี่ยนแปลงก่อนสร้างข้อความ commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit iletisi oluşturmadan önce değişiklikleri hazırlayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте изменения в индекс перед генерацией сообщения коммита."
