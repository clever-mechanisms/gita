    "Messages must fit in 64 KiB and cannot contain NUL characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages must fit in 64 KiB and cannot contain NUL characters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zprávy musí mít nejvýše 64 KiB a nesmí obsahovat znaky NUL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes deben caber en 64 KiB y no pueden contener caracteres NUL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten dürfen höchstens 64 KiB groß sein und keine NUL-Zeichen enthalten."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzenetek legfeljebb 64 KiB méretűek lehetnek, és nem tartalmazhatnak NUL karaktert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages doivent tenir dans 64 KiB et ne peuvent pas contenir de caractères NUL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは 64 KiB 以内とし、NUL 文字を含めないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 64 KiB 이내여야 하며 NUL 문자를 포함할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息必须不超过 64 KiB，且不得包含 NUL 字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息必須不超過 64 KiB，且不得包含 NUL 字元。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi devono rientrare in 64 KiB e non possono contenere caratteri NUL."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunikaty muszą mieścić się w 64 KiB i nie mogą zawierać znaków NUL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten moeten binnen 64 KiB passen en mogen geen NUL-tekens bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens devem caber em 64 KiB e não podem conter caracteres NUL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletiler 64 KiB sınırını aşamaz ve NUL karakteri içeremez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden måste rymmas inom 64 KiB och får inte innehålla NUL-tecken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения должны помещаться в 64 КиБ и не содержать символов NUL."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення мають уміщуватися в 64 КіБ і не містити символів NUL."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความต้องมีขนาดไม่เกิน 64 KiB และห้ามมีอักขระ NUL"
          }
        }
      }
    },
