    "This will overwrite core.fsmonitor (%@) with Git’s built-in filesystem monitor in local config.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will overwrite core.fsmonitor (%@) with Git’s built-in filesystem monitor in local config."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto v místní konfiguraci přepíšete core.fsmonitor (%@) vestavěným sledováním souborového systému v Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird core.fsmonitor (%@) in der lokalen Konfiguration durch den integrierten Dateisystem-Monitor von Git überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sobrescribirá core.fsmonitor (%@) con el monitor integrado del sistema de archivos de Git en la configuración local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplacera core.fsmonitor (%@) par le moniteur de système de fichiers intégré de Git dans la configuration locale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione sovrascriverà core.fsmonitor (%@) con il monitor del filesystem integrato di Git nella configurazione locale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez felülírja a core.fsmonitor (%@) beállítást a Git beépített fájlrendszer-figyelőjével a helyi konfigurációban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt core.fsmonitor (%@) overschreven met de ingebouwde bestandssysteemmonitor van Git in de lokale configuratie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to nadpisanie core.fsmonitor (%@) wbudowanym monitorem systemu plików Git w konfiguracji lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso substituirá core.fsmonitor (%@) pelo monitor integrado do sistema de arquivos do Git na configuração local."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta skriver över core.fsmonitor (%@) med Gits inbyggda filsystemsövervakare i den lokala konfigurationen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะเขียนทับ core.fsmonitor (%@) ด้วยตัวเฝ้าดูระบบไฟล์ในตัวของ Git ในการตั้งค่าท้องถิ่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, yerel yapılandırmadaki core.fsmonitor (%@) ayarının üzerine Git’in yerleşik dosya sistemi izleyicisini yazacak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это перезапишет core.fsmonitor (%@) встроенным монитором файловой системы Git в локальной конфигурации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це перезапише core.fsmonitor (%@) вбудованим монітором файлової системи Git у локальній конфігурації."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル設定の core.fsmonitor (%@) を Git 組み込みのファイルシステムモニターで上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 구성의 core.fsmonitor(%@)를 Git 내장 파일 시스템 모니터로 덮어씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在本地配置中使用 Git 内置的文件系统监视器覆盖 core.fsmonitor（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將在本機設定中使用 Git 內建的檔案系統監視器覆蓋 core.fsmonitor（%@）。"
          }
        }
      }
    },
    "This worktree changed. Review it again before removing it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento pracovní strom se změnil. Před odstraněním jej zkontrolujte znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Worktree hat sich geändert. Prüfe ihn erneut vor dem Entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This worktree changed. Review it again before removing it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este árbol de trabajo cambió. Revísalo de nuevo antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet arbre de travail a changé. Examinez-le à nouveau avant de le supprimer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa megváltozott. Eltávolítás előtt ellenőrizze újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo albero di lavoro è cambiato. Esaminalo di nuovo prima di rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークツリーが変更されました。削除する前に再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 트리가 변경되었습니다. 제거하기 전에 다시 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze worktree is gewijzigd. Beoordeel deze opnieuw voordat je deze verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To drzewo robocze zmieniło się. Sprawdź je ponownie przed usunięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta árvore de trabalho mudou. Revise-a novamente antes de removê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это рабочее дерево изменилось. Проверьте его снова перед удалением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna worktree ändrades. Granska den igen innan du tar bort den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "worktree นี้เปลี่ยนไป ให้ตรวจดูอีกครั้งก่อนนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma ağacı değişti. Kaldırmadan önce yeniden inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це робоче дерево змінилося. Перевірте його знову перед видаленням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
