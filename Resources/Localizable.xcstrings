          "stringUnit": {
            "state": "translated",
            "value": "Hook personnalisé actif : %@. Gitā ne l’écrasera pas sans confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook personalizzato attivo: %@. Gitā non lo sovrascriverà senza conferma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyéni hook aktív: %@. A Gitā megerősítés nélkül nem írja felül."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste hook actief: %@. Gitā overschrijft deze niet zonder bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny własny hook: %@. Gitā nie nadpisze go bez potwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook personalizado ativo: %@. O Gitā não o substituirá sem confirmação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassad hook aktiv: %@. Gitā skriver inte över den utan bekräftelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการใช้ hook ที่กำหนดเองอยู่: %@ Gitā จะไม่เขียนทับโดยไม่ได้รับการยืนยัน"
          }
        },
        "tr": {
