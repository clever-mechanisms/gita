    "Hooks are unavailable for this copy of Gitā. Use the installed app in Applications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooky nejsou pro tuto kopii Gitā dostupné. Použijte nainstalovanou aplikaci ve složce Aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks sind für diese Kopie von Gitā nicht verfügbar. Verwende die installierte App im Ordner Programme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks are unavailable for this copy of Gitā. Use the installed app in Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks no están disponibles para esta copia de Gitā. Usa la app instalada en Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks ne sont pas disponibles pour cette copie de Gitā. Utilisez l’app installée dans Applications."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Gitā e példányánál nem érhetők el a hookok. Használja az Alkalmazások mappába telepített alkalmazást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook non sono disponibili per questa copia di Gitā. Usa l’app installata in Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Gitā ではフックを利用できません。アプリケーションフォルダのインストール済みアプリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Gitā 복사본에서는 훅을 사용할 수 없습니다. 응용 프로그램 폴더에 설치된 앱을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks zijn niet beschikbaar voor deze kopie van Gitā. Gebruik de geïnstalleerde app in Apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooki są niedostępne dla tej kopii Gitā. Użyj zainstalowanej aplikacji w folderze Aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hooks não estão disponíveis para esta cópia do Gitā. Use o app instalado em Aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки недоступны для этой копии Gitā. Используйте установленное приложение из папки «Программы»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks är inte tillgängliga för denna kopia av Gitā. Använd den installerade appen i Program."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "hook ใช้ไม่ได้กับ Gitā ชุดนี้ ให้ใช้แอปที่ติดตั้งใน Applications"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitā'ın bu kopyasında kancalar kullanılamıyor. Uygulamalar'daki yüklü uygulamayı kullanın."
          }
