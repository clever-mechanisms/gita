    "%@, the account chosen for this repository, can’t see it. Choose another account on the GitHub page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, účet vybraný pro tento repozitář, jej nevidí. Vyberte jiný účet na stránce GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, das für dieses Repository gewählte Konto, kann es nicht sehen. Wähle auf der GitHub-Seite ein anderes Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, the account chosen for this repository, can’t see it. Choose another account on the GitHub page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, la cuenta elegida para este repositorio, no puede verlo. Elige otra cuenta en la página de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, le compte choisi pour ce dépôt, ne peut pas le voir. Choisissez un autre compte dans la page GitHub."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tárolóhoz választott fiók (%@) nem látja a tárolót. Válasszon másik fiókot a GitHub oldalon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, l’account scelto per questo repository, non può vederlo. Scegli un altro account nella pagina GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリ用に選択したアカウント %@ はこのリポジトリを参照できません。GitHub ページで別のアカウントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소에 선택한 계정 %@은(는) 이 저장소를 볼 수 없습니다. GitHub 페이지에서 다른 계정을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, het account dat voor deze repository is gekozen, kan deze niet zien. Kies een ander account op de GitHub-pagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, konto wybrane dla tego repozytorium, nie widzi go. Wybierz inne konto na stronie GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a conta escolhida para este repositório, não consegue vê-lo. Escolha outra conta na página do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись %@, выбранная для этого репозитория, не видит его. Выберите другую учётную запись на странице GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kontot som valts för detta kodförråd, kan inte se det. Välj ett annat konto på GitHub-sidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ บัญชีที่เลือกไว้สำหรับ repository นี้ มองไม่เห็น repository ให้เลือกบัญชีอื่นในหน้า GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo için seçilen hesap (%@) depoyu göremiyor. GitHub sayfasında başka bir hesap seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис %@, вибраний для цього репозиторію, не має до нього доступу. Виберіть інший обліковий запис на сторінці GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此仓库选择的账户 %@ 无法访问它。请在 GitHub 页面上选择其他账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此版本庫選擇的帳號 %@ 無法存取它。請在 GitHub 頁面上選取其他帳號。"
          }
        }
      }
    },
    "%@, the account chosen for this repository, is not signed in to gh (%@). Sign in with GH_CONFIG_DIR=%@ gh auth login, or choose another account on the GitHub page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, účet vybraný pro tento repozitář, není přihlášen v gh (%@). Přihlaste se pomocí GH_CONFIG_DIR=%@ gh auth login nebo vyberte jiný účet na stránce GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, das für dieses Repository gewählte Konto, ist nicht bei gh (%@) angemeldet. Melde dich mit GH_CONFIG_DIR=%@ gh auth login an oder wähle auf der GitHub-Seite ein anderes Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, the account chosen for this repository, is not signed in to gh (%@). Sign in with GH_CONFIG_DIR=%@ gh auth login, or choose another account on the GitHub page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, la cuenta elegida para este repositorio, no tiene sesión iniciada en gh (%@). Inicia sesión con GH_CONFIG_DIR=%@ gh auth login o elige otra cuenta en la página de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, le compte choisi pour ce dépôt, n’est pas connecté à gh (%@). Connectez-vous avec GH_CONFIG_DIR=%@ gh auth login, ou choisissez un autre compte dans la page GitHub."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tárolóhoz választott fiók (%@) nincs bejelentkezve a gh-ba (%@). Jelentkezzen be a GH_CONFIG_DIR=%@ gh auth login paranccsal, vagy válasszon másik fiókot a GitHub oldalon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, l’account scelto per questo repository, non ha eseguito l’accesso a gh (%@). Accedi con GH_CONFIG_DIR=%@ gh auth login o scegli un altro account nella pagina GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリポジトリ用に選択したアカウント %@ は gh（%@）にサインインしていません。GH_CONFIG_DIR=%@ gh auth login でサインインするか、GitHub ページで別のアカウントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장소에 선택한 계정 %@은(는) gh(%@)에 로그인되어 있지 않습니다. GH_CONFIG_DIR=%@ gh auth login으로 로그인하거나 GitHub 페이지에서 다른 계정을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, het account dat voor deze repository is gekozen, is niet aangemeld bij gh (%@). Log in met GH_CONFIG_DIR=%@ gh auth login of kies een ander account op de GitHub-pagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, konto wybrane dla tego repozytorium, nie jest zalogowane w gh (%@). Zaloguj się za pomocą GH_CONFIG_DIR=%@ gh auth login lub wybierz inne konto na stronie GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, a conta escolhida para este repositório, não está com sessão iniciada no gh (%@). Inicie sessão com GH_CONFIG_DIR=%@ gh auth login ou escolha outra conta na página do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись %@, выбранная для этого репозитория, не авторизована в gh (%@). Войдите с помощью GH_CONFIG_DIR=%@ gh auth login или выберите другую учётную запись на странице GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kontot som valts för detta kodförråd, är inte inloggat i gh (%@). Logga in med GH_CONFIG_DIR=%@ gh auth login eller välj ett annat konto på GitHub-sidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ บัญชีที่เลือกไว้สำหรับ repository นี้ ยังไม่ได้ลงชื่อเข้าใช้ gh (%@) ให้ลงชื่อเข้าใช้ด้วย GH_CONFIG_DIR=%@ gh auth login หรือเลือกบัญชีอื่นในหน้า GitHub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo için seçilen hesap (%@) gh'de (%@) oturum açmamış. GH_CONFIG_DIR=%@ gh auth login ile oturum açın veya GitHub sayfasında başka bir hesap seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У gh не виконано вхід в обліковий запис %@, вибраний для цього репозиторію (%@). Увійдіть за допомогою GH_CONFIG_DIR=%@ gh auth login або виберіть інший обліковий запис на сторінці GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此仓库选择的账户 %@ 未登录 gh（%@）。请使用 GH_CONFIG_DIR=%@ gh auth login 登录，或在 GitHub 页面上选择其他账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此版本庫選擇的帳號 %@ 未登入 gh（%@）。請使用 GH_CONFIG_DIR=%@ gh auth login 登入，或在 GitHub 頁面上選取其他帳號。"
          }
        }
      }
    },
    "%@, the account chosen for this repository, is not signed in to gh. Sign in with gh auth login, or choose another account on the GitHub page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, účet vybraný pro tento repozitář, není přihlášen v gh. Přihlaste se pomocí gh auth login nebo vyberte jiný účet na stránce GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, das für dieses Repository gewählte Konto, ist nicht bei gh angemeldet. Melde dich mit gh auth login an oder wähle auf der GitHub-Seite ein anderes Konto."
          }
        },
        "en": {
          "stringUnit": {
