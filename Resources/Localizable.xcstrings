    "Read the providers again while a window is open.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu načítat data poskytovatelů, dokud je otevřené okno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anbieter erneut abfragen, solange ein Fenster geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the providers again while a window is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a leer los proveedores mientras haya una ventana abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relire les fournisseurs tant qu’une fenêtre est ouverte."
