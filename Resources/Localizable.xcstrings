          "stringUnit": {
            "state": "translated",
            "value": "最初の50件のジョブと各ジョブの最大200ステップを表示しています。全体は GitHub で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 50개 작업과 작업당 최대 200개 단계를 표시합니다. 전체 내용은 GitHub에서 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste 50 jobs en maximaal 200 stappen per job worden getoond. Open GitHub voor de volledige weergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlono pierwszych 50 zadań i do 200 kroków na zadanie. Otwórz GitHub, aby zobaczyć całość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibindo os primeiros 50 trabalhos e até 200 etapas por trabalho. Abra o GitHub para a visualização completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны первые 50 заданий и до 200 шагов на задание. Полный список доступен в GitHub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar de första 50 jobben och upp till 200 steg per jobb. Öppna GitHub för hela vyn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง job 50 รายการแรกและไม่เกิน 200 ขั้นต่อ job เปิด GitHub เพื่อดูทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk 50 iş ve her iş için en fazla 200 adım gösteriliyor. Tam görünüm için GitHub'ı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано перші 50 завдань і до 200 кроків на завдання. Повний список доступний у GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示前 50 个作业，每个作业最多 200 个步骤。请打开 GitHub 查看全部内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
