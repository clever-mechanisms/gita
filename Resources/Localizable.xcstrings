    "GitHub and Vercel are off: the history stays as it is.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a Vercel jsou vypnuté: historie zůstane taková, jaká je."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub und Vercel sind aus: Der Verlauf bleibt, wie er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub and Vercel are off: the history stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub y Vercel están desactivados: el historial se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub et Vercel sont désactivés : l’historique reste tel quel."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHub és a Vercel ki van kapcsolva: az előzmények változatlanok maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub e Vercel sono disattivati: la cronologia resta com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub と Vercel はオフです。履歴はそのまま表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub와 Vercel이 꺼져 있습니다. 기록은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub en Vercel staan uit: de geschiedenis blijft zoals ze is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub i Vercel są wyłączone: historia pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub e Vercel estão desativados: o histórico continua como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub и Vercel выключены: история остаётся как есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub och Vercel är avstängda: historiken förblir som den är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub และ Vercel ปิดอยู่: ประวัติจะคงเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ve Vercel kapalı: geçmiş olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub і Vercel вимкнено: історія залишається як є."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 和 Vercel 已关闭：历史保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 和 Vercel 已關閉：歷史保持原樣。"
          }
        }
      }
    },
    "GitHub did not accept the change. Refresh and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub změnu nepřijal. Obnovte a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat die Änderung nicht angenommen. Aktualisiere und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub did not accept the change. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no aceptó el cambio. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
