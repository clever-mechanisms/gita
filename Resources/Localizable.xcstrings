          "stringUnit": {
            "state": "translated",
            "value": "Git odmítne odstranit pracovní strom s neuloženými změnami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Git lehnt das Entfernen eines nicht sauberen Worktrees ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Git rechazará eliminar un árbol de trabajo con cambios sin guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git refusera de supprimer un arbre de travail contenant des modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Git rifiuterà di rimuovere un albero di lavoro con modifiche non salvate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git nem távolít el módosított munkafát."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git weigert een worktree met onopgeslagen wijzigingen te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Git odmówi usunięcia zmodyfikowanego drzewa roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Git recusará remover uma árvore de trabalho com alterações pendentes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git vägrar att ta bort en worktree med osparade ändringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Git จะไม่ลบ worktree ที่มีการแก้ไขค้างอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git, kaydedilmemiş değişiklik içeren bir çalışma ağacını kaldırmayı reddedecektir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Git не удалит рабочее дерево с незафиксированными изменениями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Git відмовиться видаляти робоче дерево з незбереженими змінами."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git は変更が残っているワークツリーの削除を拒否します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git은 변경 사항이 있는 작업 트리의 제거를 거부합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 将拒绝移除包含未提交更改的工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 將拒絕移除包含未提交變更的工作樹。"
          }
        }
      }
    },
    "Git's remaining rebase plan changed outside this review. Abort it or finish it with Git.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývající plán přesazení Gitu se změnil mimo tuto kontrolu. Přerušte jej nebo dokončete pomocí Gitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbleibende Git-Rebase-Plan wurde außerhalb dieser Prüfung geändert. Brich ihn ab oder beende ihn mit Git."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Git's remaining rebase plan changed outside this review. Abort it or finish it with Git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de rebase restante de Git cambió fuera de esta revisión. Abórtalo o termínalo con Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan de rebase restant de Git a changé hors de cet examen. Abandonnez-le ou terminez-le avec Git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git hátralévő újraalapozási terve az ellenőrzésen kívül megváltozott. Szakítsa meg vagy fejezze be a Gittel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano di rebase rimanente di Git è cambiato al di fuori di questa revisione. Interrompilo o terminalo con Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git の残りのリベース計画がこの確認画面の外で変更されました。中止するか Git で完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 Git 리베이스 계획이 이 검토 밖에서 변경되었습니다. 중단하거나 Git으로 완료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resterende rebaseplan van Git is buiten deze beoordeling gewijzigd. Breek het af of voltooi het met Git."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostały plan zmiany bazy Git zmienił się poza tym przeglądem. Przerwij go lub dokończ za pomocą Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano de rebase restante do Git mudou fora desta revisão. Aborte-o ou conclua-o com o Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставшийся план перебазирования Git изменён вне этой проверки. Прервите перебазирование или завершите его средствами Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gits återstående rebaseplan ändrades utanför denna granskning. Avbryt den eller slutför den med Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผน rebase ที่เหลือของ Git เปลี่ยนไปนอกการรีวิวนี้ ให้ยกเลิกหรือทำต่อด้วย Git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git'in kalan yeniden temellendirme planı bu inceleme dışında değişti. İşlemi durdurun veya Git ile tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решту плану перебазовування Git змінено поза цією перевіркою. Перервіть перебазовування або завершіть його засобами Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 剩余的变基计划已在此检查界面之外更改。请中止或使用 Git 完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 剩餘的重定基底計畫已在此檢查介面之外變更。請中止或使用 Git 完成。"
          }
        }
      }
    },
