    "An untracked or ignored path would be overwritten. Move it before a hard reset.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesledovaná nebo ignorovaná cesta by byla přepsána. Před tvrdým resetem ji přesuňte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nicht verfolgter oder ignorierter Pfad würde überschrieben. Verschiebe ihn vor einem Hard Reset."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An untracked or ignored path would be overwritten. Move it before a hard reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sobrescribiría una ruta ignorada o sin seguimiento. Muévela antes de un reset hard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chemin ignoré ou non suivi serait écrasé. Déplacez-le avant un reset hard."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy nem követett vagy figyelmen kívül hagyott útvonal felülíródna. A teljes visszaállítás előtt helyezze át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un percorso ignorato o non tracciato verrebbe sovrascritto. Spostalo prima di un reset hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未追跡または無視対象のパスが上書きされます。ハードリセットの前に移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적되지 않거나 무시된 경로를 덮어쓰게 됩니다. 하드 리셋 전에 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een niet-gevolgd of genegeerd pad zou worden overschreven. Verplaats het vóór een harde reset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieśledzona lub ignorowana ścieżka zostałaby nadpisana. Przenieś ją przed twardym resetem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um caminho ignorado ou não rastreado seria sobrescrito. Mova-o antes de um reset hard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неотслеживаемый или игнорируемый путь будет перезаписан. Переместите его перед жёстким сбросом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ospårad eller ignorerad sökväg skulle skrivas över. Flytta den före en hård återställning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาธที่ยังไม่ถูกติดตามหรือถูก ignore จะถูกเขียนทับ ให้ย้ายออกก่อนทำ hard reset"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenmeyen veya yok sayılan bir yolun üzerine yazılacak. Sert sıfırlamadan önce taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невідстежуваний або ігнорований шлях буде перезаписано. Перемістіть його перед жорстким скиданням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未跟踪或已忽略的路径将被覆盖。请先移走，再执行硬重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未追蹤或已忽略的路徑將被覆寫。請先移走，再執行硬重設。"
          }
        }
      }
    },
