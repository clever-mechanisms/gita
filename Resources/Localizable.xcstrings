    "Resolve a submodule in its own repository, then stage the commit to keep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve a submodule in its own repository, then stage the commit to keep."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dílčí modul vyřešte v jeho vlastním repozitáři a poté připravte revizi, kterou chcete zachovat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve un submódulo en su propio repositorio y luego prepara el commit que quieras conservar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse ein Submodul in seinem eigenen Repository und stage dann den Commit, der bleiben soll."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az almodult a saját tárolójában oldja fel, majd készítse elő a megtartandó commitot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez un sous-module dans son propre dépôt, puis indexez le commit à conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブモジュールはそのリポジトリ内で解決し、残すコミットをステージしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 모듈은 해당 저장소에서 해결한 다음 유지할 커밋을 스테이징하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在子模块自身的仓库中解决，然后暂存要保留的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在子模組自身的版本庫中解決，然後暫存要保留的提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi un sottomodulo nel suo repository, poi prepara il commit da mantenere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwiąż podmoduł w jego własnym repozytorium, a następnie dodaj do indeksu commit, który chcesz zachować."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los een submodule op in de eigen repository en zet daarna de commit klaar die je wilt behouden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva um submódulo no próprio repositório e prepare o commit a ser mantido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt modülü kendi deposunda çözün, ardından tutulacak commiti hazırlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös en undermodul i dess eget kodförråd och förbered sedan den commit som ska behållas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите подмодуль в его собственном репозитории, затем добавьте в индекс нужный коммит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розв’яжіть підмодуль у його власному репозиторії, потім додайте до індексу коміт, який треба зберегти."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ submodule ใน repository ของตัวเอง แล้ว stage commit ที่ต้องการเก็บ"
          }
        }
      }
    },
    "Resolve and stage all conflicted files first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve and stage all conflicted files first."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve vyřešte všechny konfliktní soubory a připravte je k zápisu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero resuelve y prepara todos los archivos en conflicto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse zuerst alle Dateikonflikte und stage die Dateien."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb oldja fel az összes ütköző fájlt, és készítse elő őket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez et indexez d’abord tous les fichiers en conflit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にすべての競合ファイルを解決してステージしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 모든 충돌 파일을 해결하고 스테이징하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解决并暂存所有冲突文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先解決並暫存所有衝突檔案。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima risolvi e prepara tutti i file in conflitto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw rozwiąż konflikty we wszystkich plikach i dodaj je do indeksu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eerst alle conflicterende bestanden op en zet ze klaar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva e prepare todos os arquivos em conflito primeiro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce çakışmalı dosyaların tümünü çözün ve hazırlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lös och förbered alla konfliktfiler först."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала разрешите конфликты во всех файлах и добавьте их в индекс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку розв’яжіть конфлікти в усіх файлах і додайте їх до індексу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้และ stage ไฟล์ที่มี conflict ทั้งหมดก่อน"
          }
        }
      }
    },
