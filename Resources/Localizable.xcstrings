    "Inspects disk usage and reclaimable caches for this checkout.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspects disk usage and reclaimable caches for this checkout."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozkoumá využití disku a uvolnitelné mezipaměti této pracovní kopie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Speicherverbrauch und freigebbare Caches für diesen Checkout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecciona el uso de disco y las cachés recuperables de esta copia de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecte l’utilisation du disque et les caches récupérables pour cette copie de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispeziona l’utilizzo del disco e le cache recuperabili per questo checkout."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megvizsgálja a lemezhasználatot és a felszabadítható gyorsítótárakat ebben a munkapéldányban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecteert schijfgebruik en terug te winnen caches voor deze checkout."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdza zajętość dysku oraz pamięci podręczne do odzyskania w tej kopii roboczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeciona o uso de disco e os caches recuperáveis deste checkout."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granskar diskanvändning och cacher som kan frigöras för denna utcheckning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการใช้พื้นที่ดิสก์และแคชที่คืนพื้นที่ได้สำหรับ checkout นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma kopyası için disk kullanımını ve geri kazanılabilir önbellekleri inceler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализирует использование диска и кэши, которые можно очистить для этой рабочей копии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряє використання диска та кеші, які можна очистити для цієї робочої копії."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックアウトのディスク使用量と回収可能なキャッシュを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 체크아웃의 디스크 사용량과 확보 가능한 캐시를 검사합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查此检出的磁盘占用和可回收缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查此簽出的磁碟使用量與可回收快取。"
          }
        }
      }
    },
