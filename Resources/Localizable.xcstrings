      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache untracked directory listings to speed up git status."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládat výpisy nesledovaných složek do mezipaměti pro zrychlení git status."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzeichnislisten nicht verfolgter Dateien zwischenspeichern, um git status zu beschleunigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en caché los listados de directorios sin seguimiento para acelerar git status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en cache la liste des dossiers non suivis pour accélérer git status."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizza nella cache gli elenchi delle cartelle non tracciate per velocizzare git status."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nem követett könyvtárlisták gyorsítótárazása a git status gyorsításához."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache overzichten van niet-gevolgde mappen om git status te versnellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buforuj listy nieśledzonych katalogów, aby przyspieszyć git status."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenar em cache listagens de diretórios não rastreados para acelerar o git status."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cacha listor över ospårade mappar för att snabba upp git status."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคชรายการโฟลเดอร์ที่ยังไม่ถูกติดตามเพื่อให้ git status ทำงานเร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "git status komutunu hızlandırmak için izlenmeyen dizin listelerini önbelleğe al."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшировать списки неотслеживаемых каталогов для ускорения git status."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешувати списки невідстежуваних каталогів для пришвидшення git status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未追跡ディレクトリ一覧をキャッシュして git status を高速化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적되지 않은 디렉터리 목록을 캐시하여 git status 속도를 높입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存未跟踪目录列表以加快 git status 速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取未追蹤目錄清單以加快 git status 速度。"
          }
        }
      }
    },
