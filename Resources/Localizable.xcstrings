    },
    "The replacement app did not open in time. Try restarting again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The replacement app did not open in time. Try restarting again."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nová instance aplikace se neotevřela včas. Zkuste restartovat znovu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de sustitución no se abrió a tiempo. Intenta reiniciar de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ersatz-App wurde nicht rechtzeitig geöffnet. Versuche den Neustart erneut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás új példánya nem nyílt meg időben. Próbálja újra az újraindítást."
          }
        },
        "fr": {
          "stringUnit": {
