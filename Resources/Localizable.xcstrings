    "%@ sends all traffic back to the previous deployment.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vrátí veškerý provoz předchozímu nasazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ leitet den gesamten Traffic zurück zur vorherigen Bereitstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sends all traffic back to the previous deployment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devuelve todo el tráfico al despliegue anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ renvoie tout le trafic vers le déploiement précédent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ minden forgalmat visszairányít az előző telepítésre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ riporta tutto il traffico alla distribuzione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすべてのトラフィックを以前のデプロイに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 모든 트래픽을 이전 배포로 되돌립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stuurt al het verkeer terug naar de vorige implementatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kieruje cały ruch z powrotem do poprzedniego wdrożenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envia todo o tráfego de volta para a implantação anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ возвращает весь трафик на предыдущее развёртывание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skickar all trafik tillbaka till föregående driftsättning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ส่งทราฟฟิกทั้งหมดกลับไปยัง deployment ก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tüm trafiği önceki dağıtıma geri gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ повертає весь трафік на попереднє розгортання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将所有流量切回之前的部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將所有流量切回先前的部署。"
          }
        }
      }
    },
    "%@ sends all traffic to the new deployment now.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nyní pošle veškerý provoz novému nasazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ leitet jetzt den gesamten Traffic zur neuen Bereitstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sends all traffic to the new deployment now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envía ahora todo el tráfico al nuevo despliegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envoie maintenant tout le trafic vers le nouveau déploiement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ most minden forgalmat az új telepítésre irányít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invia ora tutto il traffico alla nuova distribuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすべてのトラフィックを今すぐ新しいデプロイに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 지금 모든 트래픽을 새 배포로 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stuurt nu al het verkeer naar de nieuwe implementatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kieruje teraz cały ruch do nowego wdrożenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envia agora todo o tráfego para a nova implantação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сейчас направит весь трафик на новое развёртывание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skickar nu all trafik till den nya driftsättningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ส่งทราฟฟิกทั้งหมดไปยัง deployment ใหม่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ şimdi tüm trafiği yeni dağıtıma gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зараз спрямує весь трафік на нове розгортання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在将所有流量发送到新部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 現在將所有流量傳送到新部署。"
          }
        }
      }
    },
