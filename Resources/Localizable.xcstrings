    "Delegated agents without a reported worktree have no branch or commit association.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegated agents without a reported worktree have no branch or commit association."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pověření agenti bez nahlášeného pracovního stromu nejsou přiřazeni k větvi ani revizi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes delegados sin un árbol de trabajo comunicado no se asocian a ninguna rama ni commit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegierte Agenten ohne gemeldeten Worktree sind keinem Branch oder Commit zugeordnet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentett munkafa nélküli delegált ügynökök nem kapcsolódnak ághoz vagy commithoz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents délégués sans arbre de travail signalé ne sont associés à aucune branche ni aucun commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーが報告されていない委任エージェントは、ブランチやコミットに関連付けられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 트리가 보고되지 않은 위임 에이전트에는 브랜치나 커밋 연결이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未报告工作树的受委派代理没有关联的分支或提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未回報工作樹的受委派代理沒有關聯的分支或提交。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti delegati senza un albero di lavoro segnalato non sono associati a rami o commit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegowani agenci bez zgłoszonego drzewa roboczego nie mają przypisanej gałęzi ani commita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedelegeerde agenten zonder gemelde worktree zijn niet aan een branch of commit gekoppeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes delegados sem uma árvore de trabalho informada não têm associação com branch ou commit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ağacı bildirilmemiş görevlendirilmiş ajanların dal veya commit ilişkisi yoktur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegerade agenter utan rapporterad worktree är inte kopplade till någon gren eller commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делегированные агенты без указанного рабочего дерева не связаны с ветками или коммитами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Делеговані агенти без зазначеного робочого дерева не пов’язані з гілками або комітами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "agent ที่ถูกมอบหมายงานโดยไม่มีการรายงาน worktree จะไม่เชื่อมโยงกับ branch หรือ commit"
          }
        }
      }
    },
