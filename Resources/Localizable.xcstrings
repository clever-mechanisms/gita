        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Van egy el nem küldött véleményezése a GitHubon ehhez a beolvasztási kérelemhez. Előbb ott küldje be vagy törölje."
          }
        },
        "nl": {
