    "GitHub doesn’t allow this on your own pull request.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub toto u vaší vlastní žádosti o začlenění nedovoluje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub erlaubt das nicht für deinen eigenen Pull Request."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub doesn’t allow this on your own pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no permite esto en tu propia pull request."
          }
        },
        "fr": {
