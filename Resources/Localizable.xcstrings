    "Hunk staging is off while whitespace is ignored.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příprava po blocích je vypnuta, dokud jsou bílé znaky ignorovány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stagen von Blöcken ist deaktiviert, solange Leerzeichen ignoriert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunk staging is off while whitespace is ignored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparación por bloques está desactivada mientras se ignoran los espacios en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indexation par bloc est désactivée lorsque les espaces sont ignorés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A blokkonkénti előkészítés ki van kapcsolva, amíg a szóközök figyelmen kívül vannak hagyva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparazione per blocchi è disattivata mentre gli spazi bianchi vengono ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白を無視している間はハンク単位のステージは無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공백을 무시하는 동안에는 헝크 스테이징이 꺼집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaarzetten van blokken is uitgeschakeld zolang witruimte wordt genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawanie fragmentów do indeksu jest wyłączone przy ignorowaniu białych znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A preparação por bloco fica desativada enquanto espaços em branco são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление фрагментов в индекс отключено, пока пробелы игнорируются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockförberedelse är av när blanksteg ignoreras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการ stage แบบ hunk ขณะละเว้นช่องว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluklar yoksayılırken fark bloğu hazırlama kapalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавання фрагментів до індексу вимкнено, доки пробіли ігноруються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略空白时将停用区块暂存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略空白時將停用區塊暫存。"
          }
        }
      }
    },
