    "Amend this commit with staged changes and continue rebasing": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplnit tuto revizi připravenými změnami a pokračovat v přesazování"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Commit mit gestagten Änderungen ergänzen und Rebase fortsetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amend this commit with staged changes and continue rebasing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enmendar este commit con los cambios preparados y continuar el rebase"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amender ce commit avec les modifications indexées et poursuivre le rebase"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A commit módosítása az előkészített változásokkal, majd az újraalapozás folytatása"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo commit con le modifiche preparate e continua il rebase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ済みの変更でこのコミットを修正してリベースを続行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징된 변경으로 이 커밋을 수정하고 리베이스 계속"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas deze commit aan met klaargezette wijzigingen en ga door met rebasen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw ten commit zmianami z indeksu i kontynuuj zmianę bazy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emendar este commit com as alterações preparadas e continuar o rebase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправить этот коммит изменениями из индекса и продолжить перебазирование"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra denna commit med förberedda ändringar och fortsätt rebasen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไข commit นี้ด้วยการเปลี่ยนแปลงที่ staged แล้วทำ rebase ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu commiti hazırlanan değişikliklerle düzelt ve yeniden temellendirmeye devam et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправити цей коміт змінами з індексу та продовжити перебазовування"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已暂存更改修订此提交并继续变基"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已暫存變更修訂此提交並繼續重定基底"
          }
        }
      }
    },
    "An account’s gh session has expired: sign in again with gh auth login.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace gh jednoho z účtů vypršela: přihlaste se znovu pomocí gh auth login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gh-Sitzung eines Kontos ist abgelaufen: Melde dich mit gh auth login erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account’s gh session has expired: sign in again with gh auth login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de gh de una cuenta ha caducado: vuelve a iniciar sesión con gh auth login."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session gh d’un compte a expiré : reconnectez-vous avec gh auth login."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fiók gh-munkamenete lejárt: jelentkezzen be újra a gh auth login paranccsal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione gh di un account è scaduta: accedi di nuovo con gh auth login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの gh セッションの有効期限が切れました。gh auth login で再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 gh 세션이 만료되었습니다. gh auth login으로 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gh-sessie van een account is verlopen: log opnieuw in met gh auth login."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja gh jednego z kont wygasła: zaloguj się ponownie za pomocą gh auth login."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão do gh de uma conta expirou: inicie sessão novamente com gh auth login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс gh одной из учётных записей истёк: войдите снова с помощью gh auth login."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kontos gh-session har gått ut: logga in igen med gh auth login."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "session gh ของบัญชีหมดอายุ: ให้ลงชื่อเข้าใช้อีกครั้งด้วย gh auth login"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesabın gh oturumunun süresi doldu: gh auth login ile yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс gh одного з облікових записів закінчився: увійдіть знову за допомогою gh auth login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个账户的 gh 会话已过期：请使用 gh auth login 重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個帳號的 gh 工作階段已過期：請使用 gh auth login 重新登入。"
          }
        }
      }
    },
