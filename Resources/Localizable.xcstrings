    "The %lld commits from this branch will be added to the base branch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commitů z této větve bude přidáno do základní větve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Commits aus diesem Branch werden in den Basis-Branch übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %lld commits from this branch will be added to the base branch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld commits de esta rama se añadirán a la rama base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld commits de cette branche seront ajoutés à la branche de base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág %lld commitja bekerül az alapágba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I %lld commit di questo branch verranno aggiunti al branch base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチの %lld 件のコミットがベースブランチに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치의 커밋 %lld개가 베이스 브랜치에 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commits van deze branch worden aan de basisbranch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commita z tej gałęzi zostanie dodane do gałęzi bazowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld commits deste branch serão adicionados ao branch base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коммита из этой ветки будут добавлены в базовую ветку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commitsen från den här grenen läggs till i basgrenen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit %lld รายการจาก branch นี้จะถูกเพิ่มไปยัง base branch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu daldaki %lld commit temel dala eklenecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коміта з цієї гілки буде додано до базової гілки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 个提交将添加到基础分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 個提交將加入基礎分支。"
          }
        }
      }
    },
    "The %lld commits from this branch will be rebased and added to the base branch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commitů z této větve bude přeneseno (rebase) a přidáno do základní větve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Commits aus diesem Branch werden per Rebase in den Basis-Branch übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %lld commits from this branch will be rebased and added to the base branch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld commits de esta rama se reorganizarán (rebase) y se añadirán a la rama base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld commits de cette branche seront rebasés puis ajoutés à la branche de base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág %lld commitja rebase után bekerül az alapágba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I %lld commit di questo branch verranno ribasati e aggiunti al branch base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチの %lld 件のコミットがリベースされてベースブランチに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치의 커밋 %lld개가 리베이스되어 베이스 브랜치에 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commits van deze branch worden gerebased en aan de basisbranch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commita z tej gałęzi zostanie przeniesione (rebase) i dodane do gałęzi bazowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld commits deste branch passarão por rebase e serão adicionados ao branch base."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коммита из этой ветки будут перебазированы и добавлены в базовую ветку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commitsen från den här grenen rebasas och läggs till i basgrenen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit %lld รายการจาก branch นี้จะถูก rebase และเพิ่มไปยัง base branch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu daldaki %lld commit rebase edilip temel dala eklenecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коміта з цієї гілки буде перебазовано й додано до базової гілки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 个提交将变基后添加到基础分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 個提交將重定基底後加入基礎分支。"
          }
        }
      }
    },
    "The Git operation changed. Refresh before continuing.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace Gitu se změnila. Před pokračováním obnovte zobrazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Git-Vorgang hat sich geändert. Aktualisiere vor dem Fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Git operation changed. Refresh before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación de Git cambió. Actualiza antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération Git a changé. Actualisez avant de continuer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git-művelet megváltozott. Folytatás előtt frissítsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione Git è cambiata. Aggiorna prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作が変更されました。続行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 작업이 변경되었습니다. 계속하기 전에 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Git-bewerking is gewijzigd. Vernieuw voordat je doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja Git zmieniła się. Odśwież przed kontynuowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação Git mudou. Atualize antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция Git изменилась. Обновите данные перед продолжением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-åtgärden ändrades. Uppdatera innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการของ Git เปลี่ยนไป ให้รีเฟรชก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git işlemi değişti. Devam etmeden önce yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція Git змінилася. Оновіть дані перед продовженням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作已更改。请刷新后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作已變更。請重新整理後繼續。"
          }
        }
      }
    },
