            "value": "Den valda uppströmmen är inte tillgänglig eller har en annan typ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная отслеживаемая ветка недоступна или имеет другой тип."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана відстежувана гілка недоступна або має інший тип."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "upstream ที่เลือกใช้ไม่ได้หรือเป็นประเภทอื่น"
          }
        }
      }
    },
    "The signed-in GitHub account can’t review this pull request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed-in GitHub account can’t review this pull request."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášený účet GitHub nemůže tuto žádost o začlenění posoudit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das angemeldete GitHub-Konto kann diesen Pull Request nicht prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de GitHub con la sesión iniciada no puede revisar esta pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte GitHub connecté ne peut pas réviser cette pull request."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account GitHub connesso non può revisionare questa pull request."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezett GitHub-fiók nem véleményezheti ezt a beolvasztási kérelmet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aangemelde GitHub-account kan deze pullrequest niet reviewen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowane konto GitHub nie może recenzować tego pull requesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do GitHub conectada não pode revisar este pull request."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det inloggade GitHub-kontot kan inte granska den här pull requesten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açmış GitHub hesabı bu birleştirme isteğini inceleyemez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись GitHub, в которую выполнен вход, не может рецензировать этот запрос на слияние."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис GitHub, у який виконано вхід, не може рецензувати цей запит на злиття."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中の GitHub アカウントはこのプルリクエストをレビューできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 GitHub 계정으로는 이 풀 리퀘스트를 검토할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录的 GitHub 账户无法审查此拉取请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登入的 GitHub 帳號無法審查此提取要求。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี GitHub ที่ลงชื่อเข้าใช้อยู่รีวิว pull request นี้ไม่ได้"
          }
        }
      }
    },
    "The skill the agent follows: a published review skill or Gitā's own, each bundled with Gitā. Read Skill opens its source.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovednost, kterou agent postupuje: zveřejněná dovednost kontroly, nebo vlastní dovednost Gitā, obě přibalené ke Gitā. Přečíst dovednost otevře její zdroj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Skill, dem der Agent folgt: ein veröffentlichter Prüf-Skill oder Gitās eigener, jeweils mit Gitā geliefert. „Skill lesen“ öffnet seine Quelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skill the agent follows: a published review skill or Gitā's own, each bundled with Gitā. Read Skill opens its source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La skill que sigue el agente: una skill de revisión publicada o la propia de Gitā, todas incluidas con Gitā. Leer skill abre su origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le skill que suit l’agent : un skill de relecture publié ou celui de Gitā, tous inclus avec Gitā. Lire le skill ouvre sa source."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ügynök által követett skill: egy közzétett átnézési skill vagy a Gitā saját skillje, mindegyik a Gitā-hoz mellékelve. A Skill megnyitása megnyitja a forrását."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La skill che l'agente segue: una skill di revisione pubblicata o quella di Gitā, tutte incluse in Gitā. Leggi skill apre la sua fonte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが従うスキル：公開済みのレビュースキル、または Gitā 独自のスキル。いずれも Gitā に同梱されています。「スキルを読む」でその出典を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 따르는 스킬: 공개 리뷰 스킬 또는 Gitā 자체 스킬이며, 모두 Gitā에 번들로 포함되어 있습니다. 스킬 읽기로 원본을 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De skill die de agent volgt: een gepubliceerde beoordelingsskill of die van Gitā zelf, elk meegeleverd met Gitā. Skill lezen opent de bron."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill, który stosuje agent: opublikowany skill przeglądu lub własny skill Gitā, każdy dołączony do Gitā. Przeczytaj skill otwiera jego źródło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A skill que o agente segue: uma skill de revisão publicada ou a do próprio Gitā, todas incluídas no Gitā. Ler skill abre a sua fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навык, которому следует агент: опубликованный навык проверки или собственный навык Gitā, все поставляются с Gitā. «Открыть навык» открывает его источник."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skillen agenten följer: en publicerad granskningsskill eller Gitās egen, var och en medföljer Gitā. Läs skill öppnar dess källa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajanın izlediği beceri: yayımlanmış bir inceleme becerisi ya da Gitā'nın kendi becerisi; hepsi Gitā ile birlikte gelir. Beceriyi oku, kaynağını açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навичка, якої дотримується агент: опублікована навичка перегляду або власна навичка Gitā, усі постачаються з Gitā. «Відкрити навичку» відкриває її джерело."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理遵循的技能：已发布的审查技能或 Gitā 自己的技能，均随 Gitā 内置。“阅读技能”会打开其来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理遵循的技能：已發布的審查技能或 Gitā 自己的技能，均隨 Gitā 內建。「閱讀技能」會開啟其來源。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "skill ที่ agent ใช้: skill สำหรับรีวิวที่เผยแพร่หรือของ Gitā เอง ซึ่งรวมมาใน Gitā ทั้งคู่ อ่าน skill จะเปิดซอร์ส"
          }
        }
      }
    },
    "The strategy the Merge sheet starts with; you can still change it there before merging.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The strategy the Merge sheet starts with; you can still change it there before merging."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategie, se kterou se otevře okno Sloučit; před sloučením ji tam můžete stále změnit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estrategia con la que empieza la hoja Fusionar; puedes cambiarla allí antes de fusionar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Strategie, mit der der Merge-Dialog startet; du kannst sie dort vor dem Zusammenführen noch ändern."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Egyesítés párbeszédablak kezdő stratégiája; egyesítés előtt ott még módosíthatja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La stratégie avec laquelle la fenêtre Fusionner démarre ; vous pouvez encore la changer avant de fusionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージシートの初期の戦略です。マージ前にシートで変更することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 시트의 초기 전략이며, 병합 전에 시트에서 변경할 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“合并”面板的初始策略；合并前仍可在面板中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「合併」面板的初始策略；合併前仍可在面板中變更。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La strategia con cui si apre il foglio Merge; puoi comunque cambiarla lì prima del merge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategia początkowa arkusza Scal; nadal możesz ją tam zmienić przed scaleniem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De strategie waarmee het samenvoegvenster begint; je kunt die daar vóór het samenvoegen nog wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estratégia com que a janela de Mesclar começa; você ainda pode alterá-la lá antes de mesclar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştir penceresinin başlangıç stratejisi; birleştirmeden önce orada yine değiştirebilirsiniz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategin som sammanslagningsdialogen startar med; du kan fortfarande ändra den där innan du slår samman."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стратегия, с которой открывается окно слияния; её можно изменить там перед слиянием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стратегія, з якою відкривається вікно зливання; її можна змінити там перед зливанням."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลยุทธ์เริ่มต้นของหน้าต่าง Merge คุณยังเปลี่ยนได้ที่นั่นก่อน merge"
          }
        }
      }
    },
    "The symbolic link is too large to review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The symbolic link is too large to review."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolický odkaz je příliš velký pro kontrolu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace simbólico es demasiado grande para revisarlo."
          }
        },
