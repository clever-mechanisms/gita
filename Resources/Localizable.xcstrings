          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交反馈并批准合并这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交意見回饋並核准合併這些變更。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งความคิดเห็นและอนุมัติการ merge การเปลี่ยนแปลงเหล่านี้"
          }
        }
      }
    },
