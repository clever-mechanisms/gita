        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újraalapozási terv szerkesztéséhez Git 2.45 vagy újabb szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica di un piano di rebase richiede Git 2.45 o successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リベース計画の編集には Git 2.45 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리베이스 계획을 편집하려면 Git 2.45 이상이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bewerken van een rebaseplan is Git 2.45 of nieuwer vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycja planu zmiany bazy wymaga Git 2.45 lub nowszego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar um plano de rebase requer Git 2.45 ou posterior."
          }
