    "Amend a commit that is already on the upstream?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doplnit revizi, která už je v nadřazené větvi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Commit ergänzen, der bereits im Upstream ist?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amend a commit that is already on the upstream?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enmendar un commit que ya está en el upstream?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amender un commit déjà présent sur l’amont ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítja a követett ágon már szereplő commitot?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificare un commit già presente nell’upstream?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上流にすでにあるコミットを修正しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 업스트림에 있는 커밋을 수정할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een commit aanpassen die al op de upstream staat?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawić commit, który jest już w gałęzi śledzonej?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emendar um commit que já está no upstream?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправить коммит, который уже есть в отслеживаемой ветке?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra en commit som redan finns uppströms?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไข commit ที่อยู่บน upstream แล้วหรือ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenen dalda zaten bulunan bir commit düzeltilsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправити коміт, який уже є у відстежуваній гілці?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
