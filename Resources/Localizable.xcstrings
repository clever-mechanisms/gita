    "A remote already uses this name or tracking namespace.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento název nebo jmenný prostor sledování už používá vzdálený repozitář."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Remote verwendet bereits diesen Namen oder Tracking-Namensraum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A remote already uses this name or tracking namespace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un remoto con este nombre o espacio de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dépôt distant utilise déjà ce nom ou cet espace de suivi."
