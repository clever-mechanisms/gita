    "⚠ %@ is on %@. Amending needs a force push.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ je na větvi %@. Doplnění vyžaduje vynucené odeslání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ ist auf %@. Das Ergänzen erfordert einen erzwungenen Push."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ is on %@. Amending needs a force push."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ está en %@. Enmendar requiere un envío forzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %1$@ est sur %2$@. L’amendement nécessite un push forcé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %1$@ itt van: %2$@. A módosításhoz kényszerített feltöltés szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %1$@ è su %2$@. La modifica richiede un push forzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %1$@ は %2$@ にあります。修正後は強制プッシュが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@이(가) %@에 있습니다. 수정하려면 강제 푸시가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ staat op %@. Aanpassen vereist geforceerd pushen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ znajduje się w %@. Poprawienie wymaga wymuszenia wypchnięcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ está em %@. Emendar requer um push forçado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ уже на %@. После исправления потребуется принудительная отправка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ finns på %@. Att ändra kräver en tvingad sändning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ อยู่บน %@ การแก้ไขต้องใช้ force push"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ zaten %@ üzerinde. Düzeltmek için zorla göndermek gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ уже на %@. Після виправлення знадобиться примусове надсилання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ 位于 %@ 上。修订需要强制推送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ 位於 %@ 上。修訂需要強制推送。"
          }
        }
      }
    },
