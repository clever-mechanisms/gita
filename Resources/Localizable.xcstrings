    "An agent is active here. Git will run safe GC using its default prune grace period.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent is active here. Git will run safe GC using its default prune grace period."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zde aktivní agent. Git spustí bezpečnou správu paměti (GC) s výchozí ochrannou lhůtou pro pročištění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist ein Agent aktiv. Git führt eine sichere GC mit der standardmäßigen Schonfrist für das Bereinigen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un agente activo aquí. Git ejecutará un GC seguro usando su periodo de gracia de depuración predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent est actif ici. Git exécutera un nettoyage sûr en utilisant son délai d’élagage par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente è attivo qui. Git eseguirà una GC sicura usando il periodo di tolleranza predefinito per la pulizia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt egy ügynök aktív. A Git biztonságos GC-t futtat az alapértelmezett megtartási türelmi idővel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is een agent actief. Git voert veilige GC uit met de standaard uitstelperiode voor opruimen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent jest tutaj aktywny. Git uruchomi bezpieczne oczyszczanie (GC) z domyślnym okresem karencji usuwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente está ativo aqui. O Git executará um GC seguro usando o período de carência padrão para limpeza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En agent är aktiv här. Git kör säker GC med sin vanliga respittid för rensning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี agent กำลังทำงานอยู่ที่นี่ Git จะรัน GC แบบปลอดภัยโดยใช้ระยะเวลาผ่อนผันการ prune ตามค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada etkin bir ajan çalışıyor. Git, varsayılan budama bekleme süresiyle güvenli çöp toplama çalıştıracak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь работает активный агент. Git выполнит безопасную сборку мусора со стандартным сроком хранения объектов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут активний агент. Git виконає безпечне збирання сміття зі стандартним періодом збереження об’єктів."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでエージェントが稼働中です。Git はデフォルトのプルーニング猶予期間で安全な GC を実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 에이전트가 실행 중입니다. Git이 기본 정리 유예 기간을 사용하여 안전한 GC를 실행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处有代理处于活跃状态。Git 将使用默认清理宽限期运行安全 GC。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處有代理正在運作。Git 將使用預設修剪寬限期執行安全 GC。"
          }
        }
      }
    },
