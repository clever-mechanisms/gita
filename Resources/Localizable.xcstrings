    "%@ requires single sign-on for %@: authorize it on github.com, then refresh.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vyžaduje jednotné přihlašování (SSO) pro %@: autorizujte účet na github.com a poté obnovte zobrazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt Single Sign-On für %@: Autorisiere es auf github.com und aktualisiere dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires single sign-on for %@: authorize it on github.com, then refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere inicio de sesión único para %@: autorízalo en github.com y actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exige l’authentification unique pour %@ : autorisez-le sur github.com, puis actualisez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ egyszeri bejelentkezést (SSO) követel meg a következőhöz: %@. Engedélyezze a github.com-on, majd frissítsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richiede il Single Sign-On per %@: autorizzalo su github.com, poi aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では %@ にシングルサインオンが必要です。github.com で承認してから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 %@의 SSO 인증이 필요합니다. github.com에서 승인한 다음 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vereist single sign-on voor %@: autoriseer het op github.com en vernieuw daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wymaga logowania jednokrotnego (SSO) dla %@: autoryzuj konto w github.com, a następnie odśwież."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exige logon único (SSO) para %@: autorize a conta em github.com e atualize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ требует единого входа (SSO) для %@: разрешите доступ на github.com, затем обновите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kräver enkel inloggning för %@: auktorisera det på github.com och uppdatera sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ต้องใช้ single sign-on สำหรับ %@: อนุญาตบน github.com แล้วรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ için çoklu oturum açma (SSO) gerektiriyor: github.com'da yetkilendirin, ardından yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вимагає єдиного входу (SSO) для %@: авторизуйте його на github.com, потім оновіть дані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求 %@ 使用单点登录：请在 github.com 上授权，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求 %@ 使用單一登入：請在 github.com 上授權，然後重新整理。"
          }
        }
      }
    },
