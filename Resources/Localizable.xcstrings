    "macOS could not enqueue the agent notification.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not enqueue the agent notification."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nemohl zařadit oznámení agenta do fronty."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte die Agent-Mitteilung nicht einreihen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo poner en cola la notificación del agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu mettre en file la notification de l’agent."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS nem tudta sorba állítani az ügynök értesítését."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha potuto mettere in coda la notifica dell’agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がエージェントの通知をキューに追加できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 에이전트 알림을 대기열에 추가하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kon de agentmelding niet in de wachtrij plaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie mógł dodać powiadomienia agenta do kolejki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não conseguiu enfileirar a notificação do agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не удалось поставить уведомление агента в очередь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kunde inte köa agentnotisen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ajan bildirimini sıraya alamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не вдалося поставити сповіщення агента в чергу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法将代理通知加入队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 無法將代理通知加入佇列。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS จัดคิวการแจ้งเตือนของ agent ไม่ได้"
          }
        }
      }
    },
    "macOS could not enqueue the provider notification.": {
      "localizations": {
        "en": {
          "stringUnit": {
