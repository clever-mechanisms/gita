        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply every change that conflicts with nothing, from both sides"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar todos los cambios que no tienen conflictos, de ambos lados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer toutes les modifications sans conflit, des deux côtés"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden semmivel nem ütköző változás alkalmazása mindkét oldalról"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica ogni modifica che non è in conflitto, da entrambi i lati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの変更とも競合しない変更を両側からすべて適用"
          }
