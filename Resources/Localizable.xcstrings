            "state": "translated",
            "value": "Tento repozitář obsahuje příliš mnoho pracovních stromů pro bezpečnou kontrolu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio tiene demasiados árboles de trabajo para revisarlos con seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository hat zu viele Worktrees für eine sichere Prüfung."
