          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプルリクエストをどのアカウントで読み込んだか GitHub から返されませんでした。更新してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 이 풀 리퀘스트를 로드한 계정을 알려 주지 않았습니다. 새로 고친 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub gaf niet aan welk account deze pullrequest heeft geladen. Vernieuw en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nie podał, które konto wczytało ten pull request. Odśwież i spróbuj ponownie."
