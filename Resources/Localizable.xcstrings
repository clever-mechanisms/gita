          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz as alterações remotas para o seu branch local"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar fjärrändringar och för in dem i din lokala gren"
