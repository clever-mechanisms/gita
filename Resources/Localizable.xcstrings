    "Worktree metadata changed. Refresh the repository.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree metadata changed. Refresh the repository."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata pracovního stromu se změnila. Obnovte repozitář."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos del árbol de trabajo cambiaron. Actualiza el repositorio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree-Metadaten haben sich geändert. Aktualisiere das Repository."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkafa metaadatai megváltoztak. Frissítse a tárolót."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de l’arbre de travail ont changé. Actualisez le dépôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーのメタデータが変更されました。リポジトリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 트리 메타데이터가 변경되었습니다. 저장소를 새로 고치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树元数据已更改。请刷新仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹中繼資料已變更。請重新整理版本庫。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I metadati dell’albero di lavoro sono cambiati. Aggiorna il repository."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadane drzewa roboczego zmieniły się. Odśwież repozytorium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktreemetagegevens zijn gewijzigd. Vernieuw de repository."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados da árvore de trabalho mudaram. Atualize o repositório."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ağacının meta verileri değişti. Depoyu yenileyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree-metadata ändrades. Uppdatera kodförrådet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные рабочего дерева изменились. Обновите репозиторий."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Метадані робочого дерева змінилися. Оновіть репозиторій."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "metadata ของ worktree เปลี่ยนไป ให้รีเฟรช repository"
          }
        }
      }
    },
    "Worktree operation metadata is not a directory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree operation metadata is not a directory."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata operace pracovního stromu nejsou adresář."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos de operación del árbol de trabajo no son un directorio."
          }
