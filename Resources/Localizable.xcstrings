          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto Vercel collegato è cambiato durante la lettura. Aggiorna per caricare le sue distribuzioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązany projekt Vercel zmienił się podczas odczytu. Odśwież, aby wczytać jego wdrożenia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gekoppelde Vercel-project is tijdens het lezen gewijzigd. Vernieuw om de implementaties te laden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto Vercel vinculado mudou durante a leitura. Atualize para carregar suas implantações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı Vercel projesi okuma sırasında değişti. Dağıtımlarını yüklemek için yenileyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det länkade Vercel-projektet ändrades under läsningen. Uppdatera för att läsa in dess driftsättningar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанный проект Vercel изменился во время чтения. Обновите данные, чтобы загрузить его развёртывания."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пов’язаний проєкт Vercel змінився під час читання. Оновіть дані, щоб завантажити його розгортання."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์ Vercel ที่เชื่อมไว้เปลี่ยนไประหว่างการอ่าน ให้รีเฟรชเพื่อโหลด deployment"
          }
        }
      }
    },
    "The local branch is not directly behind that commit, so it cannot move there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local branch is not directly behind that commit, so it cannot move there."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní větev není přímo za touto revizí, takže ji tam nelze posunout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama local no está directamente por detrás de ese commit, así que no puede moverse allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Branch liegt nicht direkt hinter diesem Commit und kann daher nicht dorthin vorrücken."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi ág nem közvetlenül a commit mögött van, ezért nem léphet oda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche locale n’est pas directement en retard sur ce commit, elle ne peut donc pas s’y déplacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルブランチがそのコミットの直接の祖先ではないため、そこまで進めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 브랜치가 그 커밋의 바로 뒤에 있지 않으므로 그곳으로 이동할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支并非直接落后于该提交，因此无法前移到那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機分支並非直接落後於該提交，因此無法前移到那裡。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo locale non è direttamente indietro rispetto a quel commit, quindi non può spostarsi lì."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna gałąź nie jest bezpośrednio za tym commitem, więc nie można jej tam przesunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale branch staat niet direct achter die commit en kan daar dus niet naartoe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branch local não está diretamente atrás desse commit, então não pode ser movida até ele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel dal doğrudan o commitin gerisinde değil, bu yüzden oraya taşınamaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala grenen ligger inte direkt bakom den commiten, så den kan inte flyttas dit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная ветка не отстаёт напрямую от этого коммита, поэтому её нельзя туда передвинуть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна гілка не є прямим попередником цього коміту, тож її не можна туди пересунути."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "branch ในเครื่องไม่ได้อยู่หลัง commit นั้นโดยตรง จึงย้ายไปที่นั่นไม่ได้"
          }
        }
      }
    },
    "The message for %@ must fit in 64 KiB.": {
