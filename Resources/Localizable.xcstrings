    "Checkout will switch from %@ to %@ during rebase and return afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout will switch from %@ to %@ during rebase and return afterward."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během přesazování se pracovní kopie přepne z %@ na %@ a poté se vrátí zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout wechselt während des Rebase von %@ zu %@ und kehrt danach zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de trabajo cambiará de %@ a %@ durante el rebase y volverá después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extraction basculera de %@ vers %@ pendant le rebase, puis reviendra ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout passerà da %1$@ a %2$@ durante il rebase e tornerà indietro al termine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az újraalapozás során a munkapéldány átvált innen: %@ ide: %@, majd utána visszatér."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De checkout schakelt tijdens de rebase van %@ naar %@ en keert daarna terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas zmiany bazy nastąpi przełączenie z %@ na %@, a po zakończeniu powrót."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout mudará de %@ para %@ durante o rebase e retornará depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utcheckningen växlar från %@ till %@ under rebase och återgår efteråt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "checkout จะสลับจาก %@ ไปยัง %@ ระหว่าง rebase แล้วสลับกลับภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden temellendirme sırasında %@ dalından %@ dalına geçilecek ve ardından geri dönülecektir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время перебазирования рабочая копия переключится с %@ на %@, а затем вернётся обратно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час перебазовування робоча копія перемкнеться з %@ на %@, а потім повернеться назад."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リベース中はチェックアウトが %1$@ から %2$@ に切り替わり、完了後に元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리베이스 중 체크아웃이 %@에서 %@(으)로 전환되고 완료 후 되돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
