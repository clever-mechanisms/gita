    "This commit is already on the upstream branch. Amending it needs a force push.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato revize už je v nadřazené větvi. Její doplnění vyžaduje vynucené odeslání."
          }
        },
        "de": {
          "stringUnit": {
