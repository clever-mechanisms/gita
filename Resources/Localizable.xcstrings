    "Automatic gives every line in the graph its own colour. Any other choice draws every commit in that colour.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnost Automaticky dá každé čáře grafu vlastní barvu. Jakákoli jiná volba vykreslí všechny revize touto barvou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch gibt jeder Linie im Graphen eine eigene Farbe. Jede andere Wahl zeichnet alle Commits in dieser Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic gives every line in the graph its own colour. Any other choice draws every commit in that colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático da a cada línea del gráfico su propio color. Cualquier otra opción dibuja todos los commits en ese color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique donne à chaque ligne du graphe sa propre couleur. Tout autre choix dessine chaque commit dans cette couleur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikus beállításnál a gráf minden vonala saját színt kap. Bármely más választásnál minden commit ezzel a színnel jelenik meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico assegna a ogni linea del grafico il proprio colore. Qualsiasi altra scelta disegna ogni commit in quel colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、グラフの線ごとに異なる色を使います。それ以外を選ぶと、すべてのコミットをその色で描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'자동'은 그래프의 각 선에 고유한 색상을 지정합니다. 다른 항목을 선택하면 모든 커밋을 그 색상으로 그립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch geeft elke lijn in de graaf een eigen kleur. Elke andere keuze tekent elke commit in die kleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja Automatycznie nadaje każdej linii grafu własny kolor. Każdy inny wybór rysuje wszystkie commity w tym kolorze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático dá a cada linha do gráfico sua própria cor. Qualquer outra opção desenha todos os commits nessa cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В автоматическом режиме у каждой линии графа свой цвет. При любом другом выборе все коммиты рисуются этим цветом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk ger varje linje i grafen en egen färg. Alla andra val ritar varje commit i den färgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดอัตโนมัติให้แต่ละเส้นในกราฟมีสีของตัวเอง ตัวเลือกอื่นจะวาดทุก commit ด้วยสีนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, grafikteki her çizgiye kendi rengini verir. Başka bir seçim tüm commitleri o renkte çizer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично кожна лінія графа отримує власний колір. За будь-якого іншого вибору всі коміти малюються цим кольором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会为图中的每条线分配各自的颜色。选择其他颜色则所有提交都以该颜色绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會為圖中的每條線指定各自的顏色。選擇其他顏色則所有提交都以該顏色繪製。"
          }
        }
      }
    },
    "Automatic maintenance: %@. Runs periodic background packing and prefetch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic maintenance: %@. Runs periodic background packing and prefetch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická údržba: %@. Spouští pravidelné balení a přednačítání na pozadí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Wartung: %@. Führt regelmäßig Packen und Prefetch im Hintergrund aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenimiento automático: %@. Ejecuta empaquetado y precarga periódicos en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance automatique : %@. Effectue un empaquetage et un préchargement périodiques en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manutenzione automatica: %@. Esegue impacchettamento e prefetch periodici in background."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikus karbantartás: %@. Időszakos háttércsomagolást és előtöltést futtat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch onderhoud: %@. Voert periodiek op de achtergrond inpakken en prefetch uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczna konserwacja: %@. Uruchamia okresowe pakowanie i pobieranie w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manutenção automática: %@. Executa empacotamento e pré-busca periódicos em segundo plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt underhåll: %@. Kör periodisk packning och förhämtning i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบำรุงรักษาอัตโนมัติ: %@ ทำงานแพ็กและดึงข้อมูลล่วงหน้าเป็นระยะในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik bakım: %@. Arka planda düzenli paketleme ve ön getirme çalıştırır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автообслуживание: %@. Периодически упаковывает объекты и выполняет prefetch в фоне."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автообслуговування: %@. Періодично пакує об’єкти та виконує prefetch у фоні."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動メンテナンス: %@。バックグラウンドで定期的にパックとプリフェッチを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 유지 관리: %@. 백그라운드에서 주기적으로 패킹과 프리페치를 실행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动维护：%@。在后台定期执行打包与预取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動維護：%@。在背景定期執行封裝與預先擷取。"
          }
        }
      }
    },
