    "Inspect any prior HEAD state or recover dropped commits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect any prior HEAD state or recover dropped commits."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozkoumejte předchozí stavy HEAD nebo obnovte vynechané revize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe jeden früheren HEAD-Zustand oder stelle verworfene Commits wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecciona cualquier estado anterior de HEAD o recupera commits descartados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez tout état antérieur de HEAD ou récupérez des commits perdus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispeziona qualsiasi stato precedente di HEAD o recupera commit eliminati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizsgáljon meg bármely korábbi HEAD állapotot, vagy állítson helyre elhagyott commitokat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecteer een eerdere HEAD-status of herstel weggelaten commits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dowolny wcześniejszy stan HEAD lub odzyskaj pominięte commity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione qualquer estado anterior de HEAD ou recupere commits descartados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska tidigare HEAD-tillstånd eller återställ borttagna commits."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสถานะ HEAD ก่อนหน้าหรือกู้คืน commit ที่หลุดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki herhangi bir HEAD durumunu inceleyin veya çıkarılan commitleri kurtarın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте предыдущие состояния HEAD или восстанавливайте потерянные коммиты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте будь-який попередній стан HEAD або відновіть вилучені коміти."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の HEAD の状態を確認したり、除外されたコミットを復元したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 HEAD 상태를 검사하거나 제외된 커밋을 복구합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查任意历史 HEAD 状态或恢复丢弃的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查任何先前的 HEAD 狀態或復原已捨棄的提交。"
          }
        }
      }
    },
