    "Resolve the pending changes, then continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the pending changes, then continue."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
