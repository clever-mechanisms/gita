        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden olyan ütközés egyesítése, amelynek oldalai különböző sorokat vagy szavakat módosítanak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci ogni conflitto i cui lati modificano righe o parole diverse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側が異なる行または単語を変更しているすべての競合をマージ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽이 서로 다른 줄이나 단어를 변경한 모든 충돌 병합"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
