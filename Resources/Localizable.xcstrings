          "stringUnit": {
            "state": "translated",
            "value": "A munkafa műveleti metaadatainak helye nem könyvtár."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées d’opération de l’arbre de travail ne sont pas un répertoire."
