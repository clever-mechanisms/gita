    "At least two worktrees are needed to scan for collisions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least two worktrees are needed to scan for collisions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke kontrole kolizí jsou potřeba alespoň dva pracovní stromy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Kollisionsprüfung werden mindestens zwei Worktrees benötigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan al menos dos árboles de trabajo para buscar colisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins deux arbres de travail sont nécessaires pour rechercher les collisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono necessari almeno due alberi di lavoro per cercare collisioni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ütközések vizsgálatához legalább két munkafa szükséges."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn minstens twee worktrees nodig om te scannen op botsingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do skanowania kolizji potrzebne są co najmniej dwa drzewa robocze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessárias pelo menos duas árvores de trabalho para verificar colisões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst två worktrees krävs för att söka efter kollisioner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีอย่างน้อยสอง worktree เพื่อสแกนหาการชนกันของการแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çakışma taraması için en az iki çalışma ağacı gerekir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для поиска пересечений нужно не менее двух рабочих деревьев."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для пошуку колізій потрібно щонайменше два робочі дерева."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "衝突をスキャンするには少なくとも 2 つのワークツリーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌을 스캔하려면 작업 트리가 두 개 이상 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两个工作树才能扫描冲突。"
          }
        },
        "zh-Hant": {
