    "The approved rebase plan changed. Reload the operation or abort it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schválený plán přesazení se změnil. Načtěte operaci znovu nebo ji přerušte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der genehmigte Rebase-Plan hat sich geändert. Lade den Vorgang neu oder brich ihn ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved rebase plan changed. Reload the operation or abort it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de rebase aprobado cambió. Vuelve a cargar la operación o abórtala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan de rebase approuvé a changé. Rechargez l’opération ou abandonnez-la."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jóváhagyott újraalapozási terv megváltozott. Töltse újra vagy szakítsa meg a műveletet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano di rebase approvato è cambiato. Ricarica l’operazione o interrompila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みのリベース計画が変更されました。操作を再読み込みするか中止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 리베이스 계획이 변경되었습니다. 작업을 다시 로드하거나 중단하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het goedgekeurde rebaseplan is gewijzigd. Laad de bewerking opnieuw of breek deze af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzony plan zmiany bazy zmienił się. Wczytaj operację ponownie lub ją przerwij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano de rebase aprovado mudou. Recarregue a operação ou aborte-a."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утверждённый план перебазирования изменился. Перезагрузите операцию или прервите её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den godkända rebaseplanen ändrades. Läs in åtgärden igen eller avbryt den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผน rebase ที่อนุมัติแล้วเปลี่ยนไป ให้โหลดการดำเนินการใหม่หรือยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylanan yeniden temellendirme planı değişti. İşlemi yeniden yükleyin veya durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затверджений план перебазовування змінився. Перезавантажте операцію або перервіть її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准的变基计划已更改。请重新载入操作或中止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已核准的重定基底計畫已變更。請重新載入操作或中止。"
          }
        }
      }
    },
    "The base branch’s rules don’t allow this merge yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidla základní větve toto sloučení zatím nepovolují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln des Basis-Branches erlauben dieses Zusammenführen noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The base branch’s rules don’t allow this merge yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de la rama base aún no permiten esta fusión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles de la branche de base n’autorisent pas encore cette fusion."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapág szabályai még nem engedik ezt az egyesítést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole del branch base non consentono ancora questo merge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースブランチのルールにより、まだこのマージはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베이스 브랜치 규칙상 아직 이 병합을 할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regels van de basisbranch staan deze samenvoeging nog niet toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły gałęzi bazowej nie pozwalają jeszcze na to scalenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras do branch base ainda não permitem esta mesclagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила базовой ветки пока не разрешают это слияние."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Basgrenens regler tillåter inte den här sammanslagningen ännu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎของ base branch ยังไม่อนุญาตให้ merge นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel dalın kuralları bu birleştirmeye henüz izin vermiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила базової гілки поки не дозволяють це злиття."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础分支的规则暂不允许此合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎分支的規則暫不允許此合併。"
          }
        }
      }
    },
