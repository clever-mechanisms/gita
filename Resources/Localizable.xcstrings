    "The %lld commits from this branch will be added to the base branch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %lld commits from this branch will be added to the base branch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commitů z této větve bude přidáno do základní větve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Commits aus diesem Branch werden in den Basis-Branch übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld commits de esta rama se añadirán a la rama base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld commits de cette branche seront ajoutés à la branche de base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I %lld commit di questo branch verranno aggiunti al branch base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág %lld commitja bekerül az alapágba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commits van deze branch worden aan de basisbranch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commita z tej gałęzi zostanie dodane do gałęzi bazowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld commits deste branch serão adicionados ao branch base."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commitsen från den här grenen läggs till i basgrenen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu daldaki %lld commit temel dala eklenecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коммита из этой ветки будут добавлены в базовую ветку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коміта з цієї гілки буде додано до базової гілки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチの %lld 件のコミットがベースブランチに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
