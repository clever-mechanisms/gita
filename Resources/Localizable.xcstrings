    "Its tabs and its list of recent repositories are forgotten. The repositories stay on disk.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho karty a seznam posledních repozitářů budou zapomenuty. Repozitáře zůstanou na disku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Tabs und seine Liste zuletzt verwendeter Repositorys werden vergessen. Die Repositorys bleiben auf dem Datenträger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its tabs and its list of recent repositories are forgotten. The repositories stay on disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvidan sus pestañas y su lista de repositorios recientes. Los repositorios siguen en el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses onglets et sa liste de dépôts récents sont oubliés. Les dépôts restent sur le disque."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lapjai és a legutóbbi tárolók listája törlődik. A tárolók a lemezen maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi pannelli e il suo elenco di repository recenti vengono dimenticati. I repository restano sul disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブと最近使ったリポジトリのリストは消去されます。リポジトリはディスクに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭과 최근 저장소 목록은 지워집니다. 저장소는 디스크에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabbladen en de lijst met recente repository’s ervan worden vergeten. De repository’s blijven op schijf staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jej karty i lista ostatnich repozytoriów zostaną zapomniane. Repozytoria pozostaną na dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas e a lista de repositórios recentes dele são esquecidas. Os repositórios continuam no disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его вкладки и список недавних репозиториев будут забыты. Сами репозитории останутся на диске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess flikar och lista över senaste kodförråd glöms. Kodförråden finns kvar på disken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บและรายการ repository ล่าสุดจะถูกลืม repository ยังคงอยู่บนดิสก์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmeleri ve son depolar listesi unutulur. Depolar diskte kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його вкладки та список недавніх репозиторіїв буде забуто. Репозиторії залишаться на диску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其标签页和最近使用的仓库列表将被清除。仓库仍保留在磁盘上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其標籤頁和最近使用的版本庫列表將被清除。版本庫仍保留在磁碟上。"
          }
        }
      }
    },
