    "Discarded working-tree changes in %@ cannot be recovered through Git.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahozené změny pracovního stromu v %@ nelze prostřednictvím Gitu obnovit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verworfene Arbeitsbaumänderungen in %@ können über Git nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discarded working-tree changes in %@ cannot be recovered through Git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios del árbol de trabajo descartados en %@ no se pueden recuperar a través de Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de l’arbre de travail abandonnées dans %@ ne peuvent pas être récupérées via Git."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ munkafabeli elvetett változásai nem állíthatók vissza a Giten keresztül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche dell’albero di lavoro scartate in %@ non possono essere recuperate tramite Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で破棄されたワークツリーの変更は Git では復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 버린 작업 트리 변경 사항은 Git을 통해 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verworpen wijzigingen in de werkboom voor %@ kunnen niet via Git worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzuconych zmian w drzewie roboczym w %@ nie można odzyskać przez Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações descartadas da árvore de trabalho em %@ não podem ser recuperadas pelo Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отброшенные изменения рабочего дерева в %@ нельзя восстановить через Git."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kastade ändringar i arbetsträdet i %@ kan inte återställas via Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงใน working tree ของ %@ ที่ทิ้งไปจะกู้คืนผ่าน Git ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki atılan çalışma ağacı değişiklikleri Git üzerinden kurtarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкинуті зміни робочого дерева в %@ не можна відновити через Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
