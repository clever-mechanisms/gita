        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájl túllépi a strukturált eltérés méretkorlátját."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestand overschrijdt de groottelimiet voor gestructureerde diff."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik przekracza limit rozmiaru dla różnic strukturalnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
