    "%@ will serve this deployment.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na doméně %@ poběží toto nasazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird diese Bereitstellung ausliefern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will serve this deployment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servirá este despliegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servira ce déploiement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ ezt a telepítést fogja kiszolgálni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servirà questa distribuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でこのデプロイが配信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 배포를 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gaat deze implementatie serveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domena %@ będzie serwować to wdrożenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servirá esta implantação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ будет обслуживать это развёртывание."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommer att leverera denna driftsättning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะให้บริการ deployment นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu dağıtımı sunacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обслуговуватиме це розгортання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将提供此部署。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將提供此部署。"
          }
        }
      }
    },
    "%@ will serve this older deployment again. New production builds stay unassigned until one is promoted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na doméně %@ znovu poběží toto starší nasazení. Nová produkční sestavení zůstanou nepřiřazená, dokud některé z nich nepovýšíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird diese ältere Bereitstellung wieder ausliefern. Neue Produktions-Builds bleiben unzugewiesen, bis einer hochgestuft wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will serve this older deployment again. New production builds stay unassigned until one is promoted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volverá a servir este despliegue anterior. Las nuevas compilaciones de producción quedarán sin asignar hasta que se promueva una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servira de nouveau ce déploiement plus ancien. Les nouveaux builds de production restent non attribués jusqu’à ce que l’un d’eux soit promu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ ismét ezt a régebbi telepítést szolgálja ki. Az új éles összeállítások mindaddig hozzárendelés nélkül maradnak, amíg valamelyiket elő nem lépteti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ servirà di nuovo questa distribuzione precedente. Le nuove build di produzione restano non assegnate finché una non viene promossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でこの以前のデプロイが再び配信されます。新しい本番ビルドは、いずれかを昇格するまで割り当てられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 이 이전 배포를 다시 제공합니다. 새 프로덕션 빌드는 하나를 승격할 때까지 할당되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gaat deze oudere implementatie weer serveren. Nieuwe productiebuilds blijven niet toegewezen totdat er een wordt gepromoveerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domena %@ ponownie będzie serwować to starsze wdrożenie. Nowe kompilacje produkcyjne pozostaną nieprzypisane, dopóki któraś z nich nie zostanie wypromowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltará a servir esta implantação mais antiga. Novos builds de produção ficam sem atribuição até que um seja promovido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ снова будет обслуживать это более старое развёртывание. Новые сборки рабочей среды не получат домен, пока одну из них не переведут в рабочую среду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommer att leverera denna äldre driftsättning igen. Nya produktionsbyggen förblir otilldelade tills ett av dem befordras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะให้บริการ deployment เก่านี้แทน production build ใหม่จะยังไม่ถูกกำหนดจนกว่าจะมีตัวหนึ่งถูก promote"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu eski dağıtımı yeniden sunacak. Yeni canlı ortam derlemeleri, biri canlı ortama yükseltilene kadar atanmamış kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ знову обслуговуватиме це старіше розгортання. Нові збірки робочого середовища не отримають домен, доки одну з них не буде переведено в робоче середовище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将重新提供这个较早的部署。新的生产构建将保持未分配状态，直到其中一个被提升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將重新提供這個較早的部署。新的正式建置將保持未指派狀態，直到其中一個被提升。"
          }
        }
      }
    },
