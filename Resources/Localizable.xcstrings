    "Changed actions, order, and messages will be lost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed actions, order, and messages will be lost."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny akcí, pořadí a zpráv budou ztraceny."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán los cambios en acciones, orden y mensajes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geänderte Aktionen, Reihenfolge und Nachrichten gehen verloren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A műveletek, sorrend és üzenetek módosításai elvesznek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications des actions, de l’ordre et des messages seront perdues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作、順序、メッセージの変更が失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경한 동작, 순서 및 메시지가 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对操作、顺序和消息的更改将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對操作、順序和訊息的變更將遺失。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche ad azioni, ordine e messaggi andranno perse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany działań, kolejności i komunikatów zostaną utracone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewijzigde acties, volgorde en berichten gaan verloren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de ações, ordem e mensagens serão perdidas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylem, sıra ve iletilerdeki değişiklikler kaybolacak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändrade åtgärder, ordning och meddelanden går förlorade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения действий, порядка и сообщений будут потеряны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни дій, порядку та повідомлень буде втрачено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำ ลำดับ และข้อความที่เปลี่ยนแปลงจะหายไป"
          }
        }
      }
    },
