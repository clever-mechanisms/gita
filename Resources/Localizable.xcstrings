        }
      }
    },
    "GitHub doesn’t let you approve or request changes on your own pull request.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub nedovoluje schválit vlastní pull request ani v něm žádat o změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub lässt dich deinen eigenen Pull Request nicht genehmigen und keine Änderungen daran anfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub doesn’t let you approve or request changes on your own pull request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no permite aprobar ni solicitar cambios en tu propia pull request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ne vous permet pas d’approuver votre propre pull request ni d’y demander des modifications."
