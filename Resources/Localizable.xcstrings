    "Signature could not be checked because the signing key is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature could not be checked because the signing key is unavailable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis nebylo možné ověřit, protože podpisový klíč není dostupný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signatur konnte nicht geprüft werden, weil der Signierschlüssel nicht verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar la firma porque la clave de firma no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier la signature car la clé de signature est indisponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la firma perché la chiave di firma non è disponibile."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aláírás nem ellenőrizhető, mert az aláírókulcs nem érhető el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handtekening kon niet worden gecontroleerd omdat de ondertekeningssleutel niet beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można sprawdzić podpisu, ponieważ klucz podpisywania jest niedostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a assinatura porque a chave de assinatura está indisponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen kunde inte kontrolleras eftersom signeringsnyckeln inte är tillgänglig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบลายเซ็นไม่ได้เนื่องจากไม่มีคีย์ลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalama anahtarı kullanılamadığı için imza kontrol edilemedi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подпись, так как ключ подписи недоступен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити підпис, оскільки ключ підпису недоступний."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名キーが利用できないため署名を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 키를 사용할 수 없어 서명을 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
