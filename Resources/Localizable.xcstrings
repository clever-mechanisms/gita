            "value": "commit %lld รายการจาก branch นี้จะถูกเพิ่มไปยัง base branch"
          }
        }
      }
    },
    "The %lld commits from this branch will be rebased and added to the base branch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %lld commits from this branch will be rebased and added to the base branch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commitů z této větve bude přeneseno (rebase) a přidáno do základní větve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Commits aus diesem Branch werden per Rebase in den Basis-Branch übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los %lld commits de esta rama se reorganizarán (rebase) y se añadirán a la rama base."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld commits de cette branche seront rebasés puis ajoutés à la branche de base."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I %lld commit di questo branch verranno ribasati e aggiunti al branch base."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ág %lld commitja rebase után bekerül az alapágba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commits van deze branch worden gerebased en aan de basisbranch toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld commita z tej gałęzi zostanie przeniesione (rebase) i dodane do gałęzi bazowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld commits deste branch passarão por rebase e serão adicionados ao branch base."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld commitsen från den här grenen rebasas och läggs till i basgrenen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu daldaki %lld commit rebase edilip temel dala eklenecek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коммита из этой ветки будут перебазированы и добавлены в базовую ветку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld коміта з цієї гілки буде перебазовано й додано до базової гілки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブランチの %lld 件のコミットがリベースされてベースブランチに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브랜치의 커밋 %lld개가 리베이스되어 베이스 브랜치에 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 个提交将变基后添加到基础分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此分支的 %lld 個提交將重定基底後加入基礎分支。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit %lld รายการจาก branch นี้จะถูก rebase และเพิ่มไปยัง base branch"
          }
        }
      }
    },
    "The Git operation changed. Refresh before continuing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Git operation changed. Refresh before continuing."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace Gitu se změnila. Před pokračováním obnovte zobrazení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación de Git cambió. Actualiza antes de continuar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Git-Vorgang hat sich geändert. Aktualisiere vor dem Fortsetzen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Git-művelet megváltozott. Folytatás előtt frissítsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération Git a changé. Actualisez avant de continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作が変更されました。続行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 작업이 변경되었습니다. 계속하기 전에 새로 고치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作已更改。请刷新后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 操作已變更。請重新整理後繼續。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione Git è cambiata. Aggiorna prima di continuare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja Git zmieniła się. Odśwież przed kontynuowaniem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Git-bewerking is gewijzigd. Vernieuw voordat je doorgaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação Git mudou. Atualize antes de continuar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git işlemi değişti. Devam etmeden önce yenileyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Git-åtgärden ändrades. Uppdatera innan du fortsätter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция Git изменилась. Обновите данные перед продолжением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція Git змінилася. Оновіть дані перед продовженням."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการของ Git เปลี่ยนไป ให้รีเฟรชก่อนดำเนินการต่อ"
          }
        }
      }
    },
    "The GitHub account %@ can’t see %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitHub account %@ can’t see %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet GitHub %@ nevidí %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de GitHub %@ no puede ver %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GitHub-Konto %@ kann %@ nicht sehen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ GitHub-fiók nem látja ezt: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte GitHub %@ ne peut pas voir %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub アカウント %@ は %@ を参照できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 계정 %@은(는) %@을(를) 볼 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 账户 %@ 无法访问 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 帳號 %@ 無法存取 %@。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account GitHub %@ non può vedere %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto GitHub %@ nie widzi %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het GitHub-account %@ kan %@ niet zien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do GitHub %@ não pode ver %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GitHub hesabı %@ deposunu göremiyor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-kontot %@ kan inte se %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётная запись GitHub %@ не видит %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис GitHub %@ не має доступу до %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี GitHub %@ มองไม่เห็น %@"
          }
        }
      }
    },
    "The GitHub account %@ is not signed in. Run gh auth login in Terminal, then refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitHub account %@ is not signed in. Run gh auth login in Terminal, then refresh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účet GitHub %@ není přihlášen. Spusťte gh auth login v Terminálu a poté obnovte zobrazení."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta de GitHub %@ no tiene sesión iniciada. Ejecuta gh auth login en Terminal y actualiza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GitHub-Konto %@ ist nicht angemeldet. Führe gh auth login im Terminal aus und aktualisiere dann."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ GitHub-fiók nincs bejelentkezve. Futtassa a gh auth login parancsot a Terminálban, majd frissítsen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte GitHub %@ n’est pas connecté. Exécutez gh auth login dans Terminal, puis actualisez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub アカウント %@ はサインインしていません。ターミナルで gh auth login を実行してから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 계정 %@이(가) 로그인되어 있지 않습니다. 터미널에서 gh auth login을 실행한 다음 새로 고치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 账户 %@ 未登录。请在终端中运行 gh auth login，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 帳號 %@ 未登入。請在「終端機」中執行 gh auth login，然後重新整理。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account GitHub %@ non ha eseguito l’accesso. Esegui gh auth login in Terminale, poi aggiorna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto GitHub %@ nie jest zalogowane. Uruchom gh auth login w Terminalu, a następnie odśwież."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het GitHub-account %@ is niet aangemeld. Voer gh auth login uit in Terminal en vernieuw daarna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta do GitHub %@ não está com sessão iniciada. Execute gh auth login no Terminal e atualize."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GitHub hesabında oturum açılmamış. Terminal'de gh auth login komutunu çalıştırın, ardından yenileyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-kontot %@ är inte inloggat. Kör gh auth login i Terminal och uppdatera sedan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В учётную запись GitHub %@ не выполнен вход. Выполните gh auth login в Терминале, затем обновите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В обліковий запис GitHub %@ не виконано вхід. Виконайте gh auth login у Терміналі, потім оновіть дані."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี GitHub %@ ยังไม่ได้ลงชื่อเข้าใช้ ให้รัน gh auth login ใน Terminal แล้วรีเฟรช"
          }
        }
      }
    },
    "The GitHub account in use can’t see this repository.": {
