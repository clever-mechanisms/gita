    "An account’s gh session has expired: sign in again with GH_CONFIG_DIR=%@ gh auth login.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace gh jednoho z účtů vypršela: přihlaste se znovu pomocí GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gh-Sitzung eines Kontos ist abgelaufen: Melde dich mit GH_CONFIG_DIR=%@ gh auth login erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account’s gh session has expired: sign in again with GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de gh de una cuenta ha caducado: vuelve a iniciar sesión con GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session gh d’un compte a expiré : reconnectez-vous avec GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fiók gh-munkamenete lejárt: jelentkezzen be újra a GH_CONFIG_DIR=%@ gh auth login paranccsal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione gh di un account è scaduta: accedi di nuovo con GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの gh セッションの有効期限が切れました。GH_CONFIG_DIR=%@ gh auth login で再度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 gh 세션이 만료되었습니다. GH_CONFIG_DIR=%@ gh auth login으로 다시 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gh-sessie van een account is verlopen: log opnieuw in met GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja gh jednego z kont wygasła: zaloguj się ponownie za pomocą GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão do gh de uma conta expirou: inicie sessão novamente com GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс gh одной из учётных записей истёк: войдите снова с помощью GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kontos gh-session har gått ut: logga in igen med GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "session gh ของบัญชีหมดอายุ: ให้ลงชื่อเข้าใช้อีกครั้งด้วย GH_CONFIG_DIR=%@ gh auth login"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hesabın gh oturumunun süresi doldu: GH_CONFIG_DIR=%@ gh auth login ile yeniden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс gh одного з облікових записів закінчився: увійдіть знову за допомогою GH_CONFIG_DIR=%@ gh auth login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个账户的 gh 会话已过期：请使用 GH_CONFIG_DIR=%@ gh auth login 重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個帳號的 gh 工作階段已過期：請使用 GH_CONFIG_DIR=%@ gh auth login 重新登入。"
          }
        }
      }
    },
