          }
        }
      }
    },
    "GitHub doesn’t return a diff this large. Open the files on GitHub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub doesn’t return a diff this large. Open the files on GitHub."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tak velký rozdíl nevrací. Otevřete soubory na GitHubu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub liefert keinen so großen Diff. Öffne die Dateien auf GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no devuelve diferencias tan grandes. Abre los archivos en GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ne renvoie pas un diff aussi volumineux. Ouvrez les fichiers sur GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non restituisce un diff così grande. Apri i file su GitHub."
