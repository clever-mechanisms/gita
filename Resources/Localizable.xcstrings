    "Orphaned commit — unreachable from any branch or tag. Create a branch to rescue it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orphaned commit — unreachable from any branch or tag. Create a branch to rescue it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiřelá revize — nedosažitelná z žádné větve ani značky. Chcete-li ji zachránit, vytvořte větev."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwaister Commit — von keinem Branch oder Tag erreichbar. Erstelle einen Branch, um ihn zu retten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit huérfano: inalcanzable desde cualquier rama o etiqueta. Crea una rama para rescatarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit orphelin — inaccessible depuis toute branche ou étiquette. Créez une branche pour le récupérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit orfano — irraggiungibile da qualsiasi ramo o tag. Crea un ramo per recuperarlo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Árva commit — egyetlen ágról vagy címkéről sem érhető el. A megmentéséhez hozzon létre egy ágat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verweesde commit — onbereikbaar vanuit elke branch of tag. Maak een branch aan om deze te redden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osierocony commit — nieosiągalny z żadnej gałęzi ani tagu. Utwórz gałąź, aby go uratować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit órfão — inacessível a partir de qualquer branch ou tag. Crie uma branch para resgatá-lo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fristående commit — onåbar från alla grenar och taggar. Skapa en gren för att rädda den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "commit ไร้ตัวอ้างอิง — ไม่สามารถเข้าถึงได้จาก branch หรือ tag ใด สร้าง branch เพื่อกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahipsiz commit — herhangi bir dal veya etiketten erişilemiyor. Kurtarmak için bir dal oluşturun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потерянный коммит — недостижим ни из одной ветки или тега. Создайте ветку, чтобы спасти его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відірваний коміт — недосяжний із жодної гілки чи тегу. Створіть гілку, щоб зберегти його."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "孤立コミット — どのブランチからもタグからも到達できません。ブランチを作成して救出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고립된 커밋 — 어떤 브랜치나 태그에서도 도달할 수 없습니다. 복구하려면 브랜치를 생성하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孤立提交——无法从任何分支或标签访问。请创建一个分支以挽救它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孤立提交——無法從任何分支或標籤存取。請建立分支以復原它。"
          }
        }
      }
    },
