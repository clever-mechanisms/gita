          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生变基编辑器可执行文件不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生重定基底編輯器執行檔無法使用。"
          }
        }
      }
    },
    "The operation changed. Select the conflict again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace se změnila. Vyberte konflikt znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang hat sich geändert. Wähle den Konflikt erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation changed. Select the conflict again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación cambió. Vuelve a seleccionar el conflicto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération a changé. Sélectionnez à nouveau le conflit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A művelet megváltozott. Jelölje ki újra az ütközést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione è cambiata. Seleziona di nuovo il conflitto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が変更されました。競合をもう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 변경되었습니다. 충돌을 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewerking is gewijzigd. Selecteer het conflict opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja się zmieniła. Wybierz konflikt ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação mudou. Selecione o conflito novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция изменилась. Выберите конфликт снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtgärden har ändrats. Välj konflikten igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการเปลี่ยนไป ให้เลือก conflict อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem değişti. Çakışmayı yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Операція змінилася. Виберіть конфлікт знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已更改。请重新选择冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已變更。請重新選取衝突。"
          }
        }
      }
    },
    "The organization requires single sign-on for the GitHub account in use. Authorize it on github.com, then refresh.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizace vyžaduje pro používaný účet GitHub jednotné přihlašování (SSO). Autorizujte jej na github.com a poté obnovte zobrazení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Organisation verlangt Single Sign-On für das verwendete GitHub-Konto. Autorisiere es auf github.com und aktualisiere dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The organization requires single sign-on for the GitHub account in use. Authorize it on github.com, then refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La organización requiere inicio de sesión único para la cuenta de GitHub en uso. Autorízala en github.com y actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’organisation exige l’authentification unique pour le compte GitHub utilisé. Autorisez-le sur github.com, puis actualisez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szervezet egyszeri bejelentkezést (SSO) követel meg a használt GitHub-fióktól. Engedélyezze a github.com-on, majd frissítsen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’organizzazione richiede il Single Sign-On per l’account GitHub in uso. Autorizzalo su github.com, poi aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組織では、使用中の GitHub アカウントにシングルサインオンが必要です。github.com で承認してから更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조직에서 사용 중인 GitHub 계정에 SSO 인증을 요구합니다. github.com에서 승인한 다음 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De organisatie vereist single sign-on voor het gebruikte GitHub-account. Autoriseer het op github.com en vernieuw daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizacja wymaga logowania jednokrotnego (SSO) dla używanego konta GitHub. Autoryzuj je w github.com, a następnie odśwież."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A organização exige logon único (SSO) para a conta do GitHub em uso. Autorize-a em github.com e atualize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организация требует единого входа (SSO) для используемой учётной записи GitHub. Разрешите доступ на github.com, затем обновите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisationen kräver enkel inloggning för GitHub-kontot som används. Auktorisera det på github.com och uppdatera sedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "องค์กรกำหนดให้ใช้ single sign-on สำหรับบัญชี GitHub ที่ใช้อยู่ ให้อนุญาตบน github.com แล้วรีเฟรช"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuruluş, kullanılan GitHub hesabı için çoklu oturum açma (SSO) gerektiriyor. github.com'da yetkilendirin, ardından yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Організація вимагає єдиного входу (SSO) для поточного облікового запису GitHub. Авторизуйте його на github.com, потім оновіть дані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该组织要求当前使用的 GitHub 账户使用单点登录。请在 github.com 上授权，然后刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該組織要求目前使用的 GitHub 帳號使用單一登入。請在 github.com 上授權，然後重新整理。"
          }
        }
      }
    },
    "The pending repository requests could not be saved. Try restarting again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se uložit čekající požadavky na repozitáře. Zkuste restartovat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Repository-Anfragen konnten nicht gesichert werden. Versuche den Neustart erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending repository requests could not be saved. Try restarting again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las solicitudes de repositorio pendientes. Intenta reiniciar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de dépôt en attente n’ont pas pu être enregistrées. Réessayez de redémarrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A függőben lévő tárolókérések nem menthetők. Próbálja újra az újraindítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le richieste di repository in sospeso. Prova di nuovo a riavviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のリポジトリリクエストを保存できませんでした。再起動を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 중인 저장소 요청을 저장하지 못했습니다. 다시 시작을 재시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De openstaande repositoryaanvragen konden niet worden bewaard. Probeer opnieuw te herstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać oczekujących żądań repozytorium. Spróbuj uruchomić ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as solicitações de repositório pendentes. Tente reiniciar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ожидающие запросы к репозиторию. Повторите перезапуск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntande kodförrådsbegäranden kunde inte sparas. Försök starta om igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกคำขอ repository ที่ค้างอยู่ไม่ได้ ให้ลองรีสตาร์ทอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen depo istekleri kaydedilemedi. Yeniden başlatmayı tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти запити до репозиторію, що очікують. Повторіть перезапуск."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存待处理的仓库请求。请再次尝试重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存待處理的版本庫要求。請再次嘗試重新啟動。"
          }
        }
      }
    },
    "The provider connection for this result changed. Refresh Connections before opening it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení poskytovatele tohoto výsledku se změnilo. Před otevřením obnovte Připojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anbieterverbindung für dieses Ergebnis hat sich geändert. Aktualisiere die Verbindungen vor dem Öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider connection for this result changed. Refresh Connections before opening it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión del proveedor de este resultado cambió. Actualiza las conexiones antes de abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au fournisseur de ce résultat a changé. Actualisez les connexions avant de l’ouvrir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredmény szolgáltatói kapcsolata megváltozott. Megnyitás előtt frissítse a Kapcsolatok nézetet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al provider per questo risultato è cambiata. Aggiorna le connessioni prima di aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この結果のサービス接続が変更されました。開く前に接続を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과의 서비스 연결이 변경되었습니다. 열기 전에 연결을 새로 고치세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De providerverbinding voor dit resultaat is gewijzigd. Vernieuw de verbindingen voordat je het opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z usługą dla tego wyniku zmieniło się. Przed jego otwarciem odśwież Połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão do provedor para este resultado mudou. Atualize as conexões antes de abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение провайдера для этого результата изменилось. Обновите подключения перед его открытием."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantörsanslutningen för detta resultat ändrades. Uppdatera anslutningar innan du öppnar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อ provider ของผลลัพธ์นี้เปลี่ยนไป ให้รีเฟรชการเชื่อมต่อก่อนเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sonucun sağlayıcı bağlantısı değişti. Açmadan önce Bağlantılar'ı yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під’єднання провайдера для цього результату змінилося. Оновіть під’єднання перед його відкриттям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此结果的服务连接已更改。请先刷新连接，再打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此結果的服務連線已變更。請先重新整理連線，再打開。"
          }
        }
      }
    },
    "The provider item has an invalid identity. Refresh its list and try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položka poskytovatele má neplatnou identitu. Obnovte její seznam a zkuste to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbietereintrag hat eine ungültige Identität. Aktualisiere seine Liste und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider item has an invalid identity. Refresh its list and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad del elemento del proveedor no es válida. Actualiza su lista e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
