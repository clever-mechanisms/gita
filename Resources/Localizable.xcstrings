    "Interactive rebase requires a full index without hidden tracked entries, conflicts, or submodules.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktivní přesazení vyžaduje úplný index bez skrytých sledovaných položek, konfliktů a dílčích modulů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein interaktiver Rebase erfordert einen vollständigen Index ohne versteckte verfolgte Einträge, Konflikte oder Submodule."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive rebase requires a full index without hidden tracked entries, conflicts, or submodules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rebase interactivo requiere un índice completo sin entradas seguidas ocultas, conflictos ni submódulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rebase interactif nécessite un index complet, sans entrées suivies masquées, conflits ni sous-modules."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az interaktív újraalapozáshoz teljes index szükséges rejtett követett bejegyzések, ütközések és almodulok nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rebase interattivo richiede un indice completo senza voci tracciate nascoste, conflitti o sottomoduli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対話的リベースには、非表示の追跡項目、競合、サブモジュールを含まない完全なインデックスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화형 리베이스에는 숨겨진 추적 항목, 충돌 또는 하위 모듈이 없는 전체 인덱스가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactief rebasen vereist een volledige index zonder verborgen gevolgde items, conflicten of submodules."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktywna zmiana bazy wymaga pełnego indeksu bez ukrytych śledzonych wpisów, konfliktów i podmodułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rebase interativo requer um índice completo sem entradas rastreadas ocultas, conflitos ou submódulos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для интерактивного перебазирования нужен полный индекс без скрытых отслеживаемых записей, конфликтов и подмодулей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktiv rebase kräver ett fullständigt index utan dolda spårade poster, konflikter eller undermoduler."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "interactive rebase ต้องใช้ index แบบเต็มที่ไม่มีรายการที่ติดตามซึ่งซ่อนอยู่ conflict หรือ submodule"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkileşimli yeniden temellendirme için gizli izlenen girdiler, çakışmalar veya alt modüller içermeyen tam bir indeks gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для інтерактивного перебазовування потрібен повний індекс без прихованих відстежуваних записів, конфліктів і підмодулів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交互式变基需要完整索引，且不得包含隐藏的已跟踪条目、冲突或子模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "互動式重定基底需要完整索引，且不得包含隱藏的已追蹤項目、衝突或子模組。"
          }
        }
      }
    },
